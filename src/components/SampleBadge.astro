---
/** Flags sample content that should be replaced with the club's own. */
interface Props {
  long?: boolean;
}
const { long = false } = Astro.props;
---
<span class="sample-badge">{long ? 'サンプル記事：実際の撮影会の記録と写真に差し替えてください' : 'サンプル'}</span>

<style>
  .sample-badge {
    display: inline-block;
    font: 400 14px/1.3 var(--hand);
    color: var(--mark);
    border: 1px dashed rgba(251, 243, 213, 0.5);
    padding: 3px 9px;
    border-radius: 2px;
    transform: rotate(-1.5deg);
    white-space: normal;
  }
</style>
