---
import { club } from '../data/club';
import posts from '../data/instagram-posts.json';

interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
/*
 * The club's recent posts, from photos saved on the site by `npm run instagram`. Instagram's own
 * embed only shows where tracking protection, ad blockers and in-app browsers let it through.
 */
const feed = posts.map((post) => ({ href: post.url, src: `/instagram/${post.url.split('/').at(-2)}.webp`, alt: en ? post.en : post.ja }));
---
<section class="section insta" aria-labelledby="insta-title">
  <div class="wrap grid">
    <div class="intro">
      <p class="edge">INSTAGRAM ▸ @{club.instagram.handle}</p>
      <h2 id="insta-title">{en ? 'A glimpse of our photography.' : '写真部の Instagram を、のぞいてみませんか。'}</h2>
      <p class="muted">{en ? 'Recent posts from the club. Select a photo to open it on Instagram. You can also contact us by DM from our profile.' : '写真部の最近の投稿です。写真を押すと Instagram で開きます。プロフィールから DM でのお問い合わせもできます。'}</p>
      <a class="btn instagram-button" href={club.instagram.url} target="_blank" rel="noopener">{en ? 'Open Instagram' : 'Instagram を見る'} <span class="arrow" aria-hidden="true">↗</span></a>
      <p class="small muted">{en ? 'For our newest posts, see the profile.' : '最新の投稿は、プロフィールでご覧いただけます。'}</p>
    </div>
    <div class="feed">
      <a class="feed-head" href={club.instagram.url} target="_blank" rel="noopener">
        <img src="/brand/mark-192.webp" alt="" width="48" height="48" />
        <span><strong>{club.instagram.handle}</strong><small>KUAS Photography Club</small></span>
        <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true">
          <defs><linearGradient id="insta-glyph" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#f9a23b" /><stop offset=".45" stop-color="#e1306c" /><stop offset="1" stop-color="#7b3fd0" /></linearGradient></defs>
          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
          <circle cx="12" cy="12" r="4.4" />
          <circle class="dot" cx="17.4" cy="6.6" r="1.1" />
        </svg>
      </a>
      <ul class="feed-grid" aria-label={en ? 'Recent Instagram posts' : '最近の Instagram の投稿'}>
        {feed.map((post) => (
          <li>
            <a href={post.href} target="_blank" rel="noopener">
              <img src={post.src} alt={post.alt} width="480" height="600" loading="lazy" decoding="async" />
              <span class="visually-hidden">{en ? '(opens on Instagram)' : '（Instagram で開く）'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 36px 56px;
    align-items: center;
  }

  .intro {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  h2 {
    font-size: var(--step-4);
  }

  .instagram-button,
  .instagram-button:hover {
    position: relative;
    isolation: isolate;
    border-color: transparent;
    background: linear-gradient(115deg, #d2762f -45%, #bf354f 28%, #ae299b 65%, #6048cf 115%);
    color: #fff;
  }

  .instagram-button::before,
  .instagram-button::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    pointer-events: none;
  }

  .instagram-button::before {
    inset: -4px;
    z-index: -2;
    background: linear-gradient(110deg, #ffb64d, #f35c89, #bf59eb, #647dff, #57d4c2);
    filter: blur(9px);
    opacity: 0;
    transition: opacity .24s ease;
  }

  .instagram-button::after {
    inset: 0;
    z-index: -1;
    background: inherit;
  }

  .instagram-button:is(:hover, :focus-visible) {
    transform: translateY(-2px);
  }

  .instagram-button:is(:hover, :focus-visible)::before {
    opacity: .65;
  }

  .instagram-button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-button,
    .instagram-button::before,
    .instagram-button .arrow {
      transition: none;
    }

    .instagram-button:is(:hover, :focus-visible),
    .instagram-button:hover .arrow {
      transform: none;
    }
  }

  /* laid out like the profile on Instagram: the account, then its posts three across */
  .feed {
    width: 100%;
    max-width: 540px;
    justify-self: center;
    /* clip, not hidden: a hidden overflow would become the scroller the photos' reveal follows */
    overflow: hidden;
    overflow: clip;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
    box-shadow: var(--shadow);
  }

  .feed-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    color: var(--ink);
    text-decoration: none;
  }

  .feed-head img { width: 48px; height: 48px; border-radius: 50%; }
  .feed-head span { display: grid; min-width: 0; line-height: 1.4; }
  .feed-head strong { font: 700 14px/1.4 var(--latin); overflow-wrap: anywhere; }
  .feed-head small { font-size: 12px; color: var(--muted); }
  .feed-head:hover strong { text-decoration: underline; text-underline-offset: 3px; }
  .glyph { flex: none; width: 26px; height: 26px; margin-left: auto; fill: none; stroke: url(#insta-glyph); stroke-width: 2; }
  .glyph .dot { fill: url(#insta-glyph); stroke: none; }

  /* the handle stays on one line on the narrowest phones */
  @media (max-width: 380px) {
    .feed-head { gap: 10px; padding: 12px; }
    .feed-head img { width: 40px; height: 40px; }
    .feed-head strong { font-size: 13px; }
  }

  .feed-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feed-grid a { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--brand-pale); }
  .feed-grid img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .feed-grid a:hover img { transform: scale(1.04); }
  .feed a:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }

  /* the photos rise in as the grid scrolls into view; browsers without scroll timelines just show them */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .feed-grid li { animation: feed-in linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
      .feed-grid li:nth-child(3n + 2) { animation-range: entry 10% entry 80%; }
      .feed-grid li:nth-child(3n) { animation-range: entry 20% entry 90%; }
    }
  }

  @keyframes feed-in { from { opacity: 0; transform: translateY(24px) scale(.96); } }

  @media (prefers-reduced-motion: reduce) {
    .feed-grid img { transition: none; }
    .feed-grid a:hover img { transform: none; }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
