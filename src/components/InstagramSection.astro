---
import { club } from '../data/club';
import { homeJa } from '../data/home-ja';

interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
const embedUrl = new URL('embed/', `${club.instagram.url.replace(/\/$/, '')}/`);
---
<section class="section insta" aria-labelledby="insta-title">
  <div class="wrap grid">
    <div class="intro">
      <p class="edge">INSTAGRAM ▸ @{club.instagram.handle}</p>
      <!-- each phrase stays whole, so the heading breaks between them rather than inside a word -->
      <h2 id="insta-title">{en ? 'A glimpse of our photography.' : <><span class="phrase">写真部の Instagram を、</span><span class="phrase">のぞいてみませんか。</span></>}</h2>
      <p class="muted">{en ? 'Explore the club’s posts in the official Instagram preview.' : '公式の埋め込みから、写真部の投稿をご覧いただけます。'}</p>
      <div class="dm">
        <p><strong>{en ? 'Want to join, or have a question? Send us a DM.' : `${homeJa.dm}。`}</strong></p>
      </div>
      <div class="actions">
        <a class="btn instagram-button" href={club.instagram.url} target="_blank" rel="noopener">{en ? 'Open Instagram' : 'Instagram を見る'} <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <p class="small muted">{en ? 'If the preview does not load, open the club profile with the Instagram button.' : '埋め込みが表示されない場合は、「Instagram を見る」からプロフィールをご覧ください。'}</p>
    </div>
    <div class="embed">
      <iframe
        data-instagram-embed
        data-src={embedUrl.href}
        title={en ? 'KUAS Photography Club Instagram profile and posts' : '京都先端科学大学 写真部の Instagram プロフィールと投稿'}
        width="540"
        height="648"
        loading="lazy"
      ></iframe>
      <noscript>
        <iframe
          src={embedUrl.href}
          title={en ? 'KUAS Photography Club Instagram profile and posts' : '京都先端科学大学 写真部の Instagram プロフィールと投稿'}
          width="540"
          height="648"
        ></iframe>
      </noscript>
    </div>
  </div>
</section>
<script>
  const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-instagram-embed][data-src]');
  const load = (frame: HTMLIFrameElement) => {
    const src = frame.dataset.src;
    if (!src || frame.src) return;
    frame.src = src;
  };
  if (frames.length) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const frame = entry.target as HTMLIFrameElement;
          observer.unobserve(frame);
          load(frame);
        }
      }, { rootMargin: '500px 0px' });
      frames.forEach(frame => observer.observe(frame));
    } else {
      frames.forEach(load);
    }
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 36px 56px;
    align-items: center;
  }

  .intro {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  h2 {
    font-size: var(--step-4);
  }

  .phrase { display: inline-block; }

  .dm {
    display: grid;
    gap: 2px;
    padding: 12px 16px;
    border-left: 3px solid var(--brand);
    background: var(--raise-2);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .instagram-button,
  .instagram-button:hover {
    position: relative;
    isolation: isolate;
    border-color: transparent;
    background: linear-gradient(115deg, #d2762f -45%, #bf354f 28%, #ae299b 65%, #6048cf 115%);
    color: #fff;
  }

  .instagram-button::before,
  .instagram-button::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    pointer-events: none;
  }

  .instagram-button::before {
    inset: -4px;
    z-index: -2;
    background: linear-gradient(110deg, #ffb64d, #f35c89, #bf59eb, #647dff, #57d4c2);
    filter: blur(9px);
    opacity: 0;
    transition: opacity .24s ease;
  }

  .instagram-button::after {
    inset: 0;
    z-index: -1;
    background: inherit;
  }

  .instagram-button:is(:hover, :focus-visible) {
    transform: translateY(-2px);
  }

  .instagram-button:is(:hover, :focus-visible)::before {
    opacity: .65;
  }

  .instagram-button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-button,
    .instagram-button::before,
    .instagram-button .arrow {
      transition: none;
    }

    .instagram-button:is(:hover, :focus-visible),
    .instagram-button:hover .arrow {
      transform: none;
    }
  }

  .embed {
    width: 100%;
    max-width: 540px;
    justify-self: center;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
  }

  iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 6;
    min-height: 460px;
    border: 0;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
