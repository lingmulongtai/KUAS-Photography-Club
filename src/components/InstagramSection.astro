---
import { club } from '../data/club';

interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
const embedUrl = new URL('embed/', `${club.instagram.url.replace(/\/$/, '')}/`);
---
<section class="section insta" aria-labelledby="insta-title">
  <div class="wrap grid">
    <div class="intro">
      <p class="edge">INSTAGRAM ▸ @{club.instagram.handle}</p>
      <h2 id="insta-title">{en ? 'A glimpse of our photography.' : '写真部の Instagram を、のぞいてみませんか。'}</h2>
      <p class="muted">{en ? 'Explore the club’s posts in the official Instagram preview. You can also contact us by DM from our profile.' : '公式の埋め込みから、写真部の投稿をご覧いただけます。プロフィールから DM でのお問い合わせもできます。'}</p>
      <a class="btn btn--primary" href={club.instagram.url} target="_blank" rel="noopener">{en ? 'Open Instagram' : 'Instagram を見る'} <span class="arrow" aria-hidden="true">↗</span></a>
      <p class="small muted">{en ? 'If the preview does not load, open our profile using the button above.' : '埋め込みが表示されない場合は、上のボタンからプロフィールをご覧ください。'}</p>
    </div>
    <div class="embed">
      <iframe
        src={embedUrl.href}
        title={en ? 'KUAS Photography Club Instagram profile and posts' : '京都先端科学大学 写真部の Instagram プロフィールと投稿'}
        width="540"
        height="648"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 36px 56px;
    align-items: center;
  }

  .intro {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  h2 {
    font-size: var(--step-4);
  }

  .embed {
    width: 100%;
    max-width: 540px;
    justify-self: center;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
  }

  iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 6;
    min-height: 460px;
    border: 0;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
