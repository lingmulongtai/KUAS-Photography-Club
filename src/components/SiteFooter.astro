---
import { club, nav } from '../data/club';
import { languagePath } from '../lib/i18n';
interface Props { lang?: string; }
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
const local = (href: string) => languagePath(href, en ? 'en' : 'ja');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="arc" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href={local('/')}>
        <img src="/brand/mark-192.webp" alt="" width="64" height="64" />
        <span>
          <span class="brand-ja">写真部</span>
          <span class="brand-en">— KUAS Photography Club —</span>
        </span>
      </a>
      <p class="small">
        {en ? 'This website is operated by the KUAS Photography Club. Students of all nationalities and experience levels are welcome to visit. A smartphone is enough.' : `${club.nameJa}が運営するサイトです。国籍・学年・経験は問いません。スマホで撮る人も大歓迎。`}
      </p>
    </div>

    <div>
      <p class="label">MEETING</p>
      <p class="small">
        {en ? 'Fridays from 18:00' : `${club.meetings.day} ${club.meetings.times.join(' / ')}`}<br />
        {en ? 'Usually S306, Uzumasa Campus' : `通常は ${club.campus} ${club.meetings.room} 教室`}
      </p>
      <a class="small" href={local('/schedule/')}>{en ? 'Check cancellations and changes' : '休会・変更の最新案内'}</a>
    </div>

    <div>
      <p class="label">CONTACT</p>
      <ul class="links small">
        <li><a href={club.instagram.url} rel="noopener" target="_blank">Instagram @{club.instagram.handle}</a></li>
        <li><a href={local('/join/')}>{en ? 'Visit / Join' : '見学・入部'}</a></li>
        <li><a href={local('/contact/')}>{en ? 'Contact / Photography requests' : '撮影依頼・協賛などのお問い合わせ'}</a></li>
      </ul>
    </div>

    <div>
      <p class="label">PAGES</p>
      <ul class="links small">
        {nav.map((item) => <li><a href={local(item.href)}>{en ? item.en : item.ja}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="wrap base">
    <p class="small">© {year} {club.name}. {en ? 'Photographs belong to their photographers. Please ask before reusing them.' : '掲載している写真の著作権は撮影者にあります。無断転載・無断使用はご遠慮ください。'}</p>
    <p class="small">
      トップページの景色：<a href="https://maps.gsi.go.jp/development/ichiran.html" rel="noopener" target="_blank">国土地理院</a>の地形・航空写真・地図、「<a href="https://www.mlit.go.jp/plateau/" rel="noopener" target="_blank">3D都市モデル（Project PLATEAU）京都市・大阪市（2025年度）</a>」（国土交通省）を加工して作成 ·
      森林：<a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">© OpenStreetMap contributors（ODbL）</a> ·
      <a href={club.github} rel="noopener" target="_blank">{en ? 'Website source' : 'このサイトのソース'}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--band);
    color: var(--ink);
    padding-block: 72px 32px;
    display: grid;
    gap: 44px;
  }

  /* the open circle and dot from the logo */
  .arc {
    position: absolute;
    right: -120px;
    top: -160px;
    width: 460px;
    height: 460px;
    border: 3px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    -webkit-mask: conic-gradient(from 20deg, #000 0 300deg, transparent 300deg 330deg, #000 330deg);
    mask: conic-gradient(from 20deg, #000 0 300deg, transparent 300deg 330deg, #000 330deg);
    pointer-events: none;
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr 1fr;
    gap: 32px 40px;
  }

  .grid > div {
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--on-dark);
  }

  .brand img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.85);
  }

  .brand > span {
    display: grid;
    line-height: 1.3;
  }

  .brand-ja {
    font: 500 26px/1.2 var(--display);
    letter-spacing: 0.4em;
  }

  .brand-en {
    font: 600 12px/1.4 var(--latin);
    letter-spacing: 0.1em;
  }

  .about p {
    max-width: 28em;
  }

  .label {
    font: 700 12px/1.4 var(--latin);
    letter-spacing: 0.22em;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  a {
    color: var(--ink);
  }

  a:hover {
    color: var(--on-dark);
  }

  .base {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 24px;
    border-top: 1px solid rgba(27, 54, 61, 0.2);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
