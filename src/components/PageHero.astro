---
/** Title block for inner pages: an eyebrow label, the page title and a lead paragraph, on a pale teal band. */
interface Props {
  edge: string;
  title: string;
  lead?: string;
}
const { edge, title, lead } = Astro.props;
---
<header class="page-hero">
  <div class="motif" aria-hidden="true"><span class="ring"></span><span class="dot"></span></div>
  <div class="wrap inner">
    <p class="edge">{edge}</p>
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--brand-pale);
    padding-block: clamp(56px, 9vw, 112px) clamp(40px, 6vw, 64px);
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .inner {
    position: relative;
    display: grid;
    gap: 18px;
  }

  h1 {
    font-size: var(--step-5);
    animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .lead {
    animation: rise 0.7s 0.08s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  /* the open circle and dot from the logo */
  .motif {
    position: absolute;
    right: max(-80px, calc(50% - 760px));
    top: 50%;
    width: min(46vw, 420px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .ring {
    position: absolute;
    inset: 0;
    border: 3px solid var(--brand);
    border-radius: 50%;
    -webkit-mask: conic-gradient(from 25deg, #000 0 310deg, transparent 310deg 335deg, #000 335deg);
    mask: conic-gradient(from 25deg, #000 0 310deg, transparent 310deg 335deg, #000 335deg);
    animation: draw 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .dot {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand);
    right: 13%;
    top: 9%;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes draw {
    from {
      opacity: 0;
      transform: rotate(-30deg) scale(0.96);
    }
  }
</style>
