---
/**
 * A trip's photos as a masonry grid. Selecting a photo opens it large in a dialog
 * with the caption and the photographer's credit; arrow keys move between photos.
 */
import { credit, type TripPhoto } from '../lib/trips';

interface Props {
  photos: TripPhoto[];
  date: Date;
}
const { photos, date } = Astro.props;
---
<div class="gallery" data-gallery>
  {photos.map((p, i) => (
    <figure class:list={['shot', { portrait: p.portrait }]}>
      <button type="button" class="open" data-index={i} aria-label={`拡大して見る：${p.alt}`}>
        <img src={p.src} alt={p.alt} loading="lazy" decoding="async" width={p.portrait ? 933 : 1400} height={p.portrait ? 1400 : 933} />
      </button>
      <figcaption>
        {p.caption && <span class="cap">{p.caption}</span>}
        <span class="credit">{credit(p, date)}</span>
      </figcaption>
    </figure>
  ))}

  <dialog class="lightbox" aria-label="写真を拡大表示">
    <div class="lb-inner">
      <img class="lb-img" alt="" />
      <p class="lb-meta"><span class="lb-cap"></span><span class="lb-credit"></span></p>
      <div class="lb-nav">
        <button type="button" class="btn" data-step="-1" aria-label="前の写真">←</button>
        <span class="lb-count num"></span>
        <button type="button" class="btn" data-step="1" aria-label="次の写真">→</button>
        <button type="button" class="btn lb-close" aria-label="閉じる">閉じる ✕</button>
      </div>
    </div>
  </dialog>

  <script type="application/json" data-photos set:html={JSON.stringify(photos.map((p) => ({ src: p.src, alt: p.alt, caption: p.caption ?? '', credit: credit(p, date) })))} />
</div>

<script>
  interface Item {
    src: string;
    alt: string;
    caption: string;
    credit: string;
  }
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const items = JSON.parse(root.querySelector('[data-photos]')?.textContent ?? '[]') as Item[];
    const dialog = root.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const cap = dialog.querySelector('.lb-cap')!;
    const cred = dialog.querySelector('.lb-credit')!;
    const count = dialog.querySelector('.lb-count')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const it = items[index];
      img.src = it.src;
      img.alt = it.alt;
      cap.textContent = it.caption;
      cred.textContent = it.credit;
      count.textContent = `${index + 1} / ${items.length}`;
    };

    root.querySelectorAll<HTMLButtonElement>('.open').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        show(Number(b.dataset.index));
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(index + Number(b.dataset.step))));
    dialog.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    dialog.addEventListener('close', () => opener?.focus());
  });
</script>

<style>
  .gallery {
    columns: 3 280px;
    column-gap: 18px;
  }

  .shot {
    break-inside: avoid;
    margin: 0 0 22px;
    display: grid;
    gap: 8px;
  }

  .open {
    display: block;
    padding: 0;
    border: 0;
    background: var(--rebate);
    cursor: zoom-in;
    border-radius: 2px;
    overflow: hidden;
    width: 100%;
  }

  .open img {
    width: 100%;
    transition: transform 0.5s, filter 0.5s;
  }

  .open:hover img {
    transform: scale(1.025);
  }

  figcaption {
    display: grid;
    gap: 2px;
    font-size: 13px;
    line-height: 1.6;
  }

  .credit {
    font: 400 11px/1.5 var(--mono);
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .lightbox {
    width: min(96vw, 1400px);
    max-height: 96vh;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--rebate);
    color: var(--ink);
  }

  .lightbox::backdrop {
    background: rgba(3, 4, 6, 0.88);
  }

  .lb-inner {
    display: grid;
    gap: 12px;
    padding: 14px;
  }

  .lb-img {
    width: 100%;
    max-height: 76vh;
    object-fit: contain;
  }

  .lb-meta {
    display: grid;
    gap: 2px;
    font-size: 14px;
  }

  .lb-credit {
    font: 400 12px/1.5 var(--mono);
    color: var(--muted);
  }

  .lb-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .lb-count {
    color: var(--amber);
    min-width: 4em;
    text-align: center;
  }

  .lb-close {
    margin-left: auto;
  }
</style>
