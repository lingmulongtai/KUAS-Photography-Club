---
import SampleBadge from './SampleBadge.astro';
import { credit, formatDate, type Trip } from '../lib/trips';
interface Props { trip: Trip }
const { trip } = Astro.props;
const { title, date, place, summary, photos, sample } = trip.data;
const photo = photos[0];
---
<article class="trip-card">
  <a href={`/trips/${trip.id}/`} aria-label={`${title}（${formatDate(date)}）の記録を見る`}>
    <div class="photo"><img src={photo.src} alt={photo.alt} width="600" height="400" loading="lazy" decoding="async" /></div>
    <div class="body">
      <p class="edge"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time> · {photos.length}枚</p>
      <h3>{title}</h3>
      <p class="small muted">{place}</p>
      <p>{summary}</p>
      {sample && <SampleBadge />}
      <p class="credit">{credit(photo, date)}</p>
      <span class="link-arrow">撮影会の記録へ →</span>
    </div>
  </a>
</article>
<style>
  .trip-card { min-width: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--raise); box-shadow: var(--shadow); }
  a { display: block; height: 100%; text-decoration: none; color: var(--ink); }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .photo { aspect-ratio: 3 / 2; overflow: hidden; background: var(--brand-pale); }
  img { width: 100%; height: 100%; object-fit: cover; }
  .body { display: grid; justify-items: start; gap: 10px; padding: 22px; border-top: 3px solid var(--brand); }
  h3 { font-size: var(--step-2); line-height: 1.5; }
  a:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
  .credit { font-size: 11px; color: var(--muted); overflow-wrap: anywhere; }
  .link-arrow { margin-top: 4px; }
</style>
