---
import ClubIllustration from './ClubIllustration.astro';
import { club } from '../data/club';
import { clubHistory, type HistoryIllustration } from '../data/club-history';
interface Props { lang?: 'ja' | 'en'; }
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
const schedule = en ? '/en/schedule/' : '/schedule/';
const trips = en ? '/en/trips/' : '/trips/';
const activities: { icon: HistoryIllustration; title: string; detail: string }[] = [
  { icon: 'mountains', title: en ? 'Photo outings' : '撮影会', detail: en ? 'We aim for one or two outings a month in Kyoto and neighboring prefectures. We pick seasonal subjects such as cherry blossoms and autumn leaves, and members can suggest outings of their own.' : '月1〜2回を目安に、京都や近隣府県へ。桜や紅葉など季節の被写体を探し、部全体の企画に加えて部員発案の撮影会も行います。' },
  { icon: 'frames', title: en ? 'Exhibitions and festivals' : '写真展示・学園祭', detail: en ? 'We share members’ photographs as prints and have set up photo booths where visitors can get involved.' : '部員の作品をプリントして展示したり、学園祭で来場者と一緒に楽しめる撮影ブースを開いたりしています。' },
  { icon: 'campus', title: en ? 'University events' : '大学行事の撮影', detail: en ? 'We photograph university events, including open campus days, and help with photography for university communications.' : 'オープンキャンパスなどの大学行事を写真で記録し、大学の広報撮影にも協力しています。' },
];
---
<section class="intro" aria-labelledby="club-about-heading">
  <div class="wrap intro-grid">
    <div class="intro-copy">
      <p class="edge">ABOUT / KUAS PHOTOGRAPHY CLUB</p>
      <h1 id="club-about-heading">{en ? 'About the KUAS Photography Club' : <><span lang="ja">京都先端科学大学</span><span lang="ja">写真部について</span></>}</h1>
      <p class="lead">{en ? 'We’re the student-run photography club at Kyoto University of Advanced Science. We go out to take photos, exhibit our work, and meet people who share our interest. A smartphone is enough, and all experience levels are welcome.' : '京都先端科学大学の学生が運営する写真部です。撮影会や作品展示を通して、写真を楽しみ、学年や国籍を越えて交流しています。カメラがなくても、スマートフォンで参加できます。'}</p>
      <a class="history-link" href="#club-history">{en ? 'See our history' : '写真部の歩みを見る'} <span aria-hidden="true">↓</span></a>
    </div>
    <img class="intro-art" src="/brand/about-contact-sheet.svg" alt="" width="540" height="430" fetchpriority="high" />
  </div>
</section>

<section class="section history" id="club-history" aria-labelledby="club-history-heading">
  <div class="wrap">
    <header class="section-head">
      <p class="edge">TIMELINE</p>
      <h2 id="club-history-heading">{en ? 'How the club grew' : '写真部の歩み'}</h2>
      <p class="muted">{en ? 'From a student circle to a recognized club, here are a few milestones along the way.' : '写真同好会としてのスタートから、正式な部活動になってからの主な活動まで。'}</p>
    </header>
    <ol class="timeline">
      {clubHistory.map((item) => (
        <li>
          <div class="date">
            {item.date ? <time datetime={item.date}>{item.label[lang]}</time> : <span>{item.label[lang]}</span>}
          </div>
          <article class="milestone">
            <div class="art"><ClubIllustration icon={item.illustration} /></div>
            <div><h3>{item.title[lang]}</h3><p>{item.detail[lang]}</p></div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="club-activities-heading">
  <div class="wrap">
    <header class="section-head">
      <p class="edge">ACTIVITIES</p>
      <h2 id="club-activities-heading">{en ? 'What we do' : '普段の活動'}</h2>
    </header>
    <div class="activity-grid">
      {activities.map((activity) => <article>
        <div class="art"><ClubIllustration icon={activity.icon} /></div>
        <h3>{activity.title}</h3>
        <p>{activity.detail}</p>
      </article>)}
    </div>
    <a class="text-link" href={trips}>{en ? 'Explore photo outings' : '撮影会のページを見る'} <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="section details" aria-labelledby="club-visit-heading">
  <div class="wrap">
    <header class="section-head">
      <p class="edge">VISIT / CONTACT</p>
      <h2 id="club-visit-heading">{en ? 'Visit or get in touch' : '見学・お問い合わせ'}</h2>
    </header>
    <div class="visit-grid">
      <article>
        <h3>{en ? 'Weekly meetings' : '定例ミーティング'}</h3>
        <p>{en ? `${club.meetings.dayEn} from 18:00, usually in ${club.meetings.room} at Uzumasa Campus.` : `${club.meetings.day}18:00から。通常は${club.campus} ${club.meetings.room}です。`}</p>
        <a href={schedule}>{en ? 'Check schedule and room changes' : '休会・教室変更を確認する'}</a>
      </article>
      <article>
        <h3>{en ? 'Club dues' : '部費'}</h3>
        <p>{en ? `¥${club.feePerSemester.toLocaleString('en-US')} per semester. Members pay their own transportation and admission fees for outings.` : `半期${club.feePerSemester.toLocaleString('ja-JP')}円。撮影会の交通費や入場料は別途各自負担です。`}</p>
      </article>
    </div>
    <div class="contact">
      <div>
        <p><strong>{en ? 'Contact the club on Instagram' : '写真部の公式Instagramへ'}</strong></p>
        <p>{en ? 'Send us a DM to ask about visits, joining, or photography requests.' : '見学・入部や、撮影のご依頼などは公式アカウントのDMへ。'}</p>
      </div>
      <a class="btn btn--primary" href={club.instagram.url} rel="noopener" target="_blank">@{club.instagram.handle} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .intro { background: linear-gradient(145deg, var(--base) 8%, var(--brand-pale) 100%); padding-block: clamp(28px, 7vw, 90px); }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 12px 36px; align-items: center; }
  .intro-copy { display: grid; gap: clamp(14px, 2.3vw, 26px); padding-block: 16px; align-content: center; }
  h1 { font-size: clamp(32px, 4.65vw, 62px); line-height: 1.22; }
  h1 span[lang=ja] { display: block; }
  :global([lang=ja]) h3 { word-break: auto-phrase; text-wrap: pretty; }
  h2 { font-size: var(--step-4); }
  h3 { font-size: var(--step-2); }
  .history-link, .text-link { width: fit-content; color: var(--accent); font-weight: 700; }
  .history-link { border: 1px solid var(--line-strong); border-radius: 999px; padding: .55em 1em; background: var(--raise); text-decoration: none; }
  .history-link:hover { border-color: var(--accent); }
  .history-link span, .text-link span { margin-inline-start: .35em; }
  .intro-art { width: 100%; max-width: 540px; justify-self: center; }
  .section-head { display: grid; gap: 8px; }
  .history { background: var(--raise-2); }
  .timeline { display: grid; gap: 13px; padding: 0; margin: 0; list-style: none; }
  .timeline li { display: grid; grid-template-columns: 12.5rem minmax(0, 1fr); align-items: stretch; }
  .date { position: relative; display: flex; align-items: center; font-weight: 700; color: var(--accent); padding-inline-end: 26px; }
  .date::before { position: absolute; content: ''; inset: -13px 12px 0 auto; border-inline-end: 1px solid var(--line-strong); }
  .date::after { position: absolute; content: ''; inset-inline-end: 8px; inset-block-start: calc(50% - 4px); width: 9px; height: 9px; border: 2px solid var(--accent); border-radius: 50%; background: var(--base); }
  .timeline li:first-child .date::before { inset-block-start: 50%; }
  .timeline li:last-child .date::before { inset-block-end: 50%; }
  .milestone { display: grid; grid-template-columns: auto minmax(0,1fr); gap: clamp(10px, 2vw, 22px); align-items: center; padding: clamp(13px, 2.4vw, 22px); border: 1px solid var(--line); border-radius: var(--radius); background: var(--raise); }
  .milestone p, .activity-grid p, .visit-grid p { margin-top: 6px; color: var(--muted); }
  .art { width: clamp(42px, 6vw, 62px); aspect-ratio: 1; display: grid; place-items: center; border-radius: 32%; background: var(--brand-pale); color: var(--accent); flex: none; }
  .art :global(svg) { width: 80%; height: 80%; display: block; }
  .activity-grid, .visit-grid { display: grid; gap: 14px; grid-template-columns: repeat(3,minmax(0,1fr)); }
  .visit-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .activity-grid article, .visit-grid article { border: 1px solid var(--line); background: var(--raise); border-radius: var(--radius); padding: clamp(17px, 3vw, 29px); }
  .activity-grid .art { margin-bottom: 14px; }
  .details { background: var(--raise-2); }
  .contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; padding: clamp(16px, 3vw, 28px); border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--brand-pale); }
  .contact .btn { overflow-wrap: anywhere; }
  @media (max-width: 760px) {
    .intro-grid, .activity-grid { grid-template-columns: 1fr; }
    .intro-art { width: min(100%, 340px); }
    .timeline { padding-inline-start: 16px; gap: 16px; }
    .timeline li { position: relative; grid-template-columns: 1fr; gap: 5px; }
    .timeline li::before { position: absolute; content: ''; inset: 12px auto -28px -14px; border-inline-start: 1px solid var(--line-strong); }
    .timeline li:last-child::before, .date::before { display: none; }
    .date { font-size: var(--step--1); padding: 0; }
    .date::after { inset-inline: -18px auto; }
    .milestone h3 { font-size: var(--step-1); }
  }
  @media (max-width: 520px) { .visit-grid { grid-template-columns: 1fr; } }
</style>
