---
/** Night street through an 85 mm lens: focus slider and aperture buttons. */
import type { SiteLanguage } from '../../lib/i18n';
interface Props {
  print?: string;
  lang?: SiteLanguage;
}
const { print = '/photos/samples/summer-fireworks/01.jpg', lang = 'ja' } = Astro.props;
const en = lang === 'en';
const stops = ['1.4', '2.8', '5.6'];
import CameraDial from './CameraDial.astro';
import { APERTURES, FOCUS_STOPS } from '../../data/camera-settings';
---
<figure class="demo">
  <div class="stage" data-demo="bokeh" data-print={print} data-slider="bokeh-focus" data-output="bokeh-dist" style="--fb: radial-gradient(circle at 28% 38%, rgba(255,184,106,.35), transparent 13%), radial-gradient(circle at 62% 30%, rgba(116,179,255,.3), transparent 11%), #05060b">
    <canvas aria-label={en ? 'A night street whose bokeh changes with focus distance and aperture' : 'ピント位置と絞りで玉ボケが変わる夜の街のデモ'}></canvas>
    <div class="hud">
      <div class="row"><span class="tag" data-readout>{en ? '85mm · f/1.4 · focus 3.0m' : '85mm · f/1.4 · ピント 3.0m'}</span></div>
      <div class="row">
        <div class="chips" role="group" aria-label={en ? 'Aperture' : '絞り'}>
          {stops.map((f) => <button class="chip" type="button" data-f={f} aria-pressed={f === '1.4' ? 'true' : 'false'}>f/{f}</button>)}
        </div>
      </div>
    </div>
  </div>
  <div class="camera-controls">
    <CameraDial id="bokeh-focus" label={en ? 'Focus' : 'ピント位置'} values={FOCUS_STOPS.map((m) => `${m}m`)} value={6} lang={lang} />
    <CameraDial id="bokeh-aperture" label={en ? 'Aperture' : '絞り'} values={APERTURES.map((f) => `f/${f}`)} value={0} lang={lang} />
  </div>
  <div class="auto-focus">
    <button class="btn" type="button" data-focus-auto aria-pressed="true">{en ? 'Move the focus for me' : '自動でピントを動かす'}</button>
    <output id="bokeh-dist" for="bokeh-focus">3.0m</output>
  </div>
  <figcaption class="hint">{en
    ? 'On its own, the focus moves from the print to the distant street to the lights up close. Turning a dial switches to manual. Stopping down makes the bokeh smaller and hexagonal (a lens with six aperture blades).'
    : '自動では、ピントが写真 → 遠くの街 → 手前のイルミネーションの順に動きます。ダイヤルを回すと手動に切り替わります。絞ると玉ボケが小さく、六角形になります（絞り羽根6枚のレンズ）。'}</figcaption>
</figure>

<script>
  import { mountStage } from '../../scripts/gl/stage';
  import { createBokeh } from '../../scripts/demos/bokeh';
  document.querySelectorAll<HTMLElement>('.stage[data-demo="bokeh"]').forEach((el) => {
    mountStage(el, (renderer, stage) => createBokeh(renderer, stage, el.dataset.print ?? ''));
  });
</script>

<style>
  .camera-controls { display: grid; grid-template-columns: repeat(2, minmax(0, 180px)); gap: 16px; }
  .auto-focus { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .demo {
    margin: 0;
    display: grid;
    gap: 10px;
  }
</style>
