---
import type { SiteLanguage } from '../../lib/i18n';
interface Props { id: string; label: string; values: readonly (string | number)[]; value: number; outputKey?: string; lang?: SiteLanguage }
const { id, label, values, value, outputKey, lang = 'ja' } = Astro.props;
const hint = lang === 'en' ? 'Drag, scroll or use the arrow keys to adjust. Home and End jump to either end.' : 'ドラッグ、ホイール、矢印キーで調整できます。Home と End で両端に移動します。';
---
<div class="camera-dial" data-camera-dial data-dial-levels={JSON.stringify(values.map(String))} style={`--dial-angle: ${-140 + value / Math.max(1, values.length - 1) * 280}deg`}>
  <span class="label" id={`${id}-label`}>{label}</span>
  <div class="dial-face" data-dial-face role="slider" tabindex="0" aria-labelledby={`${id}-label`} aria-describedby={`${id}-hint`} aria-valuemin="0" aria-valuemax={values.length - 1} aria-valuenow={value} aria-valuetext={String(values[value])}>
    <span class="marker" aria-hidden="true"></span>
  </div>
  <input type="range" id={id} min="0" max={values.length - 1} step="1" value={value} hidden aria-hidden="true" tabindex="-1" />
  <output class="lcd" for={id} data-dial-value data-out={outputKey} aria-hidden="true">{values[value]}</output>
  <span class="sr-only" id={`${id}-hint`}>{hint}</span>
</div>
<script>
  import { mountCameraDials } from '../../scripts/controls/camera-dial';
  mountCameraDials();
</script>
<style>
  .camera-dial { display: grid; justify-items: center; align-content: start; gap: 10px; padding: 16px 10px; border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--on-dark); background: linear-gradient(140deg, #344a50, var(--brand-ink)); min-width: 0; }
  .label { font-size: 12px; font-weight: 700; text-align: center; }
  .dial-face { position: relative; width: 76px; height: 76px; border-radius: 50%; border: 2px solid #829295; background: repeating-conic-gradient(#18272c 0deg 5deg, #57676b 5deg 8deg); box-shadow: 0 4px 8px #0b1929; cursor: grab; touch-action: none; }
  .dial-face::before { content: ''; position: absolute; inset: 7px; border-radius: inherit; background: radial-gradient(circle at 30% 25%, #52676b, #192e34 75%); border: 1px solid #819398; }
  .marker { position: absolute; inset: 10px; border-radius: 50%; transform: rotate(var(--dial-angle)); transition: transform .08s; pointer-events: none; }
  .marker::before { content: ''; position: absolute; top: 0; left: calc(50% - 2px); width: 4px; height: 12px; border-radius: 2px; background: var(--brand); }
  .is-turning .dial-face { cursor: grabbing; }
  .dial-face:focus-visible { outline: 3px solid var(--brand); outline-offset: 5px; }
  .lcd { display: block; width: 100%; padding: 8px 4px; border: 1px solid #647f78; border-radius: 4px; background: #c5ded3; color: #16332e; text-align: center; font: 700 16px/1.3 var(--mono); font-variant-numeric: tabular-nums; box-shadow: inset 0 2px 4px #57786b; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  input[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .marker { transition: none; } }
</style>
