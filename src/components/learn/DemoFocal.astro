---
/** Same framing, different focal lengths: a plaster bust and a top-down diagram of where the camera stands. */
const lengths = [16, 24, 35, 50, 85, 135, 200];
import CameraDial from './CameraDial.astro';
import { FOCAL_STOPS } from '../../data/camera-settings';
---
<figure class="demo">
  <div class="grid">
    <div class="stage" data-demo="focal" data-slider="focal-mm" style="--fb: linear-gradient(#2a241e, #15120f)">
      <canvas aria-label="同じ大きさに写る距離で、撮影する人と石膏像の遠近感を比べる3Dデモ"></canvas>
      <div class="hud">
        <div class="row"><span class="tag" data-readout>50mm · 画角 47° · 距離 1.0m</span></div>
        <div class="row">
          <div class="chips" role="group" aria-label="焦点距離">
            {lengths.map((mm) => <button class="chip" type="button" data-mm={mm} aria-pressed={mm === 50 ? 'true' : 'false'}>{mm}mm</button>)}
          </div>
        </div>
      </div>
    </div>

    <div class="diagram" aria-hidden="true">
      <p class="edge">TOP VIEW · 真上から見た撮影位置</p>
      <svg viewBox="0 0 400 150" role="img">
        <line x1="20" y1="75" x2="380" y2="75" class="axis" />
        <path class="wedge" d="M0 0" />
        <g class="cam"><rect x="-9" y="-7" width="14" height="14" rx="2" /><rect x="5" y="-4" width="5" height="8" /></g>
        <g transform="translate(362 75)">
          <ellipse rx="9" ry="11" class="head" />
          <path d="M-9 -2 L-14 0 L-9 2" class="nose" />
        </g>
        <text class="dist" x="200" y="140" text-anchor="middle">1.0 m</text>
      </svg>
      <dl class="figures">
        <div><dt>焦点距離</dt><dd data-fig="mm">50mm</dd></div>
        <div><dt>画角（対角）</dt><dd data-fig="angle">47°</dd></div>
        <div><dt>被写体までの距離</dt><dd data-fig="dist">1.0m</dd></div>
      </dl>
    </div>
  </div>
  <div class="camera-controls">
    <CameraDial id="focal-mm" label="焦点距離" values={FOCAL_STOPS.map((mm) => `${mm}mm`)} value={6} />
  </div>
  <div class="choices">
    <label>被写体<select data-focal-subject><option value="photographer">撮影する人（写真部ロゴより）</option><option value="plaster">石膏像</option></select></label>
    <label>背景<select data-focal-background><option value="shoji">障子</option><option value="forest">奥行きのある森</option><option value="night">夜の街・玉ボケ</option></select></label>
  </div>
  <p class="hint" data-subject-status role="status"></p>
  <figcaption class="hint">
    どの焦点距離でも、頭と肩の上あたりまでが画面の高さに収まる距離から撮っています。被写体と背景を切り替え、背景の大きさや奥行きの見え方を比べられます。カーソルを動かすと少し回り込めます。
    <span class="credit" data-head-credit hidden>頭部モデル：<a href="https://www.ir-ltd.net/" target="_blank" rel="noopener">Infinite-Realities</a>「Lee Perry-Smith 3D Head Scan」（<a href="https://creativecommons.org/licenses/by/3.0/deed.ja" target="_blank" rel="noopener">CC BY 3.0</a>）を石膏像として表示</span>
  </figcaption>
</figure>

<script>
  import { mountStage } from '../../scripts/gl/stage';
  import { createFocal, type FocalState } from '../../scripts/demos/focal';

  document.querySelectorAll<HTMLElement>('.stage[data-demo="focal"]').forEach((el) => {
    const root = el.closest('.demo')!;
    const wedge = root.querySelector<SVGPathElement>('.wedge')!;
    const cam = root.querySelector<SVGGElement>('.cam')!;
    const dist = root.querySelector<SVGTextElement>('.dist')!;
    const fig = (k: string) => root.querySelector(`[data-fig="${k}"]`)!;
    const update = (s: FocalState) => {
      const span = 330 * (Math.log(s.distance / 0.25) / Math.log(7 / 0.25));
      const cx = 362 - Math.max(24, span);
      const half = Math.atan(0.012 / (s.mm / 1000));
      const reach = 362 - cx + 30;
      const dy = Math.tan(half) * reach;
      wedge.setAttribute('d', `M${cx} 75 L${cx + reach} ${75 - dy} L${cx + reach} ${75 + dy} Z`);
      cam.setAttribute('transform', `translate(${cx} 75)`);
      const d = s.distance < 1 ? s.distance.toFixed(2) : s.distance.toFixed(1);
      dist.textContent = `${d} m`;
      dist.setAttribute('x', String((cx + 362) / 2));
      fig('mm').textContent = `${Math.round(s.mm)}mm`;
      fig('angle').textContent = `${s.diagonal.toFixed(s.diagonal < 20 ? 1 : 0)}°`;
      fig('dist').textContent = `${d}m`;
    };
    mountStage(el, (renderer, stage) => createFocal(renderer, stage, update));
  });
</script>

<style>
  .camera-controls { max-width: 180px; }
  .choices { display: flex; flex-wrap: wrap; gap: 16px; }
  .choices label { display: grid; gap: 6px; font-size: 14px; min-width: 0; }
  .choices select { max-width: 100%; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--raise); font: inherit; }
  .credit[hidden] { display: none; }
  .credit {
    display: block;
    font-size: 12px;
  }

  .demo {
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .grid .stage {
    aspect-ratio: 4 / 3;
  }

  .diagram {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
    min-width: 0;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .axis {
    stroke: var(--line-strong);
    stroke-dasharray: 3 4;
  }

  .wedge {
    fill: rgba(100, 190, 198, 0.2);
    stroke: var(--accent);
    stroke-width: 1;
  }

  .cam rect {
    fill: var(--ink);
  }

  .head {
    fill: var(--mark);
  }

  .nose {
    fill: none;
    stroke: var(--mark);
    stroke-width: 2;
  }

  .dist {
    fill: var(--accent);
    font: 700 12px var(--latin);
  }

  .figures {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .figures div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }

  .figures dt {
    color: var(--muted);
    font-size: 14px;
  }

  .figures dd {
    margin: 0;
    font: 700 18px/1.2 var(--latin);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
