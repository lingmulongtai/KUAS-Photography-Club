---
/**
 * The two ways to reach the club from outside: email (with the subject filled in) and Instagram DM.
 */
import { club } from '../data/club';

interface Props {
  /** Prefilled email subject */
  subject?: string;
  lang?: string;
}
const { subject = 'KUAS Photography Club inquiry', lang = 'ja' } = Astro.props;
const en = lang === 'en';
const mailto = `mailto:${club.email}?subject=${encodeURIComponent(subject)}`;
---
<div class="ways">
  <article class="way">
    <p class="edge">EMAIL</p>
    <h3>{en ? 'Email us' : 'メールで送る'}</h3>
    <p class="addr"><span class="select">{club.email}</span></p>
    <p class="small muted">{en ? 'Include a subject such as photography request, sponsorship or press inquiry.' : '件名にご用件（撮影のご依頼・協賛・取材など）を入れていただけると助かります。'}</p>
    <div class="row">
      <a class="btn btn--primary" href={mailto}>{en ? 'Write an email' : 'メールを書く'} <span class="arrow" aria-hidden="true">→</span></a>
      <button class="btn copy" type="button" data-copy={club.email}>{en ? 'Copy address' : 'アドレスをコピー'}</button>
    </div>
  </article>
  <article class="way">
    <p class="edge">INSTAGRAM</p>
    <h3>{en ? 'Send a DM' : 'DM を送る'}</h3>
    <p class="addr">@{club.instagram.handle}</p>
    <p class="small muted">{en ? 'You can also contact the club through its Instagram profile.' : 'Instagram のプロフィールからもお問い合わせできます。'}</p>
    <div class="row">
      <a class="btn btn--primary" href={club.instagram.url} target="_blank" rel="noopener">{en ? 'Open Instagram' : 'Instagram を開く'} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </article>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.ways .copy').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.textContent;
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = document.documentElement.lang === 'en' ? 'Copied' : 'コピーしました';
      } catch {
        const el = b.closest('.way')?.querySelector('.select');
        if (el) window.getSelection()?.selectAllChildren(el);
        b.textContent = document.documentElement.lang === 'en' ? 'Selected' : '選択しました';
      }
      setTimeout(() => (b.textContent = label), 2000);
    }),
  );
</script>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .way {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .way h3 {
    font-size: var(--step-2);
  }

  .addr {
    font: 700 clamp(16px, 2vw, 19px) / 1.4 var(--latin);
    overflow-wrap: anywhere;
    color: var(--accent);
  }

  .select {
    user-select: all;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  @media (max-width: 700px) {
    .ways {
      grid-template-columns: 1fr;
    }
  }
</style>
