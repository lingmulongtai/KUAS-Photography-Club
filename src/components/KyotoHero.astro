---
/**
 * Full-bleed top-page hero: Kyoto in 3D from real geodata (GSI terrain and aerial photos,
 * PLATEAU buildings), seen from Shogunzuka. The sky follows the real time in Kyoto.
 * Tap the sky for a shooting star; the campus pin flies the camera to the Uzumasa campus.
 */
import { club } from '../data/club';
import { getCollection } from 'astro:content';
import { credit } from '../lib/trips';
import { completeSpotPreviews } from '../data/spot-samples';
const pinTrips = completeSpotPreviews((await getCollection('trips'))
  .filter((t) => t.data.spot)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((t) => ({ spot: t.data.spot!, title: t.data.title, href: `/trips/${encodeURIComponent(t.id)}/`, src: t.data.photos[0].src, alt: t.data.photos[0].alt, credit: credit(t.data.photos[0], t.data.date), sample: t.data.sample })));
---
<section class="hero" aria-labelledby="hero-title" data-view="city">
  <div class="stage hero-stage" data-demo="hero" data-trips={JSON.stringify(pinTrips)}>
    <canvas aria-label="将軍塚から西を望む京都の街の3D。実際の地形と建物のデータから作り、空は京都の現在時刻に合わせて変わります"></canvas>
    <nav class="views" aria-label="眺める場所">
      <span class="views-label">VIEW</span>
      <button type="button" data-view="shogunzuka" aria-pressed="true">将軍塚</button>
      <button type="button" data-view="kiyomizu" aria-pressed="false">清水の舞台</button>
      <button type="button" data-view="daimonji" aria-pressed="false">大文字山</button>
      <button type="button" data-view="tower" aria-pressed="false">京都タワー</button>
      <button type="button" data-view="arashiyama" aria-pressed="false">嵐山・大悲閣</button>
      <button type="button" data-view="funaoka" aria-pressed="false">船岡山</button>
      <button type="button" data-view="kinkaku" aria-pressed="false">金閣寺</button>
    </nav>
    <div class="loading" aria-hidden="true">
      <span class="spin"></span>
      <span>京都の街を読み込んでいます</span>
    </div>
  </div>
  <div class="scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="copy">
      <p class="edge eyebrow">KYOTO ▸ <span data-status>いまの空</span></p>
      <h1 id="hero-title">京都の空の下で、<br />写真を撮っています。</h1>
      <p class="lead">
        {club.nameJa}です。月に2回の撮影会で、京都の街や近くの府県へ写真を撮りに出かけています。カメラがなくても、スマホひとつで参加できます。
      </p>
      <div class="ctas">
        <a class="btn btn--primary" href="/trips/">撮影会の記録を見る <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--glass" href="/join/">見学・入部について</a>
      </div>
    </div>

    <aside class="sky-chip" aria-label="いまの京都の空">
      <p class="now">
        <span class="clock num" data-clock>--:--</span>
        <span data-phase>—</span>
        <span class="moon" data-moon></span>
      </p>
      <div class="times" role="group" aria-label="空の時間を切り替える">
        <button type="button" data-time="now" aria-pressed="true">いま</button>
        <button type="button" data-time="morning" aria-pressed="false">朝</button>
        <button type="button" data-time="noon" aria-pressed="false">昼</button>
        <button type="button" data-time="sunset" aria-pressed="false">夕焼け</button>
        <button type="button" data-time="night" aria-pressed="false">夜</button>
      </div>
      <p class="hint">ドラッグで360°見回せます。スマホは横スワイプ。<span>空をタップすると流れ星。「太秦キャンパス」から近づけます。夜景の送り火はイメージです。</span></p>
    </aside>
  </div>

  <div class="campus-card" role="region" aria-label="太秦キャンパス" hidden>
    <p class="edge">OUR CAMPUS</p>
    <h2>京都先端科学大学<br />太秦キャンパス</h2>
    <p class="small">写真部はここで集まっています。</p>
    <dl>
      <div><dt>ミーティング</dt><dd>{club.meetings.day} {club.meetings.times.join(' / ')}</dd></div>
      <div><dt>教室</dt><dd>{club.meetings.room}</dd></div>
    </dl>
    <div class="card-actions">
      <a class="btn btn--primary" href="/join/">見学に行く <span class="arrow" aria-hidden="true">→</span></a>
      <button class="btn btn--glass back" type="button">← 街の眺めに戻る</button>
    </div>
  </div>

  <p class="credit">地形・航空写真：国土地理院　建物：PLATEAU（国土交通省）　森林：© OpenStreetMap contributors</p>
  <a class="scroll-cue" href="#intro"><span>SCROLL</span></a>
</section>

<script>
  import { mountStage } from '../scripts/gl/stage';
  import { createHero, type HeroMode, type HeroStatus, type HeroView } from '../scripts/hero/scene';
  import { createLook, lookAt } from '../scripts/hero/palette';
  import { jstDateAt, jstMinutes, sunPosition, sunTimes } from '../scripts/hero/astro';

  const stage = document.querySelector<HTMLElement>('.stage[data-demo="hero"]');
  const hero = stage?.closest<HTMLElement>('.hero');
  if (stage && hero) {
    const out = {
      status: hero.querySelector('[data-status]'),
      clock: hero.querySelector('[data-clock]'),
      phase: hero.querySelector('[data-phase]'),
      moon: hero.querySelector('[data-moon]'),
    };
    const card = hero.querySelector<HTMLElement>('.campus-card')!;
    const back = card.querySelector<HTMLButtonElement>('.back')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');

    const hhmm = (m: number) => {
      const v = ((Math.floor(m) % 1440) + 1440) % 1440;
      return `${String(Math.floor(v / 60)).padStart(2, '0')}:${String(v % 60).padStart(2, '0')}`;
    };
    /* the sky follows the real time unless someone picks another time of today */
    const sky = { live: true, from: 0, delta: 0, start: 0, dur: 0 };
    const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const shown = () => {
      const real = jstMinutes(new Date());
      if (!sky.dur) return sky.live ? real : sky.from + sky.delta;
      const p = Math.min(1, (performance.now() - sky.start) / sky.dur);
      const m = sky.from + sky.delta * ease(p);
      if (p >= 1) {
        sky.dur = 0;
        sky.from = m;
        sky.delta = 0;
      }
      return m;
    };
    const presets = (key: string) => {
      const { sunrise, sunset } = sunTimes(new Date());
      return { morning: sunrise - 6, noon: 12 * 60 + 30, sunset: sunset - 14, night: sunset + 100 }[key] ?? jstMinutes(new Date());
    };
    const timeButtons = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-time]'));
    timeButtons.forEach((b) =>
      b.addEventListener('click', () => {
        const key = b.dataset.time!;
        const from = shown();
        const to = key === 'now' ? jstMinutes(new Date()) : presets(key);
        // take the short way round the clock
        const delta = ((((to - from) % 1440) + 2160) % 1440) - 720;
        sky.live = key === 'now';
        sky.from = from;
        sky.delta = delta;
        sky.start = performance.now();
        sky.dur = motion.matches ? 0 : 2800;
        if (!sky.dur) {
          sky.from = from + delta;
          sky.delta = 0;
        }
        timeButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );

    const onStatus = (s: HeroStatus) => {
      if (out.clock) out.clock.textContent = hhmm(s.minutes);
      if (out.phase) out.phase.textContent = s.phase;
      if (out.moon) out.moon.textContent = `月齢 ${s.moonAge.toFixed(1)}`;
      if (out.status) out.status.textContent = `${sky.live ? 'いま' : '表示中'} ${hhmm(s.minutes)} · ${s.phase}`;
    };

    const setView = (mode: HeroMode, arrived: boolean) => {
      hero.dataset.view = mode;
      if (mode === 'campus') {
        card.hidden = false;
        if (arrived) back.focus({ preventScroll: true });
      } else if (!arrived) card.hidden = true;
    };

    const coarse = matchMedia('(pointer: coarse)').matches;
    const cores = navigator.hardwareConcurrency || 4;
    const quality = coarse || cores < 6 || window.innerWidth < 900 ? 0.55 : 1;

    let demo: ReturnType<typeof createHero> | null = null;
    const mounted = mountStage(
      stage,
      (renderer, el) =>
        (demo = createHero(renderer, el, {
          now: () => (sky.live && !sky.dur ? new Date() : jstDateAt(new Date(), ((shown() % 1440) + 1440) % 1440)),
          quality,
          trips: JSON.parse(stage.dataset.trips ?? '[]'),
          get reducedMotion() { return motion.matches; },
          drift: !coarse,
          onStatus,
          onReady: () => hero.classList.add('is-ready'),
          onAction: (id) => id === 'kuas' && demo?.flyTo('campus'),
          onMode: setView,
          avoid: () => {
            const base = stage.getBoundingClientRect();
            return [hero.querySelector('.copy'), hero.querySelector('.sky-chip'), card.hidden ? null : card]
              .filter((n): n is Element => !!n)
              .map((n) => {
                const r = n.getBoundingClientRect();
                return { x: r.left - base.left, y: r.top - base.top, w: r.width, h: r.height };
              });
          },
        })),
      { maxDpr: quality < 1 ? 1.5 : 2, alwaysOn: false },
    );

    back.addEventListener('click', () => demo && demo.flyTo(demo.view));
    hero.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && demo?.mode === 'campus') demo.flyTo(demo.view);
    });

    const viewButtons = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-view]'));
    viewButtons.forEach((b) =>
      b.addEventListener('click', () => {
        if (!demo) return;
        demo.flyTo(b.dataset.view as HeroView);
        viewButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );

    if (!mounted) {
      // No WebGL: paint today's sky as a still gradient instead
      const look = lookAt((sunPosition(new Date()).altitude * 180) / Math.PI, createLook());
      stage.style.setProperty(
        '--fb',
        `linear-gradient(${look.zenith.getStyle()}, ${look.mid.getStyle()} 55%, ${look.horizon.getStyle()} 85%, #05070c)`,
      );
      hero.classList.add('is-ready', 'no-3d');
    }
  }
</script>

<style>
  .hero {
    position: relative;
    height: max(640px, min(100svh, 1080px));
    overflow: hidden;
    background: #0b1424;
    isolation: isolate;
    color: var(--on-dark);
  }

  .hero-stage {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    box-shadow: none;
    z-index: 0;
    cursor: grab;
    touch-action: pan-y;
  }

  .hero-stage.is-dragging { cursor: grabbing; }

  /* viewpoints */
  .views {
    position: absolute;
    z-index: 3;
    top: calc(var(--header-h) + 14px);
    left: max(var(--gutter), calc((100% - var(--maxw)) / 2));
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(10, 18, 28, 0.38);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    max-width: calc(100% - var(--gutter) * 2);
    overflow-x: auto;
    scrollbar-width: none;
    opacity: 0;
    transition: opacity 0.8s 0.6s;
  }

  .is-ready .views {
    opacity: 1;
  }

  .views::-webkit-scrollbar {
    display: none;
  }

  .views-label {
    padding: 0 8px 0 10px;
    font: 700 10px/1 var(--latin);
    letter-spacing: 0.2em;
    color: var(--brand);
  }

  .views button {
    flex: none;
    appearance: none;
    padding: 7px 13px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--on-dark);
    font: 700 12px/1.3 var(--body);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s;
  }

  .views button:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .views button[aria-pressed='true'] {
    background: var(--brand);
    color: var(--on-accent);
  }

  .loading {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 13px/1 var(--body);
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.85);
    transition: opacity 0.8s;
    pointer-events: none;
  }

  .spin {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-top-color: var(--brand);
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .is-ready .loading {
    opacity: 0;
  }

  .scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: 70%;
    background:
      radial-gradient(120% 90% at 0% 100%, rgba(6, 12, 20, 0.62), rgba(6, 12, 20, 0) 60%),
      linear-gradient(rgba(6, 12, 20, 0), rgba(6, 12, 20, 0.45) 50%, rgba(6, 12, 20, 0.82));
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.8s;
  }

  .hero-inner {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    max-width: calc(var(--maxw) + var(--gutter) * 2);
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(40px, 6vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: end;
    gap: 28px 48px;
    pointer-events: none;
    transition: opacity 0.6s, transform 0.6s;
  }

  .copy,
  .sky-chip {
    pointer-events: auto;
    min-width: 0;
  }

  .copy {
    display: grid;
    gap: 16px;
  }

  .eyebrow {
    color: var(--brand);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
  }

  h1 {
    font-size: clamp(30px, 4.1vw, 56px);
    letter-spacing: 0.06em;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.5);
  }

  .lead {
    font-size: 16px;
    max-width: 32em;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.6);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .btn--glass {
    color: var(--on-dark);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .btn--glass:hover {
    background: var(--on-dark);
    border-color: var(--on-dark);
    color: var(--ink);
  }

  .sky-chip {
    justify-self: end;
    display: grid;
    gap: 6px;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: rgba(10, 18, 28, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    max-width: 360px;
  }

  .times {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .times button {
    appearance: none;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.06);
    color: var(--on-dark);
    font: 700 11px/1.4 var(--body);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .times button:hover {
    border-color: var(--brand);
  }

  .times button[aria-pressed='true'] {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-accent);
  }

  .now {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 13px;
    font-weight: 700;
  }

  .clock {
    font-size: 28px;
    line-height: 1;
    color: var(--brand);
  }

  .moon {
    font-weight: 500;
    opacity: 0.75;
  }

  .hint {
    font-size: 12px;
    line-height: 1.6;
    opacity: 0.8;
  }

  .hint span {
    display: block;
  }

  /* campus view */
  .campus-card {
    position: absolute;
    z-index: 3;
    right: max(var(--gutter), calc((100vw - var(--maxw)) / 2));
    bottom: clamp(40px, 6vw, 72px);
    width: min(360px, calc(100% - var(--gutter) * 2));
    display: grid;
    gap: 10px;
    padding: 22px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.94);
    color: var(--ink);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    animation: card-in 0.7s 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .campus-card[hidden] {
    display: none;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .campus-card h2 {
    font-size: 22px;
    line-height: 1.4;
  }

  .campus-card dl {
    margin: 4px 0;
    display: grid;
    gap: 4px;
    font-size: 14px;
  }

  .campus-card dl div {
    display: flex;
    gap: 12px;
  }

  .campus-card dt {
    width: 6.5em;
    color: var(--muted);
    font-weight: 700;
  }

  .campus-card dd {
    margin: 0;
    font-weight: 700;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .campus-card .back {
    color: var(--ink);
    background: transparent;
    border-color: var(--ink);
  }

  .campus-card .back:hover {
    background: var(--ink);
    color: var(--on-dark);
  }

  .hero[data-view='campus'] .hero-inner {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  .hero[data-view='campus'] .hero-inner * {
    pointer-events: none;
  }

  .hero[data-view='campus'] .scrim {
    opacity: 0.4;
  }

  .credit {
    position: absolute;
    z-index: 2;
    right: 10px;
    bottom: 8px;
    font-size: 10px;
    opacity: 0.55;
    pointer-events: none;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 10px;
    z-index: 2;
    transform: translateX(-50%);
    font: 700 10px/1 var(--latin);
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    padding: 8px;
  }

  .scroll-cue span::after {
    content: '';
    display: block;
    width: 1px;
    height: 22px;
    margin: 8px auto 0;
    background: currentColor;
    animation: cue 2.4s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes cue {
    0%,
    100% {
      transform: scaleY(0.3);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  /* pins placed by the scene (created in script, so styled globally) */
  .hero :global(.hero-labels) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 1s 0.4s;
  }

  .hero.is-ready :global(.hero-labels) {
    opacity: 1;
  }

  .hero :global(.hero-pin) {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--on-dark);
    opacity: 0;
    transition: opacity 0.5s;
    will-change: transform;
  }

  .hero :global(.hero-pin.is-shown) {
    opacity: 1;
  }

  .hero :global(.hero-pin:not(.is-shown)) { pointer-events: none; }
  .hero :global(.pin-trigger) { color: inherit; font: inherit; background: none; border: 0; padding: 0; }
  .hero :global(button.pin-trigger) { position: absolute; width: 44px; height: 44px; left: -22px; top: -22px; cursor: pointer; }
  .hero :global(button.pin-trigger .pin-dot) { left: 22px; top: 22px; }
  .hero :global(button.pin-trigger .pin-text) { left: 22px; bottom: 34px; }
  .hero :global(.hero-pin.is-linked) { pointer-events: auto; }
  .hero :global(.hero-pin.is-open) { z-index: 5; }
  .hero :global(.pin-trips) {
    position: absolute;
    bottom: 48px;
    left: clamp(calc(16px - var(--pin-x)), -124px, calc(var(--stage-w) - var(--pin-x) - 264px));
    width: min(248px, calc(100vw - 32px));
    max-height: 320px;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .hero :global(.pin-trips[hidden]) { display: none; }
  .hero :global(.opens-below .pin-trips) { bottom: auto; top: 12px; }
  .hero :global(.pin-trips a) { display: grid; gap: 5px; text-decoration: none; margin-bottom: 10px; }
  .hero :global(.pin-trips a:last-child) { margin-bottom: 0; }
  .hero :global(.pin-trips img) { width: 100%; height: 112px; object-fit: cover; border-radius: var(--radius-sm); }
  .hero :global(.pin-trips strong) { font-size: 13px; }
  .hero :global(.pin-trips small) { font-size: 10px; color: var(--muted); }
  .hero :global(.pin-trips button) { width: 100%; margin-bottom: 10px; padding: 10px; border: 0; border-radius: 6px; background: var(--brand); color: var(--on-accent); font: inherit; cursor: pointer; }

  .hero :global(.hero-pin.is-muted) {
    opacity: 0 !important;
  }

  .hero :global(.pin-dot) {
    position: absolute;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
