---
/**
 * Full-bleed top-page hero: Kyoto in 3D from real geodata (GSI terrain and aerial photos,
 * PLATEAU buildings), seen from Shogunzuka. The sky follows the real time in Kyoto.
 * Tap a map pin to explore its spot, or the sky for a shooting star.
 */
import { club } from '../data/club';
import HeroIntro from './HeroIntro.astro';
import { languagePath } from '../lib/i18n';
interface Props { lang?: 'ja' | 'en'; }
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
const local = (href: string) => languagePath(href, lang);
import { credit, getTrips } from '../lib/trips';
import { completeSpotPreviews } from '../data/spot-samples';
import { SPOTS } from '../data/spots';
import { PANORAMA_VIEWS, VIEWS } from '../scripts/hero/views';
const pinTrips = completeSpotPreviews((await getTrips())
  .filter((t) => t.data.spot)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((t) => ({ spot: t.data.spot!, title: t.data.title, href: `/trips/${encodeURIComponent(t.id)}/`, src: t.data.photos[0].src, alt: t.data.photos[0].alt, credit: credit(t.data.photos[0], t.data.date), sample: t.data.sample }))).map(t => en && t.sample ? { ...t, title: 'Activity records', credit: 'Records are being prepared', href: '/en/trips/' } : t);
---
<HeroIntro lang={lang} />
<section class="hero" aria-labelledby="hero-title" data-view="city" data-lang={lang}>
  <div class="stage hero-stage" data-demo="hero" data-trips={JSON.stringify(pinTrips)}>
    <canvas aria-label={en ? 'Explore Kyoto in 3D using real terrain and building data. Drag to look around and select a place to move closer.' : '実際の地形と建物データから作った京都の3D。ドラッグで見回し、地点を選ぶと近づけます。'}></canvas>
    <nav class="views" aria-label={en ? 'Scenic viewpoints' : '展望地点'}>
      <span class="views-label">VIEW</span>
      <div class="view-options">
        <span class="view-lens" aria-hidden="true"></span>
        {PANORAMA_VIEWS.map(view => <button type="button" data-view={view} aria-pressed={view==='shogunzuka'} disabled>{VIEWS[view][lang]}</button>)}
      </div>
    </nav>
    <div class="explore-touch" role="group" aria-label={en ? 'Move in free explore' : '自由散策の移動操作'} hidden>
      <div class="explore-directions">
        <button type="button" data-direction="forward" aria-label={en ? 'Move forward' : '前に移動'}>▲</button>
        <button type="button" data-direction="left" aria-label={en ? 'Move left' : '左に移動'}>◀</button>
        <button type="button" data-direction="back" aria-label={en ? 'Move back' : '後ろに移動'}>▼</button>
        <button type="button" data-direction="right" aria-label={en ? 'Move right' : '右に移動'}>▶</button>
      </div>
      <div class="explore-altitude">
        <button type="button" data-direction="up" aria-label={en ? 'Move up' : '上昇'}>＋</button>
        <button type="button" data-direction="down" aria-label={en ? 'Move down' : '下降'}>−</button>
      </div>
    </div>
  </div>
  <div class="spot-nav">
      <label class="visually-hidden" for="hero-spot">{en ? 'Explore a place in 3D' : '3Dで近づくスポット'}</label>
      <select id="hero-spot" class="spot-select" disabled>
        <option value="" selected disabled>{en ? 'Explore a place' : 'スポットへ移動'}</option>
        {SPOTS.map(spot => <option value={spot.id}>{spot[lang]}</option>)}
      </select>
      <button type="button" class="spot-return" hidden>{en ? 'Back to view' : '展望へ戻る'}</button>
      <a class="spot-records" hidden>{en ? 'Outing records' : '活動記録'}</a>
      <span class="visually-hidden" role="status" data-place-status></span>
      <span class="area-status" role="status" data-area-status hidden>{en ? 'Loading the surrounding area…' : '周辺の景色を読み込んでいます…'}</span>
      <button type="button" class="explore-toggle" aria-pressed="false" aria-controls="explore-guide" disabled>{en ? 'Explore freely ↗' : '自由散策を始める ↗'}</button>
      <aside class="explore-guide" id="explore-guide" aria-label={en ? 'Free explore controls' : '自由散策の操作方法'} hidden>
        <p class="explore-guide-title">{en ? 'FREE EXPLORE' : '自由散策の操作'}</p>
        <p class="explore-touch-hint">{en ? 'Swipe to look. Hold arrows to move; + / − changes altitude. Pinch to zoom. Scroll from this guide or outside the scenery.' : 'スワイプで見回す。矢印長押しで移動、＋ / −で上下。ピンチでズーム。スクロールはこの説明欄や景色の外から。'}</p>
        <dl class="explore-keyboard-hint">
          <div><dt>{en ? 'Drag' : 'ドラッグ'}</dt><dd>{en ? 'Look around' : '見回す'}</dd></div>
          <div><dt>W / A / S / D · ↑ / ← / ↓ / →</dt><dd>{en ? 'Move' : '前後・左右に移動'}</dd></div>
          <div><dt>Q / E</dt><dd>{en ? 'Down / up' : '下降・上昇'}</dd></div>
          <div><dt>Shift</dt><dd>{en ? 'Move faster' : '加速'}</dd></div>
          <div><dt>{en ? 'Wheel' : 'ホイール'}</dt><dd>{en ? 'Move forward / back' : '前後に移動'}</dd></div>
          <div><dt>Ctrl / ⌘ + {en ? 'wheel' : 'ホイール'}</dt><dd>{en ? 'Zoom' : '画角を調整'}</dd></div>
          <div><dt>Esc</dt><dd>{en ? 'Exit exploration' : '散策を終了'}</dd></div>
        </dl>
      </aside>
  </div>
  <div class="scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="copy">
      <p class="edge eyebrow">KYOTO ▸ <span data-status>いまの空</span></p>
      <h1 id="hero-title">{en ? <>Photography,<br />under Kyoto’s sky.</> : <>京都の空の下で、<br />写真を撮っています。</>}</h1>
      <p class="lead">
        {en ? 'We are the photography club at Kyoto University of Advanced Science. Members plan photo outings together. A smartphone is enough to take part.' : `${club.nameJa}です。部員で相談しながら撮影会を企画しています。カメラがなくても、スマホひとつで参加できます。`}
      </p>
      <div class="ctas">
        <a class="btn btn--primary" href={local('/trips/')}>{en ? 'View outing records' : '撮影会の記録を見る'}<span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--glass" href={local('/join/')}>{en ? 'Visit / Join' : '見学・入部について'}</a>
      </div>
    </div>

    <aside class="sky-chip" aria-label={en ? 'Kyoto sky' : '京都の空'}>
      <p class="now">
        <span class="clock num" data-clock>--:--</span>
        <span data-phase>—</span>
        <span class="moon" data-moon></span>
        <span class="moon" data-moon-times></span>
      </p>
      <div class="time-control">
        <div class="time-heading"><label for="sky-time">{en ? 'Time in Kyoto' : '京都の時間'}</label><button type="button" data-time="now" aria-pressed="true">{en ? 'Now' : 'いま'}</button></div>
        <div class="time-slider" style="--progress: 0.5">
          <span class="time-track" aria-hidden="true"><span class="time-fill"></span></span>
          <span class="time-thumb" aria-hidden="true"></span>
          <input id="sky-time" type="range" min="0" max="1439" step="1" value="720" aria-label={en ? 'Time in Kyoto' : '京都の時間'} aria-valuetext="12:00" disabled />
        </div>
        <div class="time-marks" aria-hidden="true"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
      </div>
      <label class="season-picker">{en?'Seasonal scenery':'季節の演出'}
        <select data-season aria-label={en?'Choose seasonal scenery':'季節の演出を選ぶ'}>
          <option value="auto">{en?'Current month':'いまの季節'}</option>
          <option value="spring">{en?'Spring':'春'}</option><option value="summer">{en?'Summer':'夏'}</option>
          <option value="autumn">{en?'Autumn':'秋'}</option><option value="winter">{en?'Winter':'冬'}</option>
        </select>
      </label>
      <p class="hint">{en ? 'Drag or swipe sideways to look around.' : 'ドラッグで360°見回せます。スマホは横スワイプ。'}<span>{en ? 'Tap a map label or choose a place to move closer. Swipe vertically to scroll the page. Tap the sky for a shooting star. Seasonal snow, bonfires and the blue night beam are illustrative, rather than live weather or event information.' : '地図の地点をタップするか、スポットを選ぶと近づけます。縦スワイプはページのスクロール。空をタップすると流れ星。季節の雪や夜景の送り火・青い光は演出で、当日の天気や催事を示すものではありません。'}</span></p>
    </aside>
  </div>

  <div class="campus-card" role="region" aria-label="太秦キャンパス" hidden>
    <p class="edge">OUR CAMPUS</p>
    <h2>{en ? <>Kyoto University of Advanced Science<br />Uzumasa Campus</> : <>京都先端科学大学<br />太秦キャンパス</>}</h2>
    <p class="small">{en ? 'Our usual meeting place.' : '写真部はここで集まっています。'}</p>
    <dl>
      <div><dt>{en ? 'Meeting' : 'ミーティング'}</dt><dd>{en ? 'Fridays' : club.meetings.day} {club.meetings.times.join(' / ')}</dd></div>
      <div><dt>{en ? 'Usual room' : '通常の教室'}</dt><dd>{club.meetings.room}</dd></div>
    </dl>
    <a class="small" href={local('/schedule/')}>{en ? 'Check cancellations and room changes' : '休会・教室変更の最新案内を確認'}</a>
    <div class="card-actions">
      <a class="btn btn--primary" href={local('/join/')}>{en ? 'Plan a visit' : '見学に行く'}<span class="arrow" aria-hidden="true">→</span></a>
      <button class="btn btn--glass back" type="button">{en ? '← Back to Kyoto' : '← 街の眺めに戻る'}</button>
    </div>
  </div>

  <p class="credit">地形・航空写真：国土地理院　建物：PLATEAU（国土交通省）　森林：© OpenStreetMap contributors</p>
  <a class="scroll-cue" href="#intro"><span>SCROLL</span></a>
</section>

<script>
  import { mountStage } from '../scripts/gl/stage';
  import { createHero, type HeroMode, type HeroStatus, type HeroView } from '../scripts/hero/scene';
  import { createLook, kelvin, lookAt, phaseName } from '../scripts/hero/palette';
  import { jstDateAt, jstMinutes, jstParts, moonPhaseName, moonPosition, moonTimes, sunPosition } from '../scripts/hero/astro';
  import { createSkyTime, wrapDay } from '../scripts/hero/sky-time';
  import { mountGlassRefraction } from '../scripts/hero/glisse-refraction';
  import { createExploreButtons } from '../scripts/hero/explore-touch';
  import { SPOTS, type SpotId } from '../data/spots';
  import { PANORAMA_VIEWS, VIEWS, spotDestination } from '../scripts/hero/views';
  import type {Season} from '../scripts/hero/seasons';

  const stage = document.querySelector<HTMLElement>('.stage[data-demo="hero"]');
  const hero = stage?.closest<HTMLElement>('.hero');
  if (stage && hero) {
    const en = hero.dataset.lang === 'en';
    const out = {
      status: hero.querySelector('[data-status]'),
      clock: hero.querySelector('[data-clock]'),
      phase: hero.querySelector('[data-phase]'),
      moon: hero.querySelector('[data-moon]'),
      moonTimes: hero.querySelector('[data-moon-times]'),
    };
    // moonrise and moonset for today in Japan, worked out once a day
    let moonDay = '';
    let moonDayText = '';
    const moonTimesText = () => {
      const now = new Date();
      const { year, month, day } = jstParts(now);
      const key = `${year}-${month}-${day}`;
      if (key !== moonDay) {
        moonDay = key;
        const { rise, set } = moonTimes(now);
        const t = (m: number) => (Number.isNaN(m) ? '—' : hhmm(m));
        moonDayText = en ? `Moonrise ${t(rise)} · set ${t(set)}` : `月の出 ${t(rise)}・月の入り ${t(set)}`;
      }
      return moonDayText;
    };
    const card = hero.querySelector<HTMLElement>('.campus-card')!;
    const back = card.querySelector<HTMLButtonElement>('.back')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const cameraHint=hero.querySelector('.hint')!.firstChild!;
    const exploreGuide=hero.querySelector<HTMLElement>('.explore-guide')!;
    const exploreTouch=hero.querySelector<HTMLElement>('.explore-touch')!;
    const spotSelect=hero.querySelector<HTMLSelectElement>('.spot-select')!;
    const spotReturn=hero.querySelector<HTMLButtonElement>('.spot-return')!;
    const spotRecords=hero.querySelector<HTMLAnchorElement>('.spot-records')!;
    const placeStatus=hero.querySelector('[data-place-status]')!;
    const areaStatus=hero.querySelector<HTMLElement>('[data-area-status]')!;
    const exploreToggle=hero.querySelector<HTMLButtonElement>('.explore-toggle')!;
    const viewButtons = Array.from(hero.querySelectorAll<HTMLButtonElement>('button[data-view]'));
    const viewBar = hero.querySelector<HTMLElement>('.views')!;
    const viewOptions = hero.querySelector<HTMLElement>('.view-options')!;
    const viewLens = hero.querySelector<HTMLElement>('.view-lens')!;
    const moveLens = (button: HTMLButtonElement | undefined, immediate = false) => {
      viewLens.hidden = !button;
      if (!button) return;
      if (immediate) viewLens.classList.add('no-motion');
      viewLens.style.width = `${button.offsetWidth}px`;
      viewLens.style.transform = `translateX(${button.offsetLeft}px)`;
      if (immediate) requestAnimationFrame(() => viewLens.classList.remove('no-motion'));
    };
    const revealView = (button: HTMLButtonElement | undefined) => {
      if (!button) return;
      const view = button.getBoundingClientRect(), bar = viewBar.getBoundingClientRect();
      const offset = view.right > bar.right ? view.right - bar.right + 8 : view.left < bar.left ? view.left - bar.left - 8 : 0;
      if (offset) viewBar.scrollBy({ left: offset, behavior: motion.matches ? 'instant' : 'smooth' });
    };
    viewOptions.classList.add('is-enhanced');
    moveLens(viewButtons[0], true);
    new ResizeObserver(() => moveLens(viewButtons.find(b => b.getAttribute('aria-pressed') === 'true'), true)).observe(viewOptions);
    let panorama: HeroView='shogunzuka';

    const hhmm = (m: number) => {
      const v = ((Math.floor(m) % 1440) + 1440) % 1440;
      return `${String(Math.floor(v / 60)).padStart(2, '0')}:${String(v % 60).padStart(2, '0')}`;
    };
    /* the sky follows the real time unless someone picks another time of today */
    const sky = createSkyTime();
    const shown = () => sky.shown(jstMinutes(new Date()), performance.now());
    const timeSlider = hero.querySelector<HTMLInputElement>('#sky-time')!;
    const timeTrack = hero.querySelector<HTMLElement>('.time-slider')!;
    const nowButton = hero.querySelector<HTMLButtonElement>('[data-time="now"]')!;
    let adjustingTime = false;
    const updateSlider = (minutes: number) => {
      const value = Math.min(1439, Math.floor(wrapDay(minutes)));
      timeSlider.value = String(value);
      timeSlider.setAttribute('aria-valuetext', hhmm(value));
      timeTrack.style.setProperty('--progress', String(value / 1439));
    };
    timeSlider.addEventListener('pointerdown', () => { adjustingTime = true; timeTrack.classList.add('is-held'); });
    const releaseTime = () => { adjustingTime = false; timeTrack.classList.remove('is-held'); };
    for (const event of ['pointerup', 'pointercancel', 'lostpointercapture', 'blur']) timeSlider.addEventListener(event, releaseTime);
    window.addEventListener('pointerup', releaseTime);
    window.addEventListener('blur', releaseTime);
    timeSlider.addEventListener('input', () => {
      const value = Number(timeSlider.value);
      sky.scrub(value, jstMinutes(new Date()), performance.now());
      nowButton.setAttribute('aria-pressed', 'false');
      updateSlider(value);
      showTimeStatus(value);
    });
    nowButton.addEventListener('click', () => {
      const real = jstMinutes(new Date());
      sky.select(real, true, real, performance.now(), true);
      nowButton.setAttribute('aria-pressed', 'true');
      showTimeStatus(real);
    });

    const onStatus = (s: HeroStatus) => {
      if (out.clock) out.clock.textContent = hhmm(s.minutes);
      if (!adjustingTime) updateSlider(s.minutes);
      const phase = en ? (s.altitude < -12 ? 'Night' : s.altitude < 0 ? 'Twilight' : s.altitude < 20 ? 'Low sunlight' : 'Day') : s.phase;
      if (out.phase) out.phase.textContent = phase;
      if (out.moon) out.moon.textContent = `${en ? 'Moon age' : '月齢'} ${s.moonAge.toFixed(1)} ${moonPhaseName(s.moonAge, en)}`;
      if (out.moonTimes) out.moonTimes.textContent = moonTimesText();
      if (out.status) out.status.textContent = `${sky.live ? (en ? 'Now' : 'いま') : (en ? 'Viewing' : '表示中')} ${hhmm(s.minutes)} · ${phase}`;
    };
    // The canvas pauses when it is offscreen, but its controls can still be visible on a phone.
    const showTimeStatus = (minutes: number) => {
      const date = jstDateAt(new Date(), minutes);
      const altitude = sunPosition(date).altitude * 180 / Math.PI;
      onStatus({ minutes, altitude, phase: phaseName(altitude, minutes), kelvin: kelvin(altitude), moonAge: moonPosition(date).age });
    };
    // Keep the visible clock live even when the scene has paused outside the viewport.
    window.setInterval(() => {
      if (!sky.live || sky.transitioning || document.hidden) return;
      const rect = timeTrack.getBoundingClientRect();
      if (rect.bottom >= 0 && rect.top <= window.innerHeight) showTimeStatus(jstMinutes(new Date()));
    }, 30_000);

    const setView = (mode: HeroMode, arrived: boolean) => {
      hero.dataset.view = mode;
      const atPanorama=mode==='city' && PANORAMA_VIEWS.some(id=>id===demo?.view);
      if (atPanorama && demo) panorama=demo.view;
      const selected=SPOTS.find(spot=>spotDestination(spot.id)===(mode==='campus'?'campus':demo?.view));
      spotSelect.value=atPanorama?'':selected?.id??'';
      spotReturn.hidden=mode==='campus'||atPanorama;
      spotRecords.hidden=spotReturn.hidden||!selected;
      if (selected) spotRecords.href=en?'/en/trips/':`/trips/spots/${selected.id}/`;
      const placeName=selected?.[en?'en':'ja']??VIEWS[demo?.view??'shogunzuka'][en?'en':'ja'];
      placeStatus.textContent=arrived
        ? (en ? `Now viewing ${placeName}.` : `${placeName}を表示しています。`)
        : (en ? 'Moving to the selected place.' : '選んだ地点へ移動しています。');
      viewButtons.forEach(b=>b.setAttribute('aria-pressed',String(mode==='city' && b.dataset.view===demo?.view)));
      const activeView = viewButtons.find(b => b.getAttribute('aria-pressed') === 'true');
      moveLens(activeView);
      revealView(activeView);
      cameraHint.textContent = demo?.orbiting && mode==='city'
        ? (en ? 'Drag or swipe to orbit this place.' : 'ドラッグでスポットを中心に360°回れます。スマホは横スワイプ。')
        : (en ? 'Drag or swipe sideways to look around.' : 'ドラッグで360°見回せます。スマホは横スワイプ。');
      if (mode === 'campus') {
        card.hidden = false;
        if (arrived) back.focus({ preventScroll: true });
      } else if (!arrived) card.hidden = true;
      if (arrived && !atPanorama && mode==='city') spotSelect.focus({preventScroll:true});
      if (arrived && atPanorama && !hero.querySelector('.time-control')?.contains(document.activeElement)) viewButtons.find(b=>b.dataset.view===panorama)?.focus({preventScroll:true});
    };

    const coarse = matchMedia('(pointer: coarse)').matches;
    const cores = navigator.hardwareConcurrency || 4;
    const quality = coarse || cores < 6 || window.innerWidth < 900 ? 0.55 : 1;

    let demo: ReturnType<typeof createHero> | null = null;
    const touchControls = createExploreButtons(exploreTouch, movement => demo?.setTouchMove(movement.forward,movement.side,movement.up));
    let stopRefraction: (() => void)[] = [];
    const removeRefraction = () => { stopRefraction.forEach(stop => stop()); stopRefraction = []; };
    window.addEventListener('pagehide', event => { if (!event.persisted) removeRefraction(); });
    const fallback = () => {
      removeRefraction();
      exploreGuide.hidden = true;
      exploreTouch.hidden = true;
      touchControls.reset();
      stage.removeAttribute('aria-describedby');
      hero.classList.remove('is-exploring');
      const look = lookAt((sunPosition(new Date()).altitude * 180) / Math.PI, createLook());
      stage.style.setProperty('--fb', `linear-gradient(${look.zenith.getStyle()}, ${look.mid.getStyle()} 55%, ${look.horizon.getStyle()} 85%, #05070c)`);
      hero.classList.add('is-ready', 'no-3d');
      document.dispatchEvent(new Event('hero:error'));
    };
    let mounted = null;
    try { mounted = mountStage(
      stage,
      (renderer, el) =>
        (demo = createHero(renderer, el, {
          now: () => (sky.live && !sky.transitioning ? new Date() : jstDateAt(new Date(), wrapDay(shown()))),
          cloudTravelMinutes: () => sky.clouds(performance.now()),
          quality,
          lang: en?'en':'ja',
          trips: JSON.parse(stage.dataset.trips ?? '[]'),
          get reducedMotion() { return motion.matches; },
          drift: !coarse,
          onStatus,
          onProgress: progress => document.dispatchEvent(new CustomEvent('hero:progress', {detail:progress})),
          onReady: () => {
            hero.classList.add('is-ready'); spotSelect.disabled=false;exploreToggle.disabled=false;timeSlider.disabled=false;
            viewButtons.forEach(b=>b.disabled=false);
            if (!stopRefraction.length) stopRefraction = [mountGlassRefraction(viewBar), mountGlassRefraction(hero.querySelector<HTMLElement>('.time-thumb')!)];
            document.dispatchEvent(new Event('hero:ready'));
          },
          onError: fallback,
          onAreaLoading: loading=>{areaStatus.hidden=!loading;},
          onExplore: enabled=>{
            hero.classList.toggle('is-exploring',enabled);exploreToggle.setAttribute('aria-pressed',String(enabled));
            exploreToggle.textContent=enabled?(en?'Exit exploration':'散策を終了'):(en?'Explore freely ↗':'自由散策を始める ↗');
            exploreGuide.hidden=!enabled;
            exploreTouch.hidden=!enabled;
            if (!enabled) touchControls.reset();
            if (enabled) stage.setAttribute('aria-describedby','explore-guide'); else stage.removeAttribute('aria-describedby');
            card.hidden=enabled||demo?.mode!=='campus';
          },
          onAction: (id) => demo?.flyTo(spotDestination(id)),
          onMode: setView,
          avoid: () => {
            const base = stage.getBoundingClientRect();
            // the header and the view bar float over the top of the stage: no pin under them either
            return [hero.querySelector('.copy'), hero.querySelector('.copy h1'), hero.querySelector('.sky-chip'), card.hidden ? null : card, document.querySelector('.site-header'), hero.querySelector('.views'), hero.querySelector('.spot-nav'), exploreTouch.hidden ? null : exploreTouch]
              .filter((n): n is Element => !!n)
              .map((n) => {
                const r = n.getBoundingClientRect();
                return { x: r.left - base.left, y: r.top - base.top, w: r.width, h: r.height };
              });
          },
        })),
      { maxDpr: quality < 1 ? 1.5 : 2, alwaysOn: false },
    ); } catch (error) { console.warn('Kyoto scene unavailable', error); }

    const returnToPanorama=()=>demo?.flyTo(panorama);
    hero.querySelector<HTMLSelectElement>('[data-season]')!.addEventListener('change',e=>demo?.setSeason((e.target as HTMLSelectElement).value as Season));
    exploreToggle.addEventListener('click',()=>demo?.setExploring(!demo.exploring));
    back.addEventListener('click', returnToPanorama);
    spotReturn.addEventListener('click', returnToPanorama);
    spotSelect.addEventListener('change',()=>{
      if (SPOTS.some(spot=>spot.id===spotSelect.value)) demo?.flyTo(spotDestination(spotSelect.value as SpotId));
    });
    hero.addEventListener('keydown', (e) => {
      if(e.key==='Escape'&&demo?.exploring){demo.setExploring(false);exploreToggle.focus({preventScroll:true});}
      else if (e.key === 'Escape' && (demo?.mode === 'campus'||demo?.orbiting)) returnToPanorama();
    });

    viewButtons.forEach((b) =>
      b.addEventListener('click', () => {
        if (!demo) return;
        demo.flyTo(b.dataset.view as HeroView);
      }),
    );
    // Like Glisse's tab bar, the selected lens can be dragged as well as clicked.
    let viewDrag: { id: number; x: number; moved: boolean; target: HTMLButtonElement } | null = null;
    let suppressViewClick = false;
    const nearestView = (x: number) => viewButtons.reduce((nearest, button) => {
      const r = button.getBoundingClientRect();
      const distance = Math.abs(x - (r.left + r.width / 2));
      return distance < nearest.distance ? { button, distance } : nearest;
    }, { button: viewButtons[0], distance: Infinity }).button;
    viewOptions.addEventListener('pointerdown', event => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-view]');
      if (!button || button.disabled || event.button !== 0) return;
      viewDrag = { id: event.pointerId, x: event.clientX, moved: false, target: button };
      viewOptions.classList.add('is-held');
    });
    window.addEventListener('pointermove', event => {
      if (!viewDrag || event.pointerId !== viewDrag.id) return;
      if (!viewDrag.moved && Math.abs(event.clientX - viewDrag.x) > 6) {
        viewDrag.moved = true;
        viewOptions.setPointerCapture(event.pointerId);
        viewLens.hidden = false;
        viewOptions.classList.add('is-dragging');
      }
      if (!viewDrag.moved) return;
      const bounds = viewBar.getBoundingClientRect();
      if (event.clientX > bounds.right - 28) viewBar.scrollLeft += 12;
      else if (event.clientX < bounds.left + 28) viewBar.scrollLeft -= 12;
      viewDrag.target = nearestView(event.clientX);
      const width = viewDrag.target.offsetWidth;
      const left = Math.max(0, Math.min(viewOptions.scrollWidth - width, event.clientX - viewOptions.getBoundingClientRect().left - width / 2));
      viewLens.style.width = `${width}px`;
      viewLens.style.transform = `translateX(${left}px)`;
    });
    const finishViewDrag = (event: PointerEvent) => {
      if (!viewDrag || event.pointerId !== viewDrag.id) return;
      const { moved, target } = viewDrag;
      viewDrag = null;
      viewOptions.classList.remove('is-held', 'is-dragging');
      if (moved && event.type === 'pointerup') {
        suppressViewClick = true;
        target.click();
        setTimeout(() => { suppressViewClick = false; }, 0);
      } else if (moved) moveLens(viewButtons.find(b => b.getAttribute('aria-pressed') === 'true'));
    };
    window.addEventListener('pointerup', finishViewDrag);
    window.addEventListener('pointercancel', finishViewDrag);
    window.addEventListener('blur', () => {
      if (!viewDrag) return;
      viewDrag = null;
      viewOptions.classList.remove('is-held', 'is-dragging');
      moveLens(viewButtons.find(b => b.getAttribute('aria-pressed') === 'true'));
    });
    viewOptions.addEventListener('click', event => {
      if (suppressViewClick && event.isTrusted && event.detail !== 0) { event.preventDefault(); event.stopPropagation(); }
    }, true);
    viewOptions.addEventListener('keydown', event => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      const current = viewButtons.indexOf(event.target as HTMLButtonElement);
      if (current < 0) return;
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? viewButtons.length - 1
        : Math.max(0, Math.min(viewButtons.length - 1, current + (event.key === 'ArrowRight' ? 1 : -1)));
      if (viewButtons[next].disabled) return;
      event.preventDefault();
      viewButtons[next].click();
      viewButtons[next].focus({ preventScroll: true });
    });

    if (!mounted) {
      fallback();
    }
  }
</script>

