---
import { HOME_LANGUAGE_SWITCH_HASH } from '../lib/i18n';

interface Props { lang?: 'ja' | 'en'; }
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';

/*
 * Kyoto in one white line: a 1200×200 panorama standing on the ground at y = 196. Each line has
 * its own timing in the opening sequence (from, span). The middle,
 * with Kyoto Tower, the Yasaka pagoda and Daimonji, is what a phone shows. A `hide` shape is filled
 * with the ground colour so the ridge passes behind the landmark drawn over it.
 */
const city = [
  // the ground and the eastern hills, spreading out from the middle
  { d: 'M600 196 H0', from: 0, span: .45 },
  { d: 'M600 196 H1200', from: 0, span: .45 },
  { d: 'M600 112 C570 116 540 120 500 118 C460 116 430 104 390 106 C350 108 300 126 250 124 C200 122 160 98 115 96 C70 94 30 110 0 112', from: .04, span: .5, kind: 'far' },
  { d: 'M600 112 C630 108 660 92 700 86 C730 82 760 100 800 102 C840 104 870 86 905 82 C940 78 980 100 1030 104 C1080 108 1140 96 1200 100', from: .04, span: .5, kind: 'far' },
  // machiya roofs
  { d: 'M408 196 V185 L412 179 H431 L435 185 V181 L439 175 H464 L468 181 V188 L472 182 H484 L488 188 V196', from: .18, span: .35 },
  { d: 'M572 196 V188 L576 182 H590 L594 188 V184 L598 178 H622 L626 184 V196', from: .22, span: .3 },
  { d: 'M684 196 V189 L688 183 H716 L720 189 V185 L724 179 H743 L747 185 V181 L751 175 H776 L780 181 V188 L784 182 H812 L816 188 V196', from: .26, span: .4 },
  { d: 'M0 196 V187 L4 181 H26 L30 187 V183 L34 177 H50 L54 183 V189 L58 183 H86 L90 189 V185 L94 179 H113 L117 185 V181 L121 175 H146 L150 181 V188 L154 182 H168 L172 188 V184 L176 178 H206 L210 184 V187 L214 181 H232 L236 187 V183 L240 177 H262 L266 183 V189 L270 183 H286 L290 189 V185 L294 179 H322 L326 185 V181 L330 175 H348 L352 181 V196', from: .3, span: .45 },
  { d: 'M944 196 V181 L948 175 H973 L977 181 V188 L981 182 H995 L999 188 V184 L1003 178 H1033 L1037 184 V187 L1041 181 H1059 L1063 187 V183 L1067 177 H1089 L1093 183 V189 L1097 183 H1113 L1117 189 V185 L1121 179 H1149 L1153 185 V181 L1157 175 H1176 L1180 181 V188 L1184 182 H1196 L1200 188 V196', from: .34, span: .45 },
  // Kyoto Tower, from its building up to the needle
  { d: 'M523.5 170 L525.5 97 H534.5 L536.5 170 Z', from: .2, span: .45, kind: 'hide' },
  { d: 'M492 196 V170 H568 V196 M497 180 H563 M524 170 L526 97 M536 170 L534 97 M519 97 H541 V87 H519 Z M522 87 Q530 80 538 87 M530 83.5 V50', from: .2, span: .45 },
  // the Yasaka pagoda, tier by tier
  { d: 'M652 92 H658 V116 H652 Z', from: .32, span: .45, kind: 'hide' },
  { d: 'M644 196 V177 M666 196 V177 M630 174 Q655 179 680 174 L666 169 H644 L630 174 M645 169 V162 M665 169 V162 M633 159 Q655 164 677 159 L665 154 H645 L633 159 M646 154 V148 M664 154 V148 M635.5 145 Q655 150 674.5 145 L664 140 H646 L635.5 145 M647 140 V135 M663 140 V135 M638 132 Q655 137 672 132 L663 127 H647 L638 132 M648 127 V123 M662 127 V123 M640 120 Q655 125 670 120 L662 115 H648 L640 120 M655 115 V90 M652 109 H658 M652.4 105 H657.6 M652.8 101 H657.2 M653.2 97 H656.8', from: .32, span: .45 },
  // the Heian Shrine torii and a bridge over the Kamo
  { d: 'M371 196 L372.5 162 M389 196 L387.5 162 M360 157 Q380 162 400 157 M364 162 H396 M366 170 H394 M380 162 V170', from: .45, span: .3 },
  { d: 'M820 192 Q880 182 940 192 M820 186 Q880 176 940 186 M835 189.8 V183.8 M850 188.3 V182.3 M865 187.3 V181.3 M880 187 V181 M895 187.3 V181.3 M910 188.3 V182.3 M925 189.8 V183.8 M860 187.6 V196 M900 187.6 V196', from: .5, span: .3 },
  // 大 on Daimonji, last
  { d: 'M687 99 H701 M694 92 Q693.5 101 686 108 M694 99.5 Q697.5 104.5 702 107', from: .6, span: .2 },
];
---
<dialog class="hero-intro" aria-labelledby="intro-title" data-language-switch-hash={HOME_LANGUAGE_SWITCH_HASH}>
  <div class="intro-head">
    <div class="intro-emblem" role="progressbar" aria-label={en ? 'Preparing the Kyoto scenery' : '京都の景色の準備状況'} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <img src="/brand/mark-512.webp" alt="" width="512" height="512" decoding="async" />
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <!-- the logo's open circle: it starts below its gap and stops short of it -->
        <circle class="intro-track" cx="50" cy="50" r="47" pathLength="100" transform="rotate(-26 50 50)" />
      </svg>
      <!--
        The bright line is two half rings, each turning into view inside its own half of the circle.
        Only transforms move, so the browser's compositor keeps drawing them while the scenery is
        being built on the main thread.
      -->
      <div class="intro-ring" aria-hidden="true">
        <div class="intro-half is-low"><div class="intro-turn"><svg viewBox="0 0 100 100"><path d="M97 50 A47 47 0 0 1 3 50" /></svg></div></div>
        <div class="intro-half is-high"><div class="intro-turn"><svg viewBox="0 0 100 100"><path d="M3 50 A47 47 0 0 1 97 50" /></svg></div></div>
        <div class="intro-turn intro-ring-dot"><span></span></div>
      </div>
    </div>
    <p id="intro-title" class:list={['intro-title', { 'is-latin': en }]} tabindex="-1" autofocus>{en ? 'KUAS Photography Club' : '写真部'}</p>
    <p class="intro-name">{en ? '— Kyoto University of Advanced Science —' : '— KUAS Photography Club —'}</p>
  </div>
  <div class="intro-city" aria-hidden="true">
    <svg viewBox="0 0 1200 200" preserveAspectRatio="xMidYMax slice"><g class="intro-ghost">{city.map((line) => <path class={line.kind} d={line.d} />)}</g></svg>
    <div class="intro-city-drawing"><svg viewBox="0 0 1200 200" preserveAspectRatio="xMidYMax slice">
      {city.map((line) => <path class={line.kind} d={line.d} pathLength={line.kind === 'hide' ? undefined : 1} style={`--from:${line.from};--span:${line.span}`} />)}
    </svg></div>
  </div>
  <div class="intro-foot">
    <p role="status">{en ? 'Preparing Kyoto’s scenery' : '京都の景色を準備しています'}<span class="intro-percent" aria-hidden="true">00%</span></p>
    <button type="button" class="intro-skip">{en ? 'Enter the site now' : '待たずにサイトを見る'} <span aria-hidden="true">↗</span></button>
  </div>
  <span class="intro-iris" aria-hidden="true"></span>
  <span class="intro-flash" aria-hidden="true"></span>
</dialog>
<script is:inline>
  (() => {
    const intro = document.currentScript.previousElementSibling;
    if (!(intro instanceof HTMLDialogElement) || !intro.showModal) return;
    // The dashboard captures the unique deployment hostname in a headless browser. Render a
    // lightweight still there; ordinary visitors and local browser tests keep the live scene.
    const vercelBot = /\b(?:Vercelbot|vercel-screenshot-bot)\b/i.test(navigator.userAgent);
    const deploymentCapture = /\bHeadlessChrome\b/i.test(navigator.userAgent) &&
      /^kuas-photography-club-[a-z0-9]{9}-lingmulongtais-projects\.vercel\.app$/i.test(location.hostname);
    if (vercelBot || deploymentCapture) {
      document.documentElement.classList.add('screenshot-preview');
      return;
    }
    // The deferred language script consumes the fragment after this inline modal decision.
    if (location.hash === intro.dataset.languageSwitchHash) return;
    const root = document.documentElement;
    const progress = intro.querySelector('[role="progressbar"]');
    const percent = intro.querySelector('.intro-percent');
    const iris = intro.querySelector('.intro-iris');
    const flash = intro.querySelector('.intro-flash');
    const turns = [intro.querySelector('.is-low .intro-turn'), intro.querySelector('.is-high .intro-turn'), intro.querySelector('.intro-ring-dot')];
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const MAX_MODAL_MS = 4000;
    const animates = el => !!el && typeof el.animate === 'function';
    const ringOnCompositor = turns.every(animates);
    let finished = false;
    let timeout;
    // Loading arrives in jumps (15% to 60% at once). The picture glides through them along a
    // curve fixed in time, so the ring can be handed to the compositor and keep moving even
    // while the scenery is built on the main thread.
    let target = 0;
    let shown = 0;
    let frame = 0;
    let closing = false;
    let openedAt = 0;
    let closeAt = 0, closeDuration = 0;
    const easeOut = t => 1 - (1 - t) ** 3;
    const smooth = t => t * t * (3 - 2 * t);
    let glide = {from: 0, to: 0, start: 0, duration: 1, ease: easeOut};
    const at = now => {
      const t = Math.min(1, Math.max(0, (now - glide.start) / glide.duration));
      return glide.from + (glide.to - glide.from) * glide.ease(t);
    };
    // The bright line runs about 94% of the way round, the length of the logo's; the dot leads it
    // and settles in the gap.
    const SWEEP = 337.7, LEAD = 3.6, HALF = (180 + LEAD) / SWEEP;
    const pose = p => {
      const sweep = Math.max(0, SWEEP * p - LEAD);
      return [`rotate(${Math.min(sweep, 180) - 180}deg)`, `rotate(${Math.max(0, sweep - 180) - 180}deg)`, `rotate(${342 * p}deg)`];
    };
    const place = p => pose(p).forEach((transform, i) => { if (turns[i]?.style) turns[i].style.transform = transform; });
    let ring = [];
    const glideTo = (to, duration, ease) => {
      const now = performance.now();
      const from = at(now);
      glide = {from, to, start: now, duration, ease};
      if (motion.matches || !ringOnCompositor) return;
      ring.forEach(animation => animation.cancel());
      // The eased path is sampled finely, with an exact stop where the line passes halfway, so the
      // two half rings hand over without a gap.
      const offsets = Array.from({length: 25}, (_, i) => i / 24);
      if (from < HALF && to > HALF) {
        let lo = 0, hi = 1;
        for (let k = 0; k < 24; k++) { const mid = (lo + hi) / 2; if (from + (to - from) * ease(mid) < HALF) lo = mid; else hi = mid; }
        offsets.push(hi);
        offsets.sort((a, b) => a - b);
      }
      const frames = turns.map(() => []);
      for (const offset of offsets) pose(from + (to - from) * ease(offset)).forEach((transform, i) => frames[i].push({transform, offset}));
      ring = turns.map((el, i) => {
        const animation = el.animate(frames[i], {duration, fill: 'both'});
        // Pin the start to the same clock as the count, even if the main thread is busy now.
        try { animation.startTime = now; } catch {}
        return animation;
      });
    };
    const cleanup = () => {
      clearTimeout(timeout);
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      root.classList.remove('hero-intro-open');
      document.removeEventListener('hero:progress', update);
      document.removeEventListener('hero:ready', ready);
      document.removeEventListener('hero:error', fail);
    };
    // Every way out releases the page at once. Unless motion is reduced, the logo's circle then
    // opens like an iris onto Kyoto: a full opening once the wait is over (the scene is ready or
    // the four seconds have run out), a brisk one when the visitor chose to skip.
    const dismiss = (brisk = false) => {
      if (finished) return;
      finished = true;
      cleanup();
      const animate = !motion.matches && animates(iris);
      // measured while the dialog is still laid out
      const box = animate && progress.getBoundingClientRect();
      intro.close();
      // the page can greet the visitor once the intro is out of the way
      const gone = () => document.dispatchEvent(new Event('hero:intro-done'));
      if (!animate) return gone();
      const x = box.left + box.width / 2;
      const y = box.top + box.height / 2;
      const w = innerWidth, h = innerHeight;
      // The hole starts just inside the logo, under the picture, and grows by scaling alone.
      const hole = Math.max(8, box.width / 2 * .86);
      const half = Math.ceil(Math.max(x, w - x, y, h - y)) + 2;
      const reach = Math.hypot(Math.max(x, w - x), Math.max(y, h - y)) + 4;
      const style = iris.style;
      style.left = `${x - half}px`;
      style.top = `${y - half}px`;
      style.width = style.height = `${2 * half}px`;
      style.setProperty('--hole', `${hole}px`);
      intro.classList.add('is-leaving');
      const duration = brisk ? 550 : 900;
      if (animates(flash)) flash.animate([{opacity: 0}, {opacity: .7, offset: .25}, {opacity: 0}], {duration: Math.min(420, duration / 2), easing: 'ease-out'});
      for (const part of ['.intro-head', '.intro-city', '.intro-foot'].map(selector => intro.querySelector(selector))) {
        if (animates(part)) part.animate([{opacity: 1, transform: 'scale(1)'}, {opacity: 0, transform: 'scale(1.05)'}], {duration: duration * .45, easing: 'ease-in', fill: 'forwards'});
      }
      iris.animate([{transform: 'scale(1)'}, {transform: `scale(${reach / hole})`}], {duration, easing: 'cubic-bezier(.55,0,.25,1)', fill: 'forwards'})
        .finished.catch(() => {}).finally(() => { intro.classList.remove('is-leaving'); gone(); });
    };
    const fail = () => dismiss(true);
    const show = () => {
      // The city draws from this; the ring follows the same curve on the compositor.
      intro.style.setProperty('--progress', String(Math.round(shown * 1000) / 1000));
      percent.textContent = `${String(Math.round(shown * 100)).padStart(2, '0')}%`;
      if (motion.matches || !ringOnCompositor) place(shown);
    };
    const tick = (now) => {
      frame = 0;
      if (finished) return;
      if (now >= openedAt + MAX_MODAL_MS) return dismiss();
      shown = motion.matches ? target : Math.min(target, at(now));
      show();
      if (closing && (motion.matches || now >= closeAt + closeDuration)) dismiss();
      else if (closing || shown < target) frame = requestAnimationFrame(tick);
    };
    const follow = () => {
      if (motion.matches) {
        shown = target;
        show();
      } else if (!frame) frame = requestAnimationFrame(tick);
    };
    const update = (event) => {
      const value = Math.min(1, Math.max(0, event.detail));
      if (!Number.isFinite(value) || finished || closing) return;
      if (performance.now() >= openedAt + MAX_MODAL_MS) return dismiss();
      if (value <= target) return;
      target = value;
      progress.setAttribute('aria-valuenow', String(Math.round(target * 100)));
      // slow and soft: about two seconds for the whole circle
      const gap = target - at(performance.now());
      glideTo(target, Math.min(1600, Math.max(450, gap * 2200)), easeOut);
      follow();
    };
    const ready = () => {
      if (finished || closing) return;
      const remaining = openedAt + MAX_MODAL_MS - performance.now();
      if (remaining <= 0) return dismiss();
      target = 1;
      progress.setAttribute('aria-valuenow', '100');
      if (motion.matches) return dismiss();
      // Finish the short opening sequence, even if the scene was ready very quickly.
      closing = true;
      closeAt = performance.now();
      closeDuration = Math.min(remaining, Math.max(650, openedAt + 2600 - closeAt));
      glideTo(1, closeDuration, smooth);
      follow();
    };
    intro.querySelector('button').addEventListener('click', () => dismiss(true));
    intro.addEventListener('cancel', event => { event.preventDefault(); dismiss(true); });
    intro.addEventListener('close', cleanup);
    document.addEventListener('hero:progress', update);
    document.addEventListener('hero:ready', ready);
    document.addEventListener('hero:error', fail);
    try {
      intro.showModal();
      openedAt = performance.now();
      root.classList.add('hero-intro-open');
      // One fixed deadline: progress and readiness never extend the modal's lifetime.
      timeout = setTimeout(() => dismiss(), MAX_MODAL_MS);
    } catch { cleanup(); }
  })();
</script>
<style>
  :global(html.hero-intro-open) { overflow: hidden; }

  /* the logo: a white open circle round the photographer, 写真部 beneath, all on the club's teal */
  .hero-intro {
    --progress: 0;
    --emblem: clamp(132px, min(58vmin, 30vh), 260px);
    --city: clamp(120px, 30vh, 280px);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden auto;
    color: var(--ink);
    background: var(--band);
  }
  .hero-intro[open], .hero-intro.is-leaving { display: grid; grid-template-rows: minmax(min-content, 1fr) auto auto; }
  .hero-intro:not([open]):not(.is-leaving) { display: none; }
  .hero-intro::backdrop { background: var(--band, #64bec6); }
  .hero-intro::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .12; background: radial-gradient(ellipse at 50% 45%, #fff, transparent 60%); }
  /* Leaving, the teal comes from the iris alone: a ring of colour round a hole, only ever scaled. */
  .is-leaving { z-index: 100; pointer-events: none; background: transparent; }
  .is-leaving::before { display: none; }
  .intro-iris { display: none; position: fixed; z-index: -1; border-radius: 50%; pointer-events: none; will-change: transform; background: radial-gradient(circle at center, transparent var(--hole, 0px), var(--band) calc(var(--hole, 0px) + .75px)); }
  .is-leaving .intro-iris { display: block; }
  .is-leaving .intro-head, .is-leaving .intro-city, .is-leaving .intro-foot { will-change: opacity, transform; }

  .intro-head {
    display: grid;
    justify-items: center;
    align-content: center;
    padding: max(24px, env(safe-area-inset-top)) var(--gutter) 12px;
    text-align: center;
    color: #fff;
  }
  .intro-emblem { position: relative; width: var(--emblem); aspect-ratio: 1; }
  /* inside the mark's own circle, which the drawn one replaces */
  .intro-emblem img { position: absolute; inset: 0; width: 100%; height: 100%; clip-path: circle(43.5%); }
  .intro-emblem svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .intro-track { fill: none; stroke: #fff; stroke-opacity: .28; stroke-width: 1; stroke-dasharray: 92.8 200; }
  .intro-city-drawing { contain: layout paint; }
  /* turned so the line starts below the logo's gap */
  .intro-ring { position: absolute; inset: 0; transform: rotate(-26deg); pointer-events: none; }
  .intro-half { position: absolute; inset: 0; }
  .intro-half.is-low { clip-path: inset(50% 0 0 0); }
  .intro-half.is-high { clip-path: inset(0 0 50% 0); }
  .intro-turn { position: absolute; inset: 0; will-change: transform; }
  .intro-half .intro-turn { transform: rotate(-180deg); }
  .intro-turn path { fill: none; stroke: #fff; stroke-width: 1.5; stroke-linecap: round; }
  .intro-ring-dot span { position: absolute; left: 94.7%; top: 47.7%; width: 4.6%; height: 4.6%; border-radius: 50%; background: #fff; }
  .intro-title {
    margin-top: clamp(14px, 2.8vh, 28px);
    font: 400 clamp(30px, 5.6vw, 44px)/1.2 var(--display);
    letter-spacing: .5em;
    text-indent: .5em;
    text-shadow: 0 1px 14px rgb(27 54 61 / .2);
    outline: none;
  }
  :global(:root[data-theme]:not([data-theme="light"])) .intro-title { text-shadow: none; }
  .intro-title.is-latin { font: 600 clamp(24px, 4.4vw, 38px)/1.2 var(--latin); letter-spacing: .06em; text-indent: .06em; text-wrap: balance; }
  .is-latin + .intro-name { letter-spacing: .08em; }
  .intro-name { margin-top: 10px; font: 600 12px/1.6 var(--latin); letter-spacing: .14em; }

  /* at least a sixth of its width tall, so a wide, short screen crops only empty sky */
  .intro-city { position: relative; display: block; width: 100%; height: max(var(--city), 13.5vw); }
  .intro-city > svg, .intro-city-drawing, .intro-city-drawing svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .intro-city path {
    --local: clamp(0, (var(--progress) - var(--from)) / var(--span), 1);
    fill: none;
    stroke: #fff;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: calc(1.02 - 1.02 * var(--local));
  }
  .intro-city .far { stroke-width: .9; stroke-opacity: .7; }
  .intro-city .hide { fill: var(--band); fill-opacity: var(--local); stroke: none; }
  .intro-ghost path { stroke-opacity: .2; stroke-dasharray: none; stroke-dashoffset: 0; }
  .intro-ghost .far { stroke-opacity: .14; }
  .intro-ghost .hide { fill-opacity: 1; }

  .intro-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding: 14px max(var(--gutter), env(safe-area-inset-right)) max(20px, env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
  }
  .intro-foot p { font: 500 13px/1.6 var(--body); letter-spacing: .06em; }
  .intro-percent { margin-left: .8em; font: 500 12px/1 var(--mono); font-variant-numeric: tabular-nums; }
  .intro-skip {
    min-height: 44px;
    padding: 8px 18px;
    border: 1.5px solid color-mix(in srgb, var(--ink) 50%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 700 13px/1.4 var(--body);
    cursor: pointer;
  }
  .intro-skip span { margin-left: 6px; }
  .intro-skip:hover { border-color: var(--ink); background: color-mix(in srgb, var(--ink) 10%, transparent); }
  .intro-skip:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .intro-flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }

  @media (max-height: 650px) {
    .hero-intro { --emblem: clamp(84px, 26vh, 140px); --city: clamp(70px, 20vh, 110px); }
    .intro-title { margin-top: 10px; font-size: clamp(24px, 8vh, 34px); }
    .intro-name { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-intro:is([open], .is-leaving)::before { animation: intro-light 2.6s ease-out both; }
    .hero-intro:is([open], .is-leaving) .intro-emblem { animation: intro-in 1.2s cubic-bezier(.22, .61, .36, 1) both; }
    .hero-intro:is([open], .is-leaving) .intro-title, .hero-intro:is([open], .is-leaving) .intro-name { animation: intro-in 1.1s .15s cubic-bezier(.22, .61, .36, 1) both; }
    .hero-intro:is([open], .is-leaving) .intro-foot { animation: intro-in 1s .2s cubic-bezier(.22, .61, .36, 1) both; }
    .hero-intro:is([open], .is-leaving) .intro-city { animation: intro-city-in 2.6s cubic-bezier(.22, .61, .36, 1) both; transform-origin: 50% 100%; }
    @supports (clip-path: inset(0)) {
      .hero-intro:is([open], .is-leaving) .intro-city-drawing { animation: intro-reveal 2.6s cubic-bezier(.4, 0, .2, 1) both; will-change: clip-path; }
      .hero-intro:is([open], .is-leaving) .intro-city-drawing path:not(.hide) { stroke-dashoffset: 0; }
      .hero-intro:is([open], .is-leaving) .intro-city-drawing .hide { fill-opacity: 1; }
    }
    .intro-ring-dot span { animation: intro-pulse 1.4s ease-in-out infinite alternate; }
  }
  @keyframes intro-in { from { opacity: 0; transform: translateY(10px) scale(.96); } }
  @keyframes intro-light { from { opacity: .03; transform: scale(.9); } to { opacity: .12; transform: scale(1); } }
  @keyframes intro-city-in { from { opacity: .5; transform: translateY(12px) scale(1.02); } to { opacity: 1; transform: translateY(0) scale(1); } }
