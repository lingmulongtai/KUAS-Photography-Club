---
import { nav } from '../data/club';
import { languagePath } from '../lib/i18n';
import ThemePicker from './ThemePicker.astro';

interface Props {
  /** Float over a full-bleed hero instead of sitting on the page background. */
  overlay?: boolean;
  lang?: string;
}
const { overlay = false, lang = 'ja' } = Astro.props;
const en = lang === 'en';
const local = (href: string) => languagePath(href, en ? 'en' : 'ja');
const path = languagePath(Astro.url.pathname, 'ja');
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class:list={['site-header', { overlay }]}>
  <div class="bar">
    <a class="brand" href={local('/')} aria-label={en ? 'KUAS Photography Club home' : '写真部 KUAS Photography Club トップへ'}>
      <img class="mark" src="/brand/mark-192.webp" alt="" width="48" height="48" />
      <span class="brand-text">
        <span class="brand-ja">写真部</span>
        <span class="brand-en">KUAS Photography Club</span>
      </span>
    </a>

    <a class="language-switch" href={languagePath(Astro.url.pathname, en ? 'ja' : 'en')} data-language={en ? 'ja' : 'en'} lang={en ? 'ja' : 'en'} aria-label={en ? '日本語に切り替える' : 'Switch to English'}>{en ? '日本語' : 'English'}</a>

    <ThemePicker lang={lang} />

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={en ? 'Main menu' : 'メインメニュー'}>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      <span class="menu-label">MENU</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={en ? 'Main menu' : 'メインメニュー'}>
      <ul>
        {nav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a href={local(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="en">{en ? item.ja : item.en}</span>
              <span class="ja">{en ? item.en : item.ja}</span>
            </a>
          </li>
        ))}
        <li class="cta-item" style={`--i: ${nav.length}`}>
          <a class="btn btn--primary cta" href={local('/join/')} aria-current={isCurrent('/join/') ? 'page' : undefined}>
            {en ? 'Visit / Join' : '見学・入部'} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
      <span class="indicator" aria-hidden="true"></span>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = header?.querySelector<HTMLButtonElement>('.menu-btn');
  const navEl = header?.querySelector<HTMLElement>('.nav');
  const indicator = header?.querySelector<HTMLElement>('.indicator');
  const links = Array.from(header?.querySelectorAll<HTMLAnchorElement>('.nav a:not(.cta)') ?? []);

  const setOpen = (open: boolean) => {
    if (!header || !btn) return;
    header.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  };
  btn?.addEventListener('click', () => setOpen(!header?.classList.contains('open')));
  const theme=header?.querySelector<HTMLDetailsElement>('.theme-picker');
  theme?.addEventListener('toggle',()=>{if(theme.open)setOpen(false);});
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('open')) {
      setOpen(false);
      btn?.focus();
    }
  });
  header?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // underline that glides to the hovered tab and rests on the current page
  const current = links.find((a) => a.getAttribute('aria-current') === 'page') ?? null;
  const moveTo = (a: HTMLElement | null, instant = false) => {
    if (!indicator || !navEl) return;
    if (!a || getComputedStyle(navEl).position === 'absolute') {
      indicator.style.opacity = '0';
      return;
    }
    const nr = navEl.getBoundingClientRect();
    const r = a.getBoundingClientRect();
    if (instant) indicator.style.transition = 'none';
    indicator.style.opacity = '1';
    indicator.style.width = `${r.width}px`;
    indicator.style.transform = `translateX(${r.left - nr.left}px)`;
    if (instant) requestAnimationFrame(() => (indicator.style.transition = ''));
  };
  links.forEach((a) => {
    a.addEventListener('mouseenter', () => moveTo(a));
    a.addEventListener('focus', () => moveTo(a));
  });
  navEl?.addEventListener('mouseleave', () => moveTo(current));
  const settle = () => moveTo(current, true);
  settle();
  document.fonts?.ready.then(settle);
  window.addEventListener('resize', settle);

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.35s, border-color 0.35s, color 0.35s;
    view-transition-name: site-header;
  }

  .site-header.overlay {
    position: fixed;
    left: 0;
    right: 0;
    color: var(--on-dark);
    background: linear-gradient(rgba(6, 16, 20, 0.62), rgba(6, 16, 20, 0.25) 70%, rgba(6, 16, 20, 0));
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-header.overlay.scrolled {
    color: var(--ink);
    background: var(--header-bg);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .bar {
    max-width: calc(var(--maxw) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .brand:hover {
    color: inherit;
  }

  .mark {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    flex: none;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .brand:hover .mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .brand-text {
    display: grid;
    line-height: 1.2;
  }

  .brand-ja {
    font: 700 19px/1.2 var(--display);
    letter-spacing: 0.32em;
  }

  .brand-en {
    font: 600 11px/1.3 var(--latin);
    letter-spacing: 0.12em;
    opacity: 0.8;
  }

  .nav {
    position: relative;
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.2vw, 30px);
  }

  .nav a:not(.cta) {
    display: grid;
    text-decoration: none;
    line-height: 1.3;
    padding-block: 8px;
    color: inherit;
    transition: opacity 0.2s, transform 0.25s;
  }

  .nav a:not(.cta):hover {
    transform: translateY(-1px);
  }

  .nav .en {
    font: 700 10px/1.3 var(--latin);
    letter-spacing: 0.18em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .overlay:not(.scrolled) .nav .en {
    color: var(--brand);
  }

  .nav .ja {
    font-size: 14px;
    font-weight: 700;
  }

  .indicator {
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 3px;
    width: 0;
    border-radius: 3px;
    background: var(--brand);
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s;
    pointer-events: none;
  }

  .cta {
    padding: 12px 18px;
    font-size: 13px;
  }

  .language-switch { margin-left: auto; padding: 9px 12px; border: 1px solid currentColor; border-radius: 999px; font-size: 13px; font-weight: 700; line-height: 1.2; text-decoration: none; white-space: nowrap; }

  .menu-btn {
    display: none;
    appearance: none;
    background: none;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: 10px 14px;
    gap: 10px;
    align-items: center;
    cursor: pointer;
    color: inherit;
    font: 700 11px/1 var(--latin);
    letter-spacing: 0.16em;
  }

  /* A quiet glass rim on the small controls; the header supplies the existing blur. */
  .language-switch, .menu-btn {
    background: var(--raise);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.02)), color-mix(in srgb, var(--raise) 88%, transparent);
    border-color: var(--line-strong);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.38), 0 2px 8px rgba(0, 0, 0, 0.07);
  }

  .overlay:not(.scrolled):not(.open) .language-switch,
  .overlay:not(.scrolled):not(.open) .menu-btn {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.03)), rgba(8, 17, 26, 0.72);
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 3px 12px rgba(0, 0, 0, 0.18);
  }

  @media (prefers-reduced-transparency: reduce) {
    .language-switch, .menu-btn { background: var(--raise); }
    .overlay:not(.scrolled):not(.open) .language-switch,
    .overlay:not(.scrolled):not(.open) .menu-btn { background: #0c1b25; }
  }

  .menu-icon {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .menu-icon i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s;
  }

  .open .menu-icon i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .open .menu-icon i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 1120px) {
    .bar { gap: 12px; }
    .menu-btn {
      display: inline-flex;
    }

    /* absolute, not fixed: the header's backdrop-filter would trap a fixed child inside the bar */
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-h));
      background: var(--band);
      color: var(--ink);
      padding: 24px var(--gutter) 40px;
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.3s, transform 0.3s, visibility 0s 0.3s;
    }

    .open .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: opacity 0.3s, transform 0.3s;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav li {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.35s, transform 0.35s;
    }

    .open .nav li {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i) * 50ms + 80ms);
    }

    .nav a:not(.cta) {
      padding-block: 18px;
      border-bottom: 1px solid rgba(27, 54, 61, 0.18);
    }

    .nav .en,
    .overlay:not(.scrolled) .nav .en {
      color: var(--ink);
      opacity: 0.7;
    }

    .nav .ja {
      font-size: 24px;
    }

    .indicator {
      display: none;
    }

    .cta-item {
      margin-top: 28px;
    }

    .cta {
      width: 100%;
      padding: 18px;
      font-size: 16px;
      background: var(--ink);
      border-color: var(--ink);
      color: var(--on-ink);
    }

    .open.site-header,
    .open.site-header.overlay {
      background: var(--band);
      color: var(--ink);
      border-bottom-color: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (max-width: 420px) {
    .brand-en {
      display: none;
    }
    .bar { gap: 8px; }
    .brand { gap: 8px; }
    .brand-ja { font-size: 17px; letter-spacing: .16em; white-space: nowrap; }
    .mark { width: 36px; height: 36px; }
    .language-switch { padding: 9px; font-size: 12px; }
    .menu-label { display: none; }
    .menu-btn { padding: 11px; }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
