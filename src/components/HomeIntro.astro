---
/**
 * The home page introduction: what the club is, beside the weekly meeting card. The card's top line
 * shows the next dated meeting or cancellation from the club calendar (scripts/next-meeting.ts).
 */
import { club } from '../data/club';

interface Props { lang?: 'ja' | 'en'; }
const { lang = 'ja' } = Astro.props;
const en = lang === 'en';
const places = club.visitedPlaces.map((p) => (en ? p.en : p.ja));
const time = club.meetings.times[0];
---
<section id="intro" class="section intro">
  <div class="wrap grid">
    <div class="statement">
      <p class="edge">KUAS PHOTOGRAPHY CLUB</p>
      {en
        ? <h2>Let’s go out and shoot.<br />Kyoto, and a little beyond.</h2>
        : <h2>撮りに行こう。<br />京都と、その少し先まで。</h2>}
      <p class="lead">
        {en
          ? 'We are the photography club at Kyoto University of Advanced Science. Members plan photo outings together. Japanese and international students, with a camera or a smartphone, take part together.'
          : `${club.name} は、${club.university}の写真部です。部員で相談しながら撮影会を企画しています。日本人も留学生も、カメラがある人もスマホの人も一緒です。`}
        {places.length > 0 && (en ? ` So far we have photographed ${places.join(', ')}.` : `これまでに${places.join('、')}へ撮りに行きました。`)}
      </p>
      <a class="link-arrow" href={en ? '/en/about/' : '/about/'}>{en ? 'About the club →' : '写真部について →'}</a>
    </div>
    <aside class="meeting" aria-label={en ? 'Weekly meeting' : 'ミーティングの案内'}>
      <!-- the next dated meeting or cancellation from the club calendar; hidden while it has none -->
      <p class="next-status" data-next-meeting="card" data-lang={lang} data-room={club.meetings.room} data-hide-usual hidden>
        <span class="next-dot" aria-hidden="true"></span><span data-next-text></span>
      </p>
      <p class="edge">MEETING ▸ EVERY WEEK</p>
      <p class="when">{en ? club.meetings.dayEn : club.meetings.day}</p>
      <p class="times num"><strong>{en ? time.replace('〜', '') : club.meetings.times.join(' / ')}</strong></p>
      {en
        ? <p class="where">Usually <strong>Uzumasa Campus<br /><span class="room">Room {club.meetings.room}</span></strong></p>
        : <p class="where">通常は <strong>{club.campus}<br /><span class="room">{club.meetings.room} 教室</span></strong></p>}
      <a class="small" href={en ? '/en/schedule/' : '/schedule/'}>{en ? 'Check for cancellations and room changes' : '休会・教室変更などの最新案内を確認'}</a>
      <a class="btn btn--primary" href={en ? '/en/join/' : '/join/'}>{en ? 'Plan a visit' : '見学を申し込む'} <span class="arrow" aria-hidden="true">→</span></a>
    </aside>
  </div>
</section>

<script>import '../scripts/next-meeting';</script>

<style>
  .intro .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px 72px;
    align-items: start;
  }

  .statement {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .statement h2 {
    font-size: var(--step-4);
  }

  .meeting {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
    border-top: 3px solid var(--accent);
  }

  .when {
    font: 700 var(--step-3) / 1.35 var(--display);
    margin-top: 8px;
  }

  .times {
    font-size: 30px;
    color: var(--accent);
    line-height: 1.2;
    margin-bottom: 10px;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 3px;
    text-underline-offset: 7px;
  }

  .where {
    color: var(--muted);
    margin-bottom: 14px;
  }

  .where strong {
    display: block;
    margin-top: 4px;
    color: var(--ink);
    line-height: 1.65;
  }

  .room {
    font-size: var(--step-2);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  /* the next meeting, from the club calendar */
  .next-status {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-self: stretch;
    margin: -6px -6px 12px;
    padding: 9px 12px;
    border-radius: 10px;
    background: var(--raise-2);
    font-weight: 700;
    font-size: 14px;
  }
  .next-status[hidden] { display: none; }
  .next-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  .next-status[data-state='cancelled'] { background: var(--warning-bg); color: var(--ink); }
  .next-status[data-state='cancelled'] .next-dot { background: #d9822b; }

  @media (max-width: 860px) {
    .intro .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
