---
/** A slider that walks a ladder of camera stops (focal lengths, f-numbers, shutter speeds…). */
import { format, type Format } from '../../scripts/lab/ui';
interface Props {
  name: string;
  label: string;
  stops: readonly number[];
  value: number;
  format: Format;
  /** Show the first, middle and last stop under the track. */
  ticks?: boolean;
}
const { name, label, stops, value, format: kind, ticks = true } = Astro.props;
const linear = stops.some((v) => v <= 0);
const gap = (a: number, b: number) => (linear ? Math.abs(a - b) : Math.abs(Math.log(a / b)));
let index = 0;
stops.forEach((v, i) => {
  if (gap(v, value) < gap(stops[index], value)) index = i;
});
const id = `lab-${name}-${Math.random().toString(36).slice(2, 7)}`;
const marks = ticks ? [0, Math.floor((stops.length - 1) / 2), stops.length - 1] : [];
---
<div class="lab-slider" data-ladder={name} data-stops={JSON.stringify(stops)} data-format={kind} style={`--p:${index / Math.max(1, stops.length - 1)}`}>
  <label for={id}>{label}</label>
  <output for={id}>{format(kind, stops[index])}</output>
  <input id={id} type="range" min="0" max={stops.length - 1} step="1" value={index} />
  {ticks && <div class="ticks" aria-hidden="true">{marks.map((i) => <span>{format(kind, stops[i])}</span>)}</div>}
</div>
