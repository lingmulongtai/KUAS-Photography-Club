---
/**
 * The studio prototype, second version: one 3D set where every camera setting, lens,
 * filter, flash and light can be tried, with a floor plan, a coach, shooting tests (お題)
 * and a contact sheet that opens each picture large.
 */
import { BACKDROPS, STUDIO_PLACES, backdropThumb } from '../../scripts/lab/assets';
import { LENSES, FILTERS } from '../../scripts/lab/studio/gear';
import { MISSIONS } from '../../scripts/lab/studio/missions';
import { LIGHT_COLORS } from '../../scripts/lab/studio/lights';

const meterLabels = ['−3', '−2', '−1', '0', '+1', '+2', '+3'];
const subjects: [string, string][] = [
  ['bust', '大理石の胸像'],
  ['mannequin', 'デッサン人形'],
  ['horse', '白磁の馬'],
  ['stilllife', 'ティーセット'],
  ['camera', 'クラシックカメラ'],
  ['chess', 'チェス盤'],
  ['flower', 'コスモス'],
  ['tree', '一本の木'],
];
const placeNames: Record<string, string> = {
  garden: '日本庭園',
  flowers: '花畑',
  autumn: '晩秋の林',
  snow: '雪の森',
  sunset: '海辺の夕焼け',
  night: '夜の街',
  street: '夜の路地',
  neon: 'ネオンのスタジオ',
  lightroom: 'ライティング',
  stars: '星空の高原',
};
const tabs: [string, string][] = [
  ['hold', '撮り方'],
  ['lens', 'レンズ'],
  ['focus', 'ピント'],
  ['filter', 'フィルター'],
  ['flash', 'フラッシュ'],
  ['drive', '連写・合成'],
];
const slider = (ctl: string, label: string) => ({ ctl, label, id: `sl-${ctl}` });
const main = [slider('mm', '焦点距離'), slider('N', '絞り（F値）'), slider('t', 'シャッター'), slider('iso', 'ISO 感度')];
---
<div class="sl" data-studio-lab>
  <div class="sl-top">
    <div class="sl-main">
      <div class="stage lab-stage sl-stage">
        <canvas aria-label="カメラの設定を変えて撮影できる3Dの撮影スタジオ。ドラッグで構図を動かし、タップでピントを合わせます"></canvas>
        <div class="vf">
          <div class="corners"></div>
          <span class="af" data-af style="left:50%;top:50%"></span>
          <div class="top">
            <span class="pill" data-info></span>
            <span class="pill sl-badges" data-badges></span>
          </div>
          <canvas class="lab-hist sl-hist" width="144" height="56" data-hist aria-hidden="true"></canvas>
          <div class="sl-mission-bar" data-mission-bar hidden></div>
          <div class="sl-bottom">
            <span class="sl-chip" data-chip></span>
            <div class="meter sl-meter"><div class="scale"><span class="caret"></span></div><div class="labels">{meterLabels.map((l) => <span>{l}</span>)}</div></div>
          </div>
          <div class="sl-progress" data-progress hidden>
            <p data-progress-text></p>
            <div class="sl-progress-bar"><span data-progress-fill></span></div>
          </div>
          <div class="sl-toast" data-toast hidden></div>
        </div>
        <div class="sl-flash" data-flash-fx></div>
      </div>

      <div class="sl-card sl-deck">
        <div class="sl-sliders">
          {main.map((s) => (
            <div class="sl-slider" data-ctl={s.ctl}>
              <label for={s.id}>{s.label}</label>
              <output for={s.id}></output>
              <input id={s.id} type="range" min="0" max="1" step="1" value="0" />
            </div>
          ))}
        </div>
        <button type="button" class="sl-shutter" data-shutter aria-label="シャッターを切る（撮った写真は下に並びます）"><span></span></button>
      </div>

      <div class="sl-card sl-tabs">
        <div class="sl-tablist" role="tablist" aria-label="カメラの設定">
          {tabs.map(([id, name], i) => (
            <button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={id}>{name}</button>
          ))}
        </div>

        <div class="sl-panel" role="tabpanel" id="panel-hold" aria-labelledby="tab-hold" data-panel="hold">
          <div class="sl-field">
            <h3>カメラの持ち方</h3>
            <div class="sl-seg">
              <button type="button" data-seg="hold" data-value="tripod" aria-pressed="true">三脚</button>
              <button type="button" data-seg="hold" data-value="hand" aria-pressed="false">手持ち</button>
              <button type="button" data-seg="hold" data-value="ibis" aria-pressed="false">手持ち＋手ぶれ補正</button>
            </div>
          </div>
          <div class="sl-field">
            <h3>カメラの高さ</h3>
            <div class="sl-seg">
              <button type="button" data-seg="angle" data-value="low" aria-pressed="false">下から見上げる</button>
              <button type="button" data-seg="angle" data-value="level" aria-pressed="true">目線</button>
              <button type="button" data-seg="angle" data-value="high" aria-pressed="false">上から見下ろす</button>
            </div>
          </div>
          <div class="sl-slider" data-ctl="dist">
            <label for="sl-dist">被写体までの距離</label>
            <output for="sl-dist"></output>
            <input id="sl-dist" type="range" min="0" max="1" step="1" value="0" />
          </div>
          <div class="sl-row">
            <button type="button" class="sl-btn" data-toggle="pinwheel" aria-pressed="false">風車を置く</button>
            <button type="button" class="sl-btn" data-recenter>被写体に向き直す</button>
          </div>
          <p>立ち位置は「真上から見た図」でカメラをドラッグしても変えられます。画面をドラッグすると、その場で向きを変えます。</p>
        </div>

        <div class="sl-panel" role="tabpanel" id="panel-lens" aria-labelledby="tab-lens" data-panel="lens" hidden>
          <div class="sl-lenses">
            {LENSES.map((l) => (
              <button type="button" class="sl-lens" data-seg="lens" data-value={l.id} aria-pressed={l.id === 'std' ? 'true' : 'false'}>
                <span class={`sl-grade g-${l.grade}`}>{l.grade}</span>
                <b>{l.name}</b>
                <span>{l.note}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="sl-panel" role="tabpanel" id="panel-focus" aria-labelledby="tab-focus" data-panel="focus" hidden>
          <div class="sl-row">
            <div class="sl-seg">
              <button type="button" data-seg="fmode" data-value="af" aria-pressed="true">AF（オート）</button>
              <button type="button" data-seg="fmode" data-value="mf" aria-pressed="false">MF（マニュアル）</button>
            </div>
            <button type="button" class="sl-btn" data-toggle="peaking" aria-pressed="false">ピーキング</button>
          </div>
          <div class="sl-slider" data-ctl="mf">
            <label for="sl-mf">ピントリング（MF）</label>
            <output for="sl-mf"></output>
            <input id="sl-mf" type="range" min="0" max="1" step="1" value="0" />
          </div>
          <p data-focus-info></p>
          <p>AF では被写体（目・花の芯・レンズ）に合わせます。画面をタップすると、その場所に合わせます。</p>
        </div>

        <div class="sl-panel" role="tabpanel" id="panel-filter" aria-labelledby="tab-filter" data-panel="filter" hidden>
          <div class="sl-seg">
            {FILTERS.map((f, i) => <button type="button" data-seg="filter" data-value={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.name}</button>)}
          </div>
          <div class="sl-slider" data-ctl="pl" hidden>
            <label for="sl-pl">C-PL の回転</label>
            <output for="sl-pl"></output>
            <input id="sl-pl" type="range" min="0" max="1" step="1" value="0" />
          </div>
          <p data-filter-note>レンズの前に付けるフィルター。ND は光を減らし、C-PL は反射を取って空を濃くし、ソフト・ミスト・クロスは光のにじみ方を変えます。</p>
        </div>

        <div class="sl-panel" role="tabpanel" id="panel-flash" aria-labelledby="tab-flash" data-panel="flash" hidden>
          <div class="sl-row">
            <div class="sl-seg">
              <button type="button" data-seg="flash" data-value="off" aria-pressed="true">オフ</button>
              <button type="button" data-seg="flash" data-value="ttl" aria-pressed="false">TTL（自動調光）</button>
              <button type="button" data-seg="flash" data-value="manual" aria-pressed="false">マニュアル</button>
            </div>
            <div class="sl-seg">
              <button type="button" data-seg="curtain" data-value="front" aria-pressed="true">先幕</button>
              <button type="button" data-seg="curtain" data-value="rear" aria-pressed="false">後幕</button>
            </div>
          </div>
          <div class="sl-two">
            <div class="sl-slider" data-ctl="fp">
              <label for="sl-fp">発光量（マニュアル）</label>
              <output for="sl-fp"></output>
              <input id="sl-fp" type="range" min="0" max="1" step="1" value="0" />
            </div>
            <div class="sl-slider" data-ctl="fec">
              <label for="sl-fec">調光補正（TTL）</label>
              <output for="sl-fec"></output>
              <input id="sl-fec" type="range" min="0" max="1" step="1" value="0" />
            </div>
          </div>
          <p data-flash-info>カメラの上のフラッシュ（ガイドナンバー 36）。TTL はカメラが試し光りして明るさを決め、マニュアルは自分で発光量を決めます。置きライトは「真上から見た図」の「＋ライト」で。</p>
        </div>

        <div class="sl-panel" role="tabpanel" id="panel-drive" aria-labelledby="tab-drive" data-panel="drive" hidden>
          <div class="sl-row">
            <div class="sl-seg">
              <button type="button" data-seg="drive" data-value="single" aria-pressed="true">1枚ずつ</button>
              <button type="button" data-seg="drive" data-value="interval" aria-pressed="false">インターバル撮影</button>
            </div>
            <div class="sl-seg">
              <button type="button" data-seg="blend" data-value="lighten" aria-pressed="true">比較明合成</button>
              <button type="button" data-seg="blend" data-value="average" aria-pressed="false">加算平均</button>
            </div>
          </div>
          <div class="sl-slider" data-ctl="frames">
            <label for="sl-frames">枚数</label>
            <output for="sl-frames"></output>
            <input id="sl-frames" type="range" min="0" max="1" step="1" value="0" />
          </div>
          <p data-drive-info></p>
        </div>
      </div>
    </div>

    <aside class="sl-side" aria-label="アドバイスと真上から見た図">
      <div class="sl-card">
        <h3 class="sl-title"><span>ADVICE</span>アドバイス</h3>
        <ul class="sl-advice" data-advice aria-live="polite"></ul>
      </div>
      <div class="sl-card">
        <div class="sl-map-head">
          <h3 class="sl-title"><span>TOP VIEW</span>真上から見た図</h3>
          <button type="button" class="sl-btn sl-btn-sm" data-add-light>＋ライト</button>
        </div>
        <canvas class="sl-map" data-map aria-label="被写体・カメラ・ライトを真上から見た図。カメラとライトはドラッグで動かせます"></canvas>
        <div class="sl-light" data-light-panel hidden>
          <div class="sl-row">
            <div class="sl-seg">
              <button type="button" data-seg="lkind" data-value="soft" aria-pressed="true">ソフトボックス</button>
              <button type="button" data-seg="lkind" data-value="spot" aria-pressed="false">スポット</button>
            </div>
            <button type="button" class="sl-btn sl-btn-sm" data-remove-light>削除</button>
          </div>
          <div class="sl-seg">
            {Object.entries(LIGHT_COLORS).map(([id, [, name]], i) => <button type="button" data-seg="lcolor" data-value={id} aria-pressed={i === 0 ? 'true' : 'false'}>{name}</button>)}
          </div>
          <div class="sl-slider" data-ctl="level">
            <label for="sl-level">明るさ（1m で）</label>
            <output for="sl-level"></output>
            <input id="sl-level" type="range" min="0" max="1" step="1" value="0" />
          </div>
        </div>
      </div>
    </aside>
  </div>

  <section class="sl-section sl-pick" aria-labelledby="sl-h-place">
    <div>
      <div class="sl-head">
        <p class="edge">PLACES</p>
        <h2 id="sl-h-place">撮る場所</h2>
      </div>
      <div class="sl-places">
        {STUDIO_PLACES.map((id, i) => (
          <button type="button" data-seg="place" data-value={id} aria-pressed={i === 0 ? 'true' : 'false'} title={BACKDROPS[id].name}>
            <img src={backdropThumb(id)} alt="" loading="lazy" width="160" height="80" />
            <span>{placeNames[id]}</span>
          </button>
        ))}
      </div>
    </div>
    <div>
      <div class="sl-head">
        <p class="edge">SUBJECTS</p>
        <h2>撮るもの</h2>
      </div>
      <div class="sl-seg sl-subjects">
        {subjects.map(([id, name], i) => <button type="button" data-seg="subject" data-value={id} aria-pressed={i === 0 ? 'true' : 'false'}>{name}</button>)}
      </div>
    </div>
  </section>

  <section class="sl-section" aria-labelledby="sl-h-mission">
    <div class="sl-head">
      <p class="edge">CHALLENGES</p>
      <h2 id="sl-h-mission">お題に挑戦</h2>
      <p>わざと「惜しい」設定から始まります。条件を満たして撮れたらクリア。</p>
    </div>
    <ol class="sl-mission-list">
      {MISSIONS.map((m) => (
        <li data-mission={m.id}>
          <button type="button" data-start-mission={m.id}>
            <span class="sl-mplace">{m.place}</span>
            <b>{m.title}</b>
            <span class="sl-mgoal">{m.goal}</span>
            <span class="sl-mstate" data-mstate></span>
          </button>
        </li>
      ))}
    </ol>
  </section>

  <section class="sl-section" aria-labelledby="sl-h-photos">
    <div class="sl-head">
      <p class="edge">CONTACT SHEET</p>
      <h2 id="sl-h-photos">撮った写真</h2>
      <p>クリックで大きく表示します。</p>
    </div>
    <div class="sl-sheet" data-sheet><p class="empty">シャッターボタンを押すと、ここに並びます。</p></div>
  </section>

  <dialog class="sl-lightbox" data-lightbox aria-label="撮った写真">
    <figure>
      <img data-lb-img alt="" />
      <figcaption>
        <b data-lb-title></b>
        <span data-lb-detail></span>
      </figcaption>
    </figure>
    <div class="sl-lb-nav">
      <button type="button" class="sl-btn" data-lb-prev aria-label="前の写真">←</button>
      <button type="button" class="sl-btn" data-lb-next aria-label="次の写真">→</button>
      <a class="sl-btn sl-btn-primary" data-lb-save download="kuas-studio.jpg">保存</a>
      <button type="button" class="sl-btn" data-lb-close>閉じる</button>
    </div>
  </dialog>
</div>

<style>
  /* Matches the rest of the site: cards on the page ground, teal accents, pill buttons.
     Only the picture itself stays dark, like every other demo stage. */
  .sl {
    display: grid;
    gap: 0;
  }

  .sl-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 16px;
    align-items: start;
    padding-bottom: clamp(40px, 6vw, 64px);
  }

  .sl-main {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  /* follows the camera while you scroll the controls, but only within the studio itself */
  .sl-side {
    position: sticky;
    top: calc(var(--header-h) + 16px);
    max-height: calc(100vh - var(--header-h) - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    display: grid;
    gap: 16px;
  }

  .sl-card {
    display: grid;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
    color: var(--ink);
    font: 500 14px/1.6 var(--body);
  }

  .sl-card p {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.75;
    color: var(--muted);
  }

  .sl-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin: 0;
    font: 700 13px/1.4 var(--body);
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .sl-title span {
    font: 700 11px/1.4 var(--latin);
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  .sl-field {
    display: grid;
    gap: 8px;
  }

  .sl-field h3 {
    margin: 0;
    font: 700 13px/1.4 var(--body);
    color: var(--muted);
  }

  .sl-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
  }

  .sl-two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px 20px;
  }

  /* ---------- sliders ---------- */

  .sl-slider {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 10px;
    align-items: baseline;
    min-width: 0;
  }

  .sl-slider[hidden],
  .sl-panel[hidden],
  .sl-light[hidden] {
    display: none;
  }

  .sl-slider label {
    font: 700 13px/1.4 var(--body);
    color: var(--muted);
  }

  .sl-slider output {
    font: 700 17px/1.2 var(--latin);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .sl-slider input {
    grid-column: 1 / -1;
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 28px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .sl-slider input:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .sl-slider input::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent) calc(var(--p, 0) * 100%), var(--line) 0);
  }

  .sl-slider input::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent) calc(var(--p, 0) * 100%), var(--line) 0);
  }

  .sl-slider input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--raise);
    border: 2px solid var(--accent);
    box-shadow: var(--shadow);
  }

  .sl-slider input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--raise);
    border: 2px solid var(--accent);
  }

  .sl-slider input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---------- buttons: the site's pill chips ---------- */

  .sl-seg {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sl-seg button,
  .sl-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--raise);
    color: var(--ink);
    font: 700 13px/1.2 var(--body);
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .sl-seg button:hover,
  .sl-btn:hover {
    border-color: var(--ink);
  }

  .sl-seg button[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }

  .sl-btn {
    border: 1.5px solid var(--ink);
    background: transparent;
  }

  .sl-btn:hover {
    background: var(--ink);
    color: var(--on-ink);
  }

  .sl-btn[aria-pressed="true"],
  .sl-btn-primary {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-accent);
  }

  .sl-btn-primary:hover {
    background: var(--brand-ink);
    border-color: var(--brand-ink);
    color: var(--on-dark);
  }

  .sl-btn-sm {
    padding: 7px 12px;
    font-size: 12px;
  }

  .sl-seg button:focus-visible,
  .sl-btn:focus-visible,
  .sl-tablist button:focus-visible,
  .sl-lens:focus-visible,
  .sl-places button:focus-visible,
  .sl-mission-list button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---------- the picture ---------- */

  .sl-stage {
    cursor: crosshair;
  }

  .sl-stage .pill {
    border-radius: 2px;
    background: var(--hud-bg);
    color: var(--hud);
  }

  .sl-badges {
    color: var(--brand);
  }

  .sl-hist {
    position: absolute;
    right: 14px;
    top: 48px;
    width: 144px;
    height: 56px;
  }

  .sl-bottom {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 8px;
    width: min(340px, 78%);
  }

  .sl-meter {
    width: 100%;
    padding: 12px 14px 8px;
    border-radius: var(--radius-sm);
    background: var(--hud-bg);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .sl-chip {
    max-width: 100%;
    padding: 6px 12px;
    border-radius: 999px;
    font: 700 12px/1.35 var(--body);
    letter-spacing: 0;
    text-align: center;
    color: var(--hud);
    background: rgba(8, 12, 14, 0.72);
    border: 1px solid var(--hud-line);
  }

  .sl-chip:empty {
    display: none;
  }

  .sl-chip[data-level="bad"] {
    border-color: #ff8a7a;
    color: #ffc9c1;
  }

  .sl-chip[data-level="warn"] {
    border-color: #f0c46b;
