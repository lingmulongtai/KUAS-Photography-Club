---
/** One design proposal: its code for picking (焦点 B…), the idea, the live mock-up and a short review. */
interface Props {
  id: string;
  code: string;
  title: string;
  concept: string;
  good: string[];
  care: string[];
}
const { id, code, title, concept, good, care } = Astro.props;
---
<section class="proposal" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="proposal-head">
      <span class="proposal-code">{code}</span>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="proposal-concept">{concept}</p>
    </header>
    <div class="proposal-body" data-proposal={id}>
      <slot />
    </div>
    <div class="proposal-notes">
      <div>
        <h3>ここが良い</h3>
        <ul>{good.map((g) => <li>{g}</li>)}</ul>
      </div>
      <div>
        <h3>気になるところ</h3>
        <ul>{care.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </div>
</section>
