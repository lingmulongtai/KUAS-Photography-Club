---
/** The "one studio" prototype: one scene, one camera with every setting, and a shutter button. */
import LabSlider from './LabSlider.astro';
import { APERTURE_STOPS, FOCAL_LADDER, ISO_LADDER, SHUTTER_STOPS } from '../../scripts/lab/optics';
import { BACKDROP_ORDER, BACKDROPS, backdropThumb } from '../../scripts/lab/assets';
interface Props {
  torii?: boolean;
}
const { torii = false } = Astro.props;
const meterLabels = ['−3', '−2', '−1', '0', '+1', '+2', '+3'];
const subjects = [['bust', '胸像'], ['mannequin', 'デッサン人形'], ['horse', '白磁の馬'], ['stilllife', '静物'], ['camera', 'カメラ']];
---
<div class="studio" data-studio data-torii={String(torii)}>
  <div class="studio-main">
    <div class="stage lab-stage" data-demo="studio">
      <canvas aria-label="カメラの設定を変えて撮影できる3Dの撮影スタジオ"></canvas>
      <div class="vf">
        <div class="corners"></div>
        <span class="af" style="left:50%;top:50%"></span>
        <div class="top"><span class="pill" data-info></span><span class="pill" data-verdict></span></div>
        <canvas class="lab-hist studio-hist" width="144" height="56" data-hist aria-hidden="true"></canvas>
        <div class="studio-meter"><div class="meter"><div class="scale"><span class="caret"></span></div><div class="labels">{meterLabels.map((l) => <span>{l}</span>)}</div></div></div>
      </div>
      <div class="flash" data-flash></div>
    </div>
    <div class="cam deck">
      <div class="deck-sliders">
        <LabSlider name="mm" label="焦点距離" stops={FOCAL_LADDER} value={50} format="mm" />
        <LabSlider name="N" label="絞り（F値）" stops={APERTURE_STOPS} value={4} format="f" />
        <LabSlider name="t" label="シャッタースピード" stops={SHUTTER_STOPS} value={1 / 500} format="ss" />
        <LabSlider name="iso" label="ISO 感度" stops={ISO_LADDER} value={100} format="iso" />
      </div>
      <button type="button" class="shutter" data-shutter aria-label="シャッターを切る（撮った写真は下に並びます）"><span></span></button>
    </div>
  </div>
  <aside class="studio-side">
    <div class="cam">
      <h3>撮る場所</h3>
      <div class="thumbs">
        {BACKDROP_ORDER.map((id, i) => (
          <button type="button" data-seg="bg" data-value={id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <img src={backdropThumb(id)} alt="" loading="lazy" width="160" height="80" />
            <span>{BACKDROPS[id].name.replace(/（.*）/, '')}</span>
          </button>
        ))}
      </div>
      <h3>撮るもの</h3>
      <div class="seg">
        {subjects.map(([id, name], i) => <button type="button" data-seg="subject" data-value={id} aria-pressed={i === 0 ? 'true' : 'false'}>{name}</button>)}
      </div>
      <div class="seg">
        <button type="button" data-seg="hold" data-value="hand" aria-pressed="true">手持ち</button>
        <button type="button" data-seg="hold" data-value="tripod" aria-pressed="false">三脚</button>
      </div>
      <h3>いまの写り</h3>
      <ul class="tips" data-tips></ul>
      <p>画面をドラッグで見回し、タップでそこにピント。</p>
    </div>
  </aside>
  <div class="contact">
    <h3>撮った写真</h3>
    <div class="sheet" data-sheet><p class="empty">シャッターボタンを押すと、ここに並びます。</p></div>
  </div>
</div>

<style>
  .studio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 14px;
  }

  .studio-main {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .studio .lab-stage {
    cursor: crosshair;
  }

  .studio-hist {
    position: absolute;
    right: 14px;
    top: 48px;
    width: 144px;
    height: 56px;
  }

  .studio-meter {
    position: absolute;
    left: 50%;
    bottom: 12px;
    width: min(300px, 70%);
    transform: translateX(-50%);
    padding: 12px 14px 8px;
    border-radius: 6px;
    background: rgba(10, 12, 14, 0.55);
  }

  .flash {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .flash:global(.on) {
    animation: flash 0.35s ease-out;
  }

  @keyframes flash {
    0% {
      opacity: 0.85;
    }

    100% {
      opacity: 0;
    }
  }

  .deck {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .deck-sliders {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 10px 18px;
  }

  .shutter {
    width: 74px;
    height: 74px;
    border-radius: 50%;
    border: 3px solid #4a5058;
    background: radial-gradient(circle at 35% 30%, #5a6068, #24282d);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.45);
  }

  .shutter span {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f3f0ea, #b9b3aa);
    transition: transform 0.08s;
  }

  .shutter:active span {
    transform: scale(0.9);
  }

  .shutter:focus-visible {
    outline: 3px solid var(--cam-accent);
    outline-offset: 3px;
  }

  .studio-side .cam {
    align-content: start;
  }

  .thumbs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .thumbs button {
    position: relative;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    aspect-ratio: 2 / 1;
  }

  .thumbs button[aria-pressed="true"] {
    border-color: var(--cam-accent);
  }

  .thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumbs span {
    position: absolute;
    left: 4px;
    bottom: 4px;
    font: 500 10px/1.2 var(--body);
    color: #fff;
    padding: 2px 5px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.55);
  }

  .tips {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--cam-ink);
  }

  .contact {
    grid-column: 1 / -1;
    display: grid;
    gap: 8px;
  }

  .contact h3 {
    font: 700 14px/1.5 var(--body);
    color: var(--accent);
  }

  .sheet {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }

  .sheet .empty {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .sheet :global(figure) {
    margin: 0;
    display: grid;
    gap: 4px;
    padding: 6px;
    background: var(--rebate);
    border-radius: 4px;
  }

  .sheet :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .sheet :global(figcaption) {
    font: 500 10px/1.3 var(--mono);
    color: #d8d2c8;
  }

  .sheet :global(figure ~ .empty),
  .sheet:has(figure) .empty {
    display: none;
  }

  @media (max-width: 1000px) {
    .studio {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .deck {
      grid-template-columns: 1fr;
    }

    .shutter {
      justify-self: center;
    }

    .studio-hist {
      display: none;
    }

    .studio-meter {
      width: 78%;
      padding: 8px 10px 6px;
      bottom: 8px;
    }
  }
</style>

<script>
  import '../../scripts/lab/proposals/studio';
</script>
