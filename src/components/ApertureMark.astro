---
/** Six-blade aperture mark used as the club logo. Inherits color from text. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.6" />
  <path
    d="M16.06 13.09L7.99 21.16M13.09 16.06L2.06 13.10M9.03 14.97L6.08 3.94M7.94 10.91L16.01 2.84M10.91 7.94L21.94 10.90M14.97 9.03L17.92 20.06"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
  />
</svg>
