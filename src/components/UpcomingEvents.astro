---
/** The homepage uses the live club calendar; historical notices stay on the schedule page. */
import CalendarFeed from './CalendarFeed.astro';

interface Props {
  count?: number;
  lang?: 'ja' | 'en';
}
const { count = 4, lang = 'ja' } = Astro.props;
---
<CalendarFeed lang={lang} compact count={count} />
