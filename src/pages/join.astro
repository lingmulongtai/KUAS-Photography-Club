---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FormLink from '../components/FormLink.astro';
import { club, forms } from '../data/club';

const faq = [
  { q: 'カメラを持っていなくても大丈夫？', a: '大丈夫です。スマートフォンで参加できます。共有機材は整備中です。写真部では、カメラを持っていない人も使える共有カメラの購入を目指しています。' },
  { q: '留学生でも参加できますか？ / Can international students join?', a: 'もちろんです。日本人と留学生が一緒に活動しています。English is welcome at meetings and on trips.' },
  { q: '途中の学期からでも入れますか？', a: '見学を希望する時期を運営にご相談ください。正式な入部に必要な手続きは、運営からご案内します。' },
  { q: '毎回参加しないといけませんか？', a: '撮影会は来られるときだけで大丈夫です。参加・途中参加・途中退出やキャンセルについては、事前に運営と調整してください。' },
  { q: '費用はかかりますか？', a: `部費は半期${club.feePerSemester.toLocaleString('ja-JP')}円です。撮影会の交通費や入場料等は別途各自負担です。` },
];
---
<Base title="見学・入部" description="KUAS Photography Club への見学・入部の申し込み。通常は毎週金曜18:00から太秦キャンパス S306。休会・教室変更は最新案内をご確認ください。">
  <PageHero
    edge="JOIN ▸ EVERY FRIDAY ▸ ROOM S306"
    title="見学・入部"
    lead="経験もカメラもいりません。まずは金曜日のミーティングをのぞきに来てください。見学前に最新の予定を確認し、フォームまたは問い合わせ窓口からご連絡ください。"
  />

  <section class="wrap facts" aria-label="ミーティングの案内">
    <div class="fact">
      <p class="edge">WHEN</p>
      <p class="big">{club.meetings.day}</p>
      <p class="num amber">{club.meetings.times.join(' / ')}</p>
      <p class="small muted"><a href="/schedule/">休会・変更を確認してからお越しください</a></p>
    </div>
    <div class="fact">
      <p class="edge">WHERE</p>
      <p class="big">通常は{club.campus}</p>
      <p class="num amber">{club.meetings.room} 教室</p>
      <p class="small muted">{club.university}</p>
    </div>
    <div class="fact">
      <p class="edge">BRING</p>
      <p class="big">スマホでOK</p>
      <p class="num amber">NO CAMERA NEEDED</p>
      <p class="small muted">カメラがある人は持ってきてください</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <div class="form-col">
        <div class="section-head">
          <p class="edge">APPLY</p>
          <h2>見学・入部の申し込み</h2>
          <p class="muted">
            見学希望・参加についての連絡は、Microsoft Forms または Instagram の DM・メールからお願いします。申込みは正式な入部手続きとは別です。
          </p>
        </div>
        <FormLink href={forms.join} label="申し込みフォームを開く" />
        <ul class="form-notes small">
          <li>フォームではサインインを求められます。回答できない場合は、Instagram の DM かメールでご相談ください。</li>
          <li>連絡いただく情報は、見学・参加に関する案内とお問い合わせへの対応のために使用します。</li>
          <li>わからないことは Instagram の DM かメールで気軽に聞いてください。</li>
        </ul>
      </div>

      <aside class="side">
        <div class="steps">
          <p class="edge">FLOW</p>
          <h2>入部までの流れ</h2>
          <ol>
            <li><b>申し込む</b><span>フォームか Instagram の DM で、見学したい日を教えてください。</span></li>
            <li><b>ミーティングを見学</b><span>金曜のミーティングで、運営が活動の説明をします。</span></li>
            <li><b>撮影会に参加</b><span>気になる撮影会に、まずは1回参加してみてください。</span></li>
            <li><b>正式な入部手続き</b><span>必要な手続きは運営からご案内します。LINE等の連絡用チャットへの参加だけでは、正式な入部手続きは完了しません。活動登録や保険の手続き・適用条件も運営にご確認ください。</span></li>
          </ol>
        </div>
        <div class="contact">
          <p class="edge">FOR OTHERS</p>
          <p class="small">撮影のご依頼・協賛・取材など、学外の方からのご連絡は専用の窓口へ。</p>
          <a class="link-arrow" href="/contact/">お問い合わせページへ →</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section"><div class="wrap prose"><h2>参加対象について</h2><p>京都先端科学大学の在学生・留学生の見学を受け付けています。教職員、学外の方、卒業生等の参加・正式入部の可否は、<a href="/contact/">運営にお問い合わせください</a>。</p><p>部費は半期{club.feePerSemester.toLocaleString('ja-JP')}円。撮影会の交通費・入場料等は別途各自負担です。</p></div></section>

  <section class="section" aria-labelledby="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="edge">FAQ</p>
        <h2 id="faq">よくある質問</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .fact {
    display: grid;
    gap: 4px;
    padding: 22px;
    background: var(--raise);
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .big {
    font: 700 var(--step-3) / 1.35 var(--display);
    margin-top: 6px;
  }

  .amber {
    color: var(--accent);
    font-size: 15px;
    letter-spacing: 0.06em;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 48px 72px;
    align-items: start;
  }

  .form-col {
    display: grid;
    gap: 28px;
  }

  .form-notes {
    margin: -8px 0 0;
    padding-left: 1.2em;
    display: grid;
    gap: 4px;
    color: var(--muted);
  }

  .side {
    display: grid;
    gap: 40px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .steps {
    display: grid;
    gap: 14px;
  }

  .steps h2 {
    font-size: var(--step-3);
  }

  .steps ol {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.4em 1fr;
    column-gap: 10px;
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    grid-row: span 2;
    font: 700 14px/1.9 var(--latin);
    color: var(--accent);
  }

  .steps span {
    font-size: 14px;
    color: var(--muted);
  }

  .contact {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .faq {
    display: grid;
    max-width: 52em;
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
    padding-block: 16px;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-family: var(--mono);
    color: var(--accent);
  }

  details[open] summary::after {
    content: '−';
  }

  details p {
    margin-top: 10px;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .facts,
    .cols {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
    }
  }
</style>
