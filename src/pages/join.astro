---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FormLink from '../components/FormLink.astro';
import SlotNote from '../components/SlotNote.astro';
import { club, forms } from '../data/club';

const faq = [
  { q: 'カメラを持っていなくても大丈夫？', a: '大丈夫です。メンバーの多くはスマホで撮っています。写真部では、カメラを持っていない人も使える共有カメラの購入を目指しています。' },
  { q: '留学生でも参加できますか？ / Can international students join?', a: 'もちろんです。日本人と留学生が一緒に活動しています。English is welcome at meetings and on trips.' },
  { q: '途中の学期からでも入れますか？', a: 'いつからでも入れます。まずは金曜のミーティングか、次の撮影会をのぞいてみてください。' },
  { q: '毎回参加しないといけませんか？', a: '撮影会は来られるときだけで大丈夫です。参加するときは事前に連絡してもらい、キャンセルは前日21時までにお願いしています（ガイドライン第3章）。' },
  { q: '費用はかかりますか？', a: '撮影会の交通費や入場料は各自負担です。部費については運営にお問い合わせください。', slot: true },
];
---
<Base title="見学・入部" description="KUAS Photography Club への見学・入部の申し込み。毎週金曜のミーティング（太秦キャンパス S306）に気軽に来てください。">
  <PageHero
    edge="JOIN ▸ EVERY FRIDAY ▸ ROOM S306"
    title="見学・入部"
    lead="経験もカメラもいりません。まずは金曜日のミーティングをのぞきに来てください。フォームから申し込んでもらえれば、運営が当日案内します。"
  />

  <section class="wrap facts" aria-label="ミーティングの案内">
    <div class="fact">
      <p class="edge">WHEN</p>
      <p class="big">{club.meetings.day}</p>
      <p class="num amber">{club.meetings.times.join(' / ')}</p>
      <p class="small muted">授業のあと、そのまま来てください</p>
    </div>
    <div class="fact">
      <p class="edge">WHERE</p>
      <p class="big">{club.campus}</p>
      <p class="num amber">{club.meetings.room} 教室</p>
      <p class="small muted">{club.university}</p>
    </div>
    <div class="fact">
      <p class="edge">BRING</p>
      <p class="big">スマホでOK</p>
      <p class="num amber">NO CAMERA NEEDED</p>
      <p class="small muted">カメラがある人は持ってきてください</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <div class="form-col">
        <div class="section-head">
          <p class="edge">APPLY</p>
          <h2>見学・入部の申し込み</h2>
          <p class="muted">
            申し込みは写真部のフォーム（Microsoft Forms）で受け付けています。名前と連絡先、見学したい日を書いて送ってください。運営から連絡します。
          </p>
        </div>
        <FormLink href={forms.join} label="申し込みフォームを開く" />
        <ul class="form-notes small">
          <li>京都先端科学大学の Microsoft アカウントでサインインして回答します（学内の人だけが開けます）。</li>
          <li>フォームはいまは英語のみです。日本語版も準備しています。</li>
          <li>わからないことは Instagram の DM かメールで気軽に聞いてください。</li>
        </ul>
      </div>

      <aside class="side">
        <div class="steps">
          <p class="edge">FLOW</p>
          <h2>入部までの流れ</h2>
          <ol>
            <li><b>申し込む</b><span>フォームか Instagram の DM で、見学したい日を教えてください。</span></li>
            <li><b>ミーティングを見学</b><span>金曜のミーティングで、運営が活動の説明をします。</span></li>
            <li><b>撮影会に参加</b><span>気になる撮影会に、まずは1回参加してみてください。</span></li>
            <li><b>入部</b><span>連絡用のチャットに参加して、メンバーになります。<SlotNote note="実際の手続きに合わせて書き換えてください" /></span></li>
          </ol>
        </div>
        <div class="contact">
          <p class="edge">FOR OTHERS</p>
          <p class="small">撮影のご依頼・協賛・取材など、学外の方からのご連絡は専用の窓口へ。</p>
          <a class="link-arrow" href="/contact/">お問い合わせページへ →</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="edge">FAQ</p>
        <h2 id="faq">よくある質問</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a} {f.slot && <SlotNote note="部費を決めたら書き換えてください" />}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .fact {
    display: grid;
    gap: 4px;
    padding: 22px;
    background: var(--raise);
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .big {
    font: 700 var(--step-3) / 1.35 var(--display);
    margin-top: 6px;
  }

  .amber {
    color: var(--accent);
    font-size: 15px;
    letter-spacing: 0.06em;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 48px 72px;
    align-items: start;
  }

  .form-col {
    display: grid;
    gap: 28px;
  }

  .form-notes {
    margin: -8px 0 0;
    padding-left: 1.2em;
    display: grid;
    gap: 4px;
    color: var(--muted);
  }

  .side {
    display: grid;
    gap: 40px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .steps {
    display: grid;
    gap: 14px;
  }

  .steps h2 {
    font-size: var(--step-3);
  }

  .steps ol {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.4em 1fr;
    column-gap: 10px;
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    grid-row: span 2;
    font: 700 14px/1.9 var(--latin);
    color: var(--accent);
  }

  .steps span {
    font-size: 14px;
    color: var(--muted);
  }

  .contact {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .faq {
    display: grid;
    max-width: 52em;
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
    padding-block: 16px;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-family: var(--mono);
    color: var(--accent);
  }

  details[open] summary::after {
    content: '−';
  }

  details p {
    margin-top: 10px;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .facts,
    .cols {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
    }
  }
</style>
