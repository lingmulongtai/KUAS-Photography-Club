---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InstagramSection from '../components/InstagramSection.astro';
import { club } from '../data/club';
const goals = [
  { title: '写真を楽しむ', text: '初心者も経験者も、スマートフォンで撮る方も参加できます。' },
  { title: '写真を通してつながる', text: '日本人学生と留学生が、写真という共通の趣味で交流する写真部です。' },
  { title: '共有機材の整備', text: '共有カメラ等の機材は整備を進めている段階です。利用できる機材については運営にお問い合わせください。' },
];
---
<Base title="写真部について" description="京都先端科学大学 写真部が運営するサイト。部員数、定例ミーティング、部費、運営の役職をご案内します。">
  <PageHero edge="ABOUT ▸ KUAS PHOTOGRAPHY CLUB" title="写真部について" lead="写真を通して「楽しむ」と「つながる」を大切にする、京都先端科学大学の写真部です。このサイトは写真部が運営しています。" />
  <section class="wrap facts" aria-label="写真部の基本情報">
    <div><h2>部員数</h2><p>{club.members}名（{club.membersAsOf}現在）</p></div>
    <div><h2>ミーティング</h2><p>{club.meetings.day} {club.meetings.times.join(' / ')}<br />通常は{club.campus} {club.meetings.room}</p><a href="/schedule/">休会・教室変更の最新案内</a></div>
    <div><h2>部費</h2><p>半期{club.feePerSemester.toLocaleString('ja-JP')}円</p><p class="small muted">撮影会の交通費や入場料等は別途各自負担です。</p></div>
  </section>
  <section class="section"><div class="wrap">
    <div class="section-head"><p class="edge">PURPOSE</p><h2>活動について</h2></div>
    <div class="goals">{goals.map(g => <article><h3>{g.title}</h3><p>{g.text}</p></article>)}</div>
    <p>部員で相談しながら撮影会を企画しています。決まった予定は<a href="/schedule/">スケジュール</a>からご確認ください。</p>
  </div></section>
  <section class="section"><div class="wrap">
    <div class="section-head"><p class="edge">TEAM</p><h2>運営の役職</h2></div>
    <ul class="roles">{['部長', '副部長', '会計'].map(role => <li>{role}</li>)}</ul>
    <p>活動や見学については、<a href="/contact/">お問い合わせ窓口</a>から運営にご相談ください。</p>
  </div></section>
  <InstagramSection />
</Base>
<style>
  .facts, .goals, .roles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .facts > div, .goals article, .roles li { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--raise); }
  .facts h2, .goals h3 { font-size: var(--step-2); margin-bottom: 12px; }
  .roles { padding: 0; list-style: none; }
  @media (max-width: 860px) { .facts, .goals, .roles { grid-template-columns: 1fr; } }
</style>
