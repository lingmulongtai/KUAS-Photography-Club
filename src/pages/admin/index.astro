---
/**
 * Admin panel: create a photo-trip record, add photos to one, and (rarely) a fallback schedule.
 * Publishing commits to GitHub through /api/admin/*, and Vercel redeploys the site.
 * Production publishing requires ADMIN_PASSWORD and GITHUB_TOKEN; missing settings block publishing.
 * A demo is available only when explicitly enabled for local development.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SPOTS } from '../../data/spots';
import { isPublicContent } from '../../lib/public-content';
import { PUBLIC_CALENDAR_URL } from '../../data/public-calendar';

const trips = (await getCollection('trips', isPublicContent))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((t) => ({ slug: t.id, title: t.data.title, date: t.data.date.toISOString().slice(0, 10), photos: t.data.photos.length, sample: t.data.sample, spot: t.data.spot ?? '', cover: t.data.photos[0]?.src ?? '' }));
const months = (await getCollection('schedule', isPublicContent)).map((m) => ({
  month: m.data.month,
  weeklyMeeting: m.data.weeklyMeeting,
  noMeeting: m.data.noMeeting,
  events: m.data.events,
  notes: m.body?.trim() ?? '',
}));
const spots = SPOTS.filter((s) => s.id !== 'kuas');
---
<Base title="管理画面" description="KUAS Photography Club の管理画面" noindex>
  <main class="wrap admin" data-trips={JSON.stringify(trips)} data-months={JSON.stringify(months)}>
    <header class="top">
      <div class="top-title">
        <p class="edge">ADMIN</p>
        <h1>管理画面</h1>
      </div>
      <div class="who">
        <span class="pill" data-mode role="status" aria-live="polite">確認しています…</span>
        <button type="button" class="logout" data-logout hidden>ログアウト</button>
      </div>
    </header>
    <p class="setup" data-setup hidden></p>

    <!-- sign in -->
    <section class="card login" data-view="login" hidden>
      <h2>ログイン</h2>
      <p class="muted small">写真部の運営メンバー用です。ID とパスワードは運営の共有メモを確認してください。</p>
      <form data-login>
        <label>ログインID<input type="text" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required /></label>
        <label>パスワード<input type="password" name="password" autocomplete="current-password" required /></label>
        <button class="btn btn--primary" type="submit">ログイン</button>
        <p class="notice is-error" data-login-error role="alert" hidden></p>
        <p class="small muted" data-demo-hint hidden>ローカルデモです。ID は <code>admin</code>、パスワードは <code>demo</code>。保存・公開はしません。</p>
      </form>
      <p class="small muted">予定の変更はログイン不要です。<a href={PUBLIC_CALENDAR_URL} target="_blank" rel="noopener">部のGoogleカレンダー ↗</a> で更新すると、サイトに自動で反映されます。</p>
    </section>

    <!-- signed in -->
    <section class="app" data-view="app" hidden>
      <h2 class="visually-hidden">やること</h2>
      <div class="tasks" role="tablist" aria-label="やること">
        <button role="tab" type="button" class="task" data-tab="new" aria-selected="true" aria-controls="panel-new">
          <span class="task-icon" aria-hidden="true">＋</span>
          <b>撮影会の記録を作る</b>
          <small>新しい撮影会のページを、写真とレポートつきで公開します。</small>
        </button>
        <button role="tab" type="button" class="task" data-tab="add" aria-selected="false" aria-controls="panel-add">
          <span class="task-icon" aria-hidden="true">▣</span>
          <b>写真を追加する</b>
          <small>公開済みの撮影会に写真を足したり、地図のピンを変えたりします。</small>
        </button>
        <a class="task" href={PUBLIC_CALENDAR_URL} target="_blank" rel="noopener">
          <span class="task-icon" aria-hidden="true">◷</span>
          <b>予定を変える ↗</b>
          <small>予定は部のGoogleカレンダーで更新します。サイトのトップとスケジュールに自動で反映されます。</small>
        </a>
      </div>

      <!-- new trip -->
      <form class="card panel" id="panel-new" role="tabpanel" data-panel="new" novalidate>
        <div class="panel-head">
          <h2>撮影会の記録を作る</h2>
          <p class="notice" data-draft-note hidden></p>
        </div>

        <section class="step">
          <h3><span class="step-no">1</span>どんな撮影会？</h3>
          <div class="grid2">
            <label><span class="lbl">タイトル <em>必須</em></span><input name="title" required maxlength="60" placeholder="例：東山の紅葉" data-count /></label>
            <label><span class="lbl">日付 <em>必須</em></span><input name="date" type="date" required /></label>
            <label><span class="lbl">場所 <em>必須</em></span><input name="place" required maxlength="80" placeholder="例：京都市東山区（清水寺・高台寺）" /></label>
            <label>参加人数<input name="members" type="number" min="1" max="999" inputmode="numeric" placeholder="任意" /></label>
          </div>
          <label><span class="lbl">ひとこと紹介 <em>必須</em></span><input name="summary" required maxlength="140" placeholder="一覧に出る1文。例：人の少ない早朝の千本鳥居を撮りに行きました。" data-count /></label>
          <label>トップの3D地図のピン
            <select name="spot"><option value="">関連づけない</option>{spots.map((s) => <option value={s.id}>{s.ja}</option>)}</select>
            <span class="hint">選ぶと、トップの景色のその場所に「撮影会」の印が付きます。</span>
          </label>
        </section>

        <section class="step">
          <h3><span class="step-no">2</span>写真</h3>
          <div class="photos" data-photos="new"></div>
        </section>

        <section class="step">
          <h3><span class="step-no">3</span>レポート <span class="opt">任意</span></h3>
          <label class="plain">本文
            <textarea name="body" rows="7" placeholder={'集合から解散までの様子や、撮影のコツを書きます。\n段落は空行で区切ります。「## 撮影メモ」のように見出しも書けます。'}></textarea>
          </label>
        </section>

        <section class="step">
          <h3><span class="step-no">4</span>確認して公開</h3>
          <label><span class="lbl">ページのアドレス <em>必須</em></span>
            <span class="slug"><span class="muted">/trips/</span><input name="slug" required pattern="[a-z0-9][a-z0-9\-]{1,60}" placeholder="2026-11-29-arashiyama" autocapitalize="none" spellcheck="false" /></span>
            <span class="hint" data-slug-hint>日付とピンから自動で入ります。半角の英小文字・数字・ハイフンだけ使えます。</span>
          </label>
          <div class="review">
            <div class="preview-card" data-card-preview aria-label="一覧での見え方">
              <div class="preview-cover" data-card-cover><span>写真を選ぶと表紙が入ります</span></div>
              <p class="preview-date num" data-card-date>----.--.--</p>
              <b data-card-title>タイトル</b>
              <span class="preview-place" data-card-place>場所</span>
              <span class="preview-summary" data-card-summary>ひとこと紹介</span>
            </div>
            <ul class="checklist" data-checklist aria-label="公開前のチェック"></ul>
          </div>
          <div class="actions">
            <button class="btn btn--primary" type="submit" disabled>公開する</button>
            <button class="btn" type="button" data-clear-draft>入力をすべて消す</button>
          </div>
          <div class="notice" data-status="new" aria-live="polite" hidden></div>
          <pre class="preview" data-preview="new" hidden></pre>
        </section>
      </form>

      <!-- add photos -->
      <form class="card panel" id="panel-add" role="tabpanel" data-panel="add" hidden novalidate>
        <div class="panel-head"><h2>写真を追加する</h2></div>
        <section class="step">
          <h3><span class="step-no">1</span>どの撮影会？</h3>
          <div class="trip-choice">
            <img class="trip-cover" data-trip-cover alt="" hidden />
            <div class="trip-fields">
              <label>撮影会<select name="slug" data-trip-select required></select></label>
              <label>トップの3D地図のピン<select name="spot" data-trip-spot><option value="">関連づけない</option>{spots.map((s) => <option value={s.id}>{s.ja}</option>)}</select>
                <span class="hint">ピンだけ変えて公開することもできます。</span></label>
            </div>
          </div>
          <p class="notice" data-no-trips hidden>まだ公開された撮影会がありません。先に「撮影会の記録を作る」から公開してください。</p>
        </section>
        <section class="step">
          <h3><span class="step-no">2</span>足す写真</h3>
          <div class="photos" data-photos="add"></div>
        </section>
        <section class="step">
          <h3><span class="step-no">3</span>公開</h3>
          <div class="actions">
            <button class="btn btn--primary" type="submit" disabled>変更を公開する</button>
          </div>
          <div class="notice" data-status="add" aria-live="polite" hidden></div>
          <pre class="preview" data-preview="add" hidden></pre>
        </section>
      </form>

      <!-- fallback schedule: rarely needed -->
      <details class="advanced">
        <summary>カレンダーを読み込めないときの補助案内 <span class="opt">ふだんは使いません</span></summary>
        <form class="card panel" data-panel="schedule" novalidate>
          <p class="small muted">通常の予定はGoogleカレンダーで更新してください。ここから保存した案内は、カレンダー読み込み前や取得できない場合の補助表示に使われます。定例ミーティングも、開催が確認できた日を個別に入力してください（毎週の自動生成は行いません）。</p>
          <label>月<input name="month" type="month" required /></label>
          <input name="weeklyMeeting" type="checkbox" hidden disabled />
          <fieldset hidden disabled>
            <legend>ミーティングがお休みの金曜</legend>
            <div class="list" data-nomeeting></div>
            <button class="btn small-btn" type="button" data-add-off>＋ お休みの日を追加</button>
          </fieldset>
          <fieldset>
            <legend>予定</legend>
            <div class="list" data-events></div>
            <button class="btn small-btn" type="button" data-add-event>＋ 予定を追加</button>
          </fieldset>
          <label>この月のお知らせ（任意・カレンダーの下に出ます）<textarea name="notes" rows="3"></textarea></label>
          <div class="actions">
            <button class="btn btn--primary" type="submit" disabled>公開する</button>
          </div>
          <div class="notice" data-status="schedule" aria-live="polite" hidden></div>
          <pre class="preview" data-preview="schedule" hidden></pre>
        </form>
      </details>
    </section>
  </main>
</Base>

<script>
  import { startAdmin } from '../../scripts/admin/app';
  startAdmin(document.querySelector<HTMLElement>('.admin')!);
</script>

<style>
  .admin {
    padding-block: clamp(32px, 6vw, 64px) 96px;
    display: grid;
    gap: 24px;
    max-width: 980px;
  }

  /* cards and forms set their own display, which would otherwise beat [hidden] */
  .admin :global([hidden]) { display: none !important; }

  .admin :global(.visually-hidden) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 20px; }
  .top-title { display: grid; gap: 6px; }
  h1 { font-size: var(--step-4); }
  .who { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pill { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; background: var(--raise-2); border: 1px solid var(--line); font-size: 13px; font-weight: 700; }
  .pill::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .pill[data-state='live']::before { background: var(--ok); }
  .pill[data-state='demo']::before, .pill[data-state='setup']::before { background: #d9822b; }
  .logout { appearance: none; border: 1.5px solid var(--line-strong); background: var(--raise); color: var(--ink); border-radius: 999px; padding: 7px 14px; font: 700 13px/1 var(--body); cursor: pointer; }
  .setup { padding: 14px 16px; border-radius: var(--radius); background: var(--warning-bg); border: 1px solid var(--warning-line); font-size: 14px; }

  .card { display: grid; gap: 18px; padding: clamp(18px, 3vw, 30px); background: var(--raise); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .card h2 { font-size: var(--step-3); }
  .login { max-width: 460px; }

  form { display: grid; gap: 14px; }
  .admin :global(label) { display: grid; gap: 6px; font-size: 13px; font-weight: 700; color: var(--muted); }
  .admin :global(.lbl) { display: flex; align-items: baseline; gap: 2px; }
  .admin :global(label em) { font-style: normal; font-size: 11px; font-weight: 700; color: var(--accent); margin-left: 4px; }
  .opt { font-size: 12px; font-weight: 500; color: var(--muted); margin-left: 6px; }
  .admin :global(.hint) { font-weight: 400; font-size: 12px; color: var(--muted); }
  .admin :global(.plain-set) { border: 0; padding: 0; margin: 0; display: grid; gap: 6px; min-width: 0; }
  .admin :global(.plain-set legend) { padding: 0; font-weight: 700; color: var(--muted); }

  .admin :global(input:not([type='checkbox']):not([type='radio']):not([type='range'])),
  .admin :global(select),
  .admin :global(textarea) {
    width: 100%;
    padding: 10px 12px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--raise);
    color: var(--ink);
    font: 400 16px/1.5 var(--body);
  }
  .admin :global(input:focus-visible), .admin :global(select:focus-visible), .admin :global(textarea:focus-visible), .admin :global(button:focus-visible) { outline: 2px solid var(--brand); outline-offset: 2px; }
  .admin :global(.is-missing) { border-color: var(--error) !important; }

  /* what to do */
  .app { display: grid; gap: 24px; }
  .tasks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .task {
    appearance: none;
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 18px;
    text-align: left;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
    color: var(--ink);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: border-color .15s, background-color .15s;
  }
  .task:hover { border-color: var(--brand); color: var(--ink); }
  .task[aria-selected='true'] { border-color: var(--brand); background: var(--brand-pale); box-shadow: inset 0 0 0 1px var(--brand); }
  .task b { font-size: 16px; }
  .task small { font-size: 12.5px; color: var(--muted); line-height: 1.6; }
  .task-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--brand); color: var(--on-accent); font-weight: 700; }

  /* steps */
  .panel-head { display: grid; gap: 10px; }
  .step { display: grid; gap: 14px; padding-top: 18px; border-top: 1px solid var(--line); }
  .step h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .step-no { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--ink); color: var(--raise); font: 700 13px/1 var(--latin); flex: none; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .slug { display: flex; align-items: center; gap: 6px; font-weight: 400; }

  /* review */
  .review { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: 20px; align-items: start; }
  .preview-card { display: grid; gap: 4px; padding: 10px 10px 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--base); }
  .preview-cover { aspect-ratio: 4 / 3; border-radius: 8px; background: var(--raise-2) center / cover no-repeat; display: grid; place-items: center; margin-bottom: 6px; }
  .preview-cover span { font-size: 12px; color: var(--muted); padding: 10px; text-align: center; }
  .preview-date { font-size: 12px; color: var(--accent); font-weight: 700; }
  .preview-place, .preview-summary { font-size: 12.5px; color: var(--muted); line-height: 1.6; }
  .checklist { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 14px; }
  .admin :global(.checklist li) { display: flex; gap: 8px; align-items: baseline; }
  .admin :global(.checklist li::before) { content: '○'; color: var(--muted); font-weight: 700; width: 1em; flex: none; }
  .admin :global(.checklist li.done) { color: var(--muted); }
  .admin :global(.checklist li.done::before) { content: '✓'; color: var(--ok); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }

  /* messages */
  .admin :global(.notice) { padding: 12px 14px; border-radius: var(--radius-sm); background: var(--raise-2); border: 1px solid var(--line); font-size: 14px; line-height: 1.7; }
  .admin :global(.notice.is-error) { background: color-mix(in srgb, var(--error) 10%, var(--raise)); border-color: color-mix(in srgb, var(--error) 45%, transparent); color: var(--ink); }
  .admin :global(.notice.is-ok) { background: color-mix(in srgb, var(--ok) 12%, var(--raise)); border-color: color-mix(in srgb, var(--ok) 45%, transparent); }
  .admin :global(.notice a) { color: var(--accent); font-weight: 700; }
  .admin :global(.notice button) { margin-left: 8px; }

  .preview { margin: 0; padding: 14px; max-height: 360px; overflow: auto; background: var(--rebate); color: #e8f4f4; border-radius: var(--radius-sm); font: 12px/1.6 var(--mono); white-space: pre-wrap; }

  /* add photos */
  .trip-choice { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: start; }
  .trip-cover { width: 140px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; background: var(--raise-2); }
  .trip-fields { display: grid; gap: 12px; }

  /* the rarely used fallback schedule */
  .advanced { border: 1px dashed var(--line-strong); border-radius: var(--radius); padding: 0 16px; }
  .advanced > summary { cursor: pointer; padding: 14px 0; font-weight: 700; font-size: 14px; color: var(--muted); }
  .advanced[open] { padding-bottom: 16px; }
  fieldset { border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; display: grid; gap: 10px; }
  legend { padding: 0 6px; font-weight: 700; font-size: 14px; }
  .small-btn { justify-self: start; padding: 8px 14px; font-size: 13px; }
  .list { display: grid; gap: 8px; }

  /* photo picker (built by the script) */
  .admin :global(.drop) { display: grid; place-items: center; gap: 6px; padding: 28px 18px; border: 2px dashed var(--line-strong); border-radius: var(--radius); color: var(--muted); text-align: center; cursor: pointer; transition: border-color 0.2s, background-color 0.2s; }
  .admin :global(.drop strong) { color: var(--ink); font-size: 16px; }
  .admin :global(.drop.over), .admin :global(.drop:hover) { border-color: var(--brand); background: var(--brand-pale); }
  .admin :global(.drop:focus-within) { outline: 2px solid var(--brand); outline-offset: 2px; }
  .admin :global(.picker) { display: grid; gap: 14px; }
  .admin :global(.photo-row) { display: grid; grid-template-columns: 150px minmax(0, 1fr) auto; gap: 14px; align-items: start; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--raise); }
  .admin :global(.photo-row.is-cover) { border-color: var(--brand); }
  .admin :global(.thumb-wrap) { position: relative; display: grid; gap: 4px; }
  .admin :global(.thumb) { width: 150px; height: 112px; object-fit: contain; border-radius: 6px; background: var(--rebate); cursor: zoom-in; display: block; }
  .admin :global(.thumb-wrap .badge) { position: absolute; top: 6px; left: 6px; padding: 2px 8px; border-radius: 999px; background: var(--brand); color: var(--on-accent); font-size: 11px; font-weight: 700; }
  .admin :global(.photo-row .fields) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .admin :global(.photo-row .fields .wide) { grid-column: 1 / -1; }
  .admin :global(.photo-row .meta) { grid-column: 1 / -1; font-size: 12px; color: var(--muted); font-weight: 400; }
  .admin :global(.row-tools) { display: grid; gap: 6px; }
  .admin :global(.row-tools button), .admin :global(.event-row button) { appearance: none; border: 1px solid var(--line-strong); background: var(--raise); color: var(--ink); border-radius: 6px; min-width: 36px; min-height: 36px; padding: 4px 8px; cursor: pointer; font-size: 14px; }
  .admin :global(.row-tools button:disabled) { opacity: .35; cursor: default; }

  /* watermark */
  .admin :global(.wm) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 18px; padding: 16px; border-radius: var(--radius); background: var(--raise-2); border: 1px solid var(--line); }
  .admin :global(.wm-head) { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .admin :global(.wm-head b) { font-size: 15px; }
  .admin :global(.switch) { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink); cursor: pointer; }
  .admin :global(.switch input) { width: 20px; height: 20px; accent-color: var(--accent); }
  .admin :global(.wm-controls) { display: grid; gap: 14px; align-content: start; }
  .admin :global(.wm.is-off .wm-controls), .admin :global(.wm.is-off .wm-stage) { opacity: .45; }
  .admin :global(.seg) { display: flex; flex-wrap: wrap; gap: 6px; }
  .admin :global(.seg label) { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border: 1.5px solid var(--line-strong); border-radius: 999px; background: var(--raise); color: var(--ink); font-size: 13px; cursor: pointer; }
  .admin :global(.seg label:has(input:checked)) { border-color: var(--accent); background: var(--brand-pale); }
  .admin :global(.seg input) { accent-color: var(--accent); margin: 0; }
  .admin :global(.swatch) { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--line-strong); }
  .admin :global(.grid9) { display: grid; grid-template-columns: repeat(3, 34px); gap: 4px; }
