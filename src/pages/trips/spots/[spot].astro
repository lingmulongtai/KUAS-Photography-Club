---
import Base from '../../../layouts/Base.astro';
import { SPOTS } from '../../../data/spots';
import { getTrips } from '../../../lib/trips';
export function getStaticPaths() {
  return SPOTS.map(spot=>({params:{spot:spot.id},props:{spot}}));
}
const {spot}=Astro.props;
const related=(await getTrips()).filter(t=>t.data.spot===spot.id);
---
<Base title={`${spot.ja}の撮影会`} description={`${spot.ja}の活動記録。公開できる記録を準備中です。`}>
  <section class="wrap section spot-sample">
    <p class="edge">PHOTO TRIPS ▸ {spot.en}</p>
    <h1>{spot.ja}の撮影会</h1>
    {related.some(t=>!t.data.sample) ? <p>この場所の撮影会記録をご覧ください。</p> : <p>この場所の実際の撮影会記録はまだありません。</p>}
    {related.map(t=><p><a class="link-arrow" href={`/trips/${encodeURIComponent(t.id)}/`}>{t.data.title}{t.data.sample ? '（サンプル）' : ''} →</a></p>)}
    <p><a class="link-arrow" href="/trips/">撮影会の一覧を見る →</a></p>
    <p><a class="link-arrow" href="/">京都の眺めに戻る →</a></p>
  </section>
</Base>
<style>
  .spot-sample { display: grid; gap: 22px; padding-top: calc(var(--header-h) + 64px); }
  figure { margin: 0; max-width: 800px; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius); }
  figcaption { margin-top: 12px; font-size: 13px; color: var(--muted); }
</style>
