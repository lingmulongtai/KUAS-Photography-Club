---
import Base from '../../layouts/Base.astro';
import ReelHero from '../../components/ReelHero.astro';
import { getTrips, reelPhotos } from '../../lib/trips';
const trips = await getTrips();
const photoCount = trips.reduce((n, t) => n + t.data.photos.length, 0);
const reel = await reelPhotos('en');
---
<Base lang="en" title="Photo outing records" description="KUAS Photography Club outing records. Public records are being prepared.">
  <ReelHero
    lang="en"
    photos={reel.photos}
    sample={reel.sample}
    edge={`PHOTO TRIPS ▸ ${trips.length} ROLLS ▸ ${photoCount} FRAMES`}
    title="Photo outing records"
    lead="Members plan photo outings together. Records will be published when ready for public viewing."
  />
  <section class="wrap section"><p>{trips.length ? 'Available outing records (Japanese):' : 'Activity records are being prepared.'}</p>{trips.map(trip => <p><a href={`/trips/${trip.id}/`} lang="ja">{trip.data.title} (Japanese)</a></p>)}<p><a class="link-arrow" href="/en/schedule/">See confirmed upcoming dates →</a></p></section>
</Base>
