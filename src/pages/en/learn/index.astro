---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Studio from '../../../components/learn/Studio.astro';
import LearnCards from '../../../components/learn/LearnCards.astro';
---
<Base lang="en" title="Learn photography" description="One 3D photo studio where you can try aperture, shutter speed, ISO, lenses, filters and flash in your browser, with a starry sky, a flower field and challenges. Put together by the KUAS Photography Club for beginners.">
  <PageHero
    edge="LEARN ▸ ONE STUDIO ▸ FOR BEGINNERS"
    title="Photography, hands-on."
    lead="Camera settings make more sense when you move them than when you read about them. In one 3D studio you can try aperture, shutter speed, ISO, lenses, filters, flash and lights. Pick a place and a subject, then press the shutter. No camera needed: it helps with smartphone photos too."
  />

  <section class="wrap studio-wrap" id="studio" aria-label="Photo studio">
    <Studio lang="en" />
  </section>

  <section class="section" aria-labelledby="triangle">
    <div class="wrap">
      <div class="section-head">
        <p class="edge">EXPOSURE TRIANGLE</p>
        <h2 id="triangle">The exposure triangle</h2>
        <p class="lead">
          Shutter speed, aperture and ISO together decide how bright a photo is. Make one of them a stop brighter and another a stop darker, and the brightness stays the same while the look of the picture changes.
        </p>
      </div>
      <div class="notes">
        <div>
          <h3>Shutter speed</h3>
          <p>Longer is brighter, but camera shake and subject blur become more likely. <a href="/en/learn/shutter-speed/">More →</a></p>
        </div>
        <div>
          <h3>Aperture (f-number)</h3>
          <p>A smaller number is brighter, but less of the picture is in focus and the background blurs. <a href="/en/learn/aperture/">More →</a></p>
        </div>
        <div>
          <h3>ISO</h3>
          <p>A larger number is brighter, but grainy noise increases. Use it last, to make up the difference.</p>
        </div>
        <div>
          <h3>Sunny days: “f/16 · 1/ISO”</h3>
          <p>Outdoors in sunshine, about f/16, ISO 100 and 1/125 s gives a good exposure (the sunny 16 rule). Try it in the studio’s Japanese garden.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="topics">
    <div class="wrap">
      <div class="section-head">
        <p class="edge">WHY IT WORKS</p>
        <h2 id="topics">How it works</h2>
        <p class="lead">The reasons behind what you try in the studio, one topic at a time. Each page can open the studio on that topic’s challenges.</p>
      </div>
      <LearnCards lang="en" />
    </div>
  </section>
</Base>

<style>
  .studio-wrap {
    padding-bottom: clamp(16px, 3vw, 32px);
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px 32px;
    margin-top: 12px;
  }

  .notes > div {
    display: grid;
    gap: 6px;
    align-content: start;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .notes h3 {
    font-size: var(--step-1);
  }

  .notes p {
    font-size: 14px;
    color: var(--ink);
  }

  .notes a {
    color: var(--accent);
  }
</style>
