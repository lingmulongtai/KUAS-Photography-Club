---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuidelinesView from '../../components/GuidelinesView.astro';

const entry = (await getEntry('guidelines', 'ja'))!;
---
<Base title="ガイドライン" description="KUAS Photography Club の参加・安全・写真の取り扱いのご案内。日本語と英語で読めます。">
  <GuidelinesView entry={entry} />
</Base>
