---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuidelinesView from '../../components/GuidelinesView.astro';
import { guidelineLanguages } from '../../data/languages';

export async function getStaticPaths() {
  const entries = await getCollection('guidelines');
  return entries.filter((e) => e.id !== 'ja').map((entry) => ({ params: { lang: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guidelines'>;
}
const { entry } = Astro.props;
const language = guidelineLanguages.find((l) => l.id === entry.id);
const title = entry.body?.match(/^#\s+(.+)$/m)?.[1] ?? 'Guidelines';
---
<Base title={title} description={`KUAS Photography Club guidelines (${language?.name ?? entry.id}).`}>
  <GuidelinesView entry={entry} />
</Base>
