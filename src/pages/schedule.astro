---
import CalendarFeed from '../components/CalendarFeed.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ScheduleMonth from '../components/ScheduleMonth.astro';
import { getSchedule, kindLabel, type EventKind } from '../lib/schedule';
import { club } from '../data/club';

const months = await getSchedule();
const kinds = Object.keys(kindLabel) as EventKind[];
---
<Base title="スケジュール" description={`写真部の月ごとの予定。定例ミーティング（${club.meetings.day} ${club.meetings.times.join(' / ')}・${club.campus} ${club.meetings.room}）と撮影会・イベントの日程です。`}>
  <PageHero
    edge="SCHEDULE ▸ MONTHLY"
    title="スケジュール"
    lead={`定例ミーティングは${club.meetings.day} ${club.meetings.times.join(' / ')}、${club.campus} ${club.meetings.room} 教室です。休会や教室変更があるため、参加前に運営へ最新案内をご確認ください。共有Googleカレンダーの予定とお知らせを自動で表示します。`}
  />

  <div class="wrap">
    <p><a href="/contact/">運営へ最新の開催・教室を確認する</a>。予定は部のGoogleカレンダーから自動更新されます。</p>
    <ul class="legend" aria-label="予定の種類">
      {kinds.map((k) => <li class={`k-${k}`}><i></i>{kindLabel[k]}</li>)}
    </ul>
    <CalendarFeed>{months.map((m) => <ScheduleMonth month={m} />)}</CalendarFeed>
    {months.length === 0 && <p class="muted">まだ予定はありません。</p>}
  </div>
</Base>

<script>
  // mark today, dim what is past and jump to this month
  const now = new Date(Date.now() + 9 * 3600000);
  const today = now.toISOString().slice(0, 10);
  const thisMonth = today.slice(0, 7);
  document.querySelectorAll<HTMLElement>('[data-date]').forEach((el) => {
    const d = el.dataset.date!;
    if (d === today) el.classList.add('today');
    else if (d < today) el.classList.add('past');
  });
  const current = document.querySelector<HTMLElement>(`[data-month="${thisMonth}"]`);
  current?.classList.add('is-now');
  if (current && !location.hash) current.scrollIntoView({ block: 'start' });
</script>

<style>
  .legend {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 13px;
    font-weight: 700;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  .k-meeting {
    --c: var(--brand);
  }

  .k-trip {
    --c: var(--meeting);
  }

  .k-event {
    --c: #e0a23b;
  }

  .k-deadline {
    --c: var(--error);
  }

  .k-other {
    --c: #8aa1a7;
  }
</style>
