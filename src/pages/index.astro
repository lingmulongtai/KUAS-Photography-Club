---
import Base from '../layouts/Base.astro';
import KyotoHero from '../components/KyotoHero.astro';
import TripCard from '../components/TripCard.astro';
import ReelHero from '../components/ReelHero.astro';
import LearnCards from '../components/learn/LearnCards.astro';
import InstagramSection from '../components/InstagramSection.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import FirstSteps from '../components/FirstSteps.astro';
import HomeIntro from '../components/HomeIntro.astro';
import StickyJoin from '../components/StickyJoin.astro';
import { getTrips, reelPhotos } from '../lib/trips';
import { homeJa } from '../data/home-ja';

const trips = await getTrips();
const latest = trips.slice(0, 3);
const reel = await reelPhotos('ja');
---
<Base overlayHeader documentTitle={homeJa.title} description={homeJa.description}>
  <KyotoHero />

  <HomeIntro />

  <ReelHero
    id="activity"
    heading="h2"
    counter={false}
    photos={reel.photos}
    placeholder={reel.placeholder}
    note={reel.members ? '部員が撮った写真です。撮影者の許可を得て掲載しています。' : undefined}
    edge="PHOTO TRIPS ▸ LATEST ROLLS"
    title="最近の撮影会"
    lead="部員で相談しながら、京都の街や近くの府県へ撮影に出かけています。"
    link={{ href: '/trips/', label: 'すべての撮影会 →' }}
  />
  {latest.length > 0 && (
    <section class="section latest" aria-label="最近の撮影会の記録">
      <div class="wrap">
        <div class="list">
          {latest.map((trip) => <TripCard trip={trip} />)}
        </div>
      </div>
    </section>
  )}

  <InstagramSection />

  <section class="section soft" aria-labelledby="next-title">
    <div class="wrap stack">
      <div class="head-row">
        <div class="section-head">
          <p class="edge">SCHEDULE ▸ COMING UP</p>
          <h2 id="next-title">これからの予定</h2>
        </div>
        <a class="link-arrow" href="/schedule/">スケジュールを見る →</a>
      </div>
      <UpcomingEvents />
    </div>
  </section>

  <section class="section" aria-labelledby="learn-title">
    <div class="wrap stack">
      <div class="head-row">
        <div class="section-head">
          <p class="edge">LEARN ▸ FOR BEGINNERS</p>
          <h2 id="learn-title">写真を、触って学ぶ。</h2>
          <p class="muted">シャッタースピード、絞り、焦点距離、現像。カメラの設定を、ブラウザの中で動かしながら覚えられます。</p>
        </div>
        <a class="link-arrow" href="/learn/">写真を学ぶ →</a>
      </div>
      <LearnCards rail />
    </div>
  </section>

  <FirstSteps />
  <StickyJoin />
</Base>

<style>
  .soft {
    background: var(--brand-pale);
    border-top: 0;
  }

  .stack {
    display: grid;
    gap: 28px;
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) { .list { grid-template-columns: 1fr; } }

</style>
