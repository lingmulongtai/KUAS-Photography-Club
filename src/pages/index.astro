---
import Base from '../layouts/Base.astro';
import KyotoHero from '../components/KyotoHero.astro';
import TripCard from '../components/TripCard.astro';
import LearnCards from '../components/learn/LearnCards.astro';
import InstagramSection from '../components/InstagramSection.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import { getTrips } from '../lib/trips';
import { club } from '../data/club';

const trips = await getTrips();
const latest = trips.slice(0, 3);
---
<Base overlayHeader>
  <KyotoHero />

  <section id="intro" class="section intro">
    <div class="wrap grid">
      <div class="statement">
        <p class="edge">KUAS PHOTOGRAPHY CLUB</p>
        <h2>撮りに行こう。<br />京都と、その少し先まで。</h2>
        <p class="lead">
          {club.name} は、{club.university}の写真部です。部員で相談しながら撮影会を企画しています。日本人も留学生も、カメラがある人もスマホの人も一緒です。
        </p>
        <a class="link-arrow" href="/about/">写真部について →</a>
      </div>
      <aside class="meeting" aria-label="ミーティングの案内">
        <p class="edge">MEETING ▸ EVERY WEEK</p>
        <p class="when">{club.meetings.day}</p>
        <p class="times num">{club.meetings.times.join(' / ')}</p>
        <p class="where">通常は {club.campus} {club.meetings.room} 教室</p>
        <a class="small" href="/schedule/">休会・教室変更などの最新案内を確認</a>
        <a class="btn btn--primary" href="/join/">見学を申し込む <span class="arrow" aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="section soft" aria-labelledby="next-title">
    <div class="wrap stack">
      <div class="head-row">
        <div class="section-head">
          <p class="edge">SCHEDULE ▸ COMING UP</p>
          <h2 id="next-title">これからの予定</h2>
        </div>
        <a class="link-arrow" href="/schedule/">スケジュールを見る →</a>
      </div>
      <UpcomingEvents />
    </div>
  </section>

  <section class="section" aria-labelledby="latest-title">
    <div class="wrap stack">
      <div class="head-row">
        <div class="section-head">
          <p class="edge">PHOTO TRIPS ▸ LATEST ROLLS</p>
          <h2 id="latest-title">最近の撮影会</h2>
        </div>
        <a class="link-arrow" href="/trips/">すべての撮影会 →</a>
      </div>
      {latest.length === 0 && <p class="muted">活動記録を準備中です。</p>}
      <div class="list">
        {latest.map((trip) => <TripCard trip={trip} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="learn-title">
    <div class="wrap stack">
      <div class="head-row">
        <div class="section-head">
          <p class="edge">LEARN ▸ FOR BEGINNERS</p>
          <h2 id="learn-title">写真を、触って学ぶ。</h2>
          <p class="muted">シャッタースピード、絞り、焦点距離、現像。カメラの設定を、ブラウザの中で動かしながら覚えられます。</p>
        </div>
        <a class="link-arrow" href="/learn/">写真を学ぶ →</a>
      </div>
      <LearnCards />
    </div>
  </section>

  <InstagramSection />

  <section class="section cta">
    <div class="wrap cta-inner">
      <p class="edge">JOIN US</p>
      <h2>まずは、金曜の<br />ミーティングをのぞいてみませんか。</h2>
      <p class="lead">経験もカメラもいりません。通常は{club.meetings.day} {club.meetings.times.join(' / ')}、{club.campus} {club.meetings.room} 教室です。参加前にスケジュールと運営への確認をお願いします。</p>
      <div class="ctas">
        <a class="btn btn--primary" href="/join/">見学・入部について <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href="/guidelines/">ガイドラインを読む</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px 72px;
    align-items: start;
  }

  .statement {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .statement h2 {
    font-size: var(--step-4);
  }

  .meeting {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
  }

  .when {
    font: 700 var(--step-3) / 1.35 var(--display);
    margin-top: 8px;
  }

  .times {
    font-size: 30px;
    color: var(--accent);
    line-height: 1.2;
  }

  .where {
    color: var(--muted);
    margin-bottom: 14px;
  }

  .soft {
    background: var(--brand-pale);
    border-top: 0;
  }

  .stack {
    display: grid;
    gap: 28px;
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) { .list { grid-template-columns: 1fr; } }

  .cta {
    background: var(--brand-pale);
    border-top: 0;
  }

  .cta-inner {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .cta h2 {
    font-size: var(--step-4);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .intro .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
