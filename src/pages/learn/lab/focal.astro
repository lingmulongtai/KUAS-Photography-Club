---
import LabLayout from '../../../layouts/LabLayout.astro';
import Proposal from '../../../components/lab/Proposal.astro';
import LabSlider from '../../../components/lab/LabSlider.astro';
import { FOCAL_LADDER } from '../../../scripts/lab/optics';
const frames = [24, 35, 50, 85, 135, 200];
---
<LabLayout
  title="焦点距離のデザイン案"
  current="focal"
  lead="今の「焦点距離と遠近感」のよかったところ（同じ大きさに写る距離で比べる3D）を残しつつ、撮影する人のモデルはやめ、目の開いた大理石の胸像・デッサン人形と実写の背景に置き換えました。5案とも実際に動きます。ドラッグで少し回り込めます。"
>
  <Proposal
    id="focal-a"
    code="焦点 A"
    title="同じ大きさで撮り比べ＋真上から見た立ち位置"
    concept="今の案の正統進化。焦点距離を変えると、胸像が同じ大きさに写るようにカメラが前後に動きます。右下の真上からの図で、カメラの位置と画角の扇形が同時に動き、後ろの鳥居の写り方の変化と結びつきます。"
    good={['今の案の「距離が遠近感を決める」という一番大事な話がそのまま伝わる', '真上の図が3Dの中で実際に動くので、図と写真の対応が一目でわかる', '鳥居が背景にあるので、望遠で背景が迫る（圧縮）のも同時に見える']}
    care={['画面に情報が多いので、スマホでは真上の図を小さくする必要がある', '1画面で全部説明するぶん、文章の補足が要る']}
  >
    <div class="stage lab-stage" data-demo="focal-a">
      <canvas aria-label="焦点距離を変えても胸像が同じ大きさに写るように、カメラが前後に動く3Dデモ"></canvas>
      <div class="vf">
        <div class="corners"></div>
        <div class="top"><span class="pill" data-readout>50mm</span></div>
        <div class="inset" data-inset><span>真上から見た立ち位置</span></div>
      </div>
    </div>
    <div class="cam cam-grid">
      <LabSlider name="mm" label="焦点距離" stops={FOCAL_LADDER} value={50} format="mm" />
      <div class="cam-row">
        <span class="cam-title">被写体</span>
        <div class="seg">
          <button type="button" data-seg="subject" data-value="bust" aria-pressed="true">胸像</button>
          <button type="button" data-seg="subject" data-value="mannequin" aria-pressed="false">デッサン人形</button>
          <button type="button" data-seg="subject" data-value="horse" aria-pressed="false">白磁の馬</button>
        </div>
      </div>
    </div>
  </Proposal>

  <Proposal
    id="focal-b"
    code="焦点 B"
    title="同じ場所からズーム（画角の枠つき）"
    concept="立ち位置は変えずに、ズームだけを動かす案。広角の画面に、望遠ならどこまで写るかの枠を重ねて表示します。枠をタップするとその焦点距離までズームします。「ズーム＝切り抜き」で、遠近感は変わらないことが体感できます。"
    good={['スマホのズーム（1x・2x・3x）と同じ操作なので、初心者にいちばん直感的', '枠が見えるので「85mm だとこのくらい」の感覚が身につく', 'A案と並べると「動くか、ズームするか」の違いがはっきりする']}
    care={['これだけだと「距離で遠近感が変わる」話が伝わらない（A案かE案とセット向き）']}
  >
    <div class="stage lab-stage" data-demo="focal-b">
      <canvas aria-label="同じ場所から焦点距離を変えると写る範囲が変わる3Dデモ"></canvas>
      <div class="vf">
        <div class="top"><span class="pill" data-readout>16mm</span></div>
        {frames.map((mm) => (
          <button type="button" class="zoom-frame" data-frame={mm} aria-pressed="false"><span>{mm}mm</span></button>
        ))}
      </div>
    </div>
    <div class="cam cam-row">
      <span class="cam-title">ズーム</span>
      <div class="seg">
        {[16, ...frames].map((mm) => <button type="button" data-zoom={mm}>{mm}mm</button>)}
      </div>
      <p>枠をタップしてもズームできます。</p>
    </div>
  </Proposal>

  <Proposal
    id="focal-c"
    code="焦点 C"
    title="4本のレンズを同時に並べる"
    concept="16mm・35mm・85mm・200mm で同じ大きさに撮った4枚を、ひとつの画面に並べて同時に表示します。ドラッグすると4台のカメラが一緒に回り込むので、顔の立体感と背景の広さの違いを横並びで比べられます。"
    good={['操作しなくても違いがわかる。最初の1画面のインパクトが強い', '回り込むと、広角の鼻の大きさ・望遠の平たさがよくわかる', '背景を切り替えても4枚同時に変わる']}
    care={['1枚1枚が小さいので、スマホでは細部が見えにくい', '4枚同時描画なので、古いスマホでは重くなる']}
  >
    <div class="stage lab-stage" data-demo="focal-c">
      <canvas aria-label="4つの焦点距離で同じ胸像を撮り比べる3Dデモ"></canvas>
      <div class="vf quads">
        {[0, 1, 2, 3].map((i) => <div class="quad" data-quad={i}><b></b><span></span></div>)}
      </div>
    </div>
    <div class="cam cam-row">
      <span class="cam-title">被写体</span>
      <div class="seg">
        <button type="button" data-seg="subject" data-value="bust" aria-pressed="true">胸像</button>
        <button type="button" data-seg="subject" data-value="mannequin" aria-pressed="false">デッサン人形</button>
      </div>
      <span class="cam-title">背景</span>
      <div class="seg">
        <button type="button" data-seg="bg" data-value="autumn" aria-pressed="true">林</button>
        <button type="button" data-seg="bg" data-value="garden" aria-pressed="false">庭園</button>
        <button type="button" data-seg="bg" data-value="night" aria-pressed="false">夜の街</button>
      </div>
    </div>
  </Proposal>

  <Proposal
    id="focal-d"
    code="焦点 D"
    title="スタジオを外から眺める（カメラと画角の見える化）"
    concept="撮影スタジオを外側から見下ろし、カメラの位置と「写る範囲」を光の四角錐で見せる案。右下の小窓が、そのカメラで撮れる写真です。焦点距離と距離を別々に動かせるので、ズームと前後移動の違いを空間で理解できます。ドラッグでスタジオを回せます。"
    good={['「画角」という目に見えないものが形になる', '焦点距離と距離を分けて動かせるので、A案とB案の両方の話ができる', 'スタジオの模型を眺める楽しさがある']}
    care={['完成写真が小窓になるので、写りの細かい違いは見えにくい', 'スライダーが2本あり、少しだけ操作が多い']}
  >
    <div class="stage lab-stage tall" data-demo="focal-d">
      <canvas aria-label="スタジオを外から見て、カメラの位置と写る範囲を表示する3Dデモ"></canvas>
      <div class="vf">
        <div class="top"><span class="pill">ドラッグでスタジオを回せます</span><span class="pill" data-readout></span></div>
        <div class="inset-label">このカメラで撮れる写真</div>
      </div>
    </div>
    <div class="cam cam-grid">
      <LabSlider name="mm" label="焦点距離" stops={FOCAL_LADDER} value={35} format="mm" />
      <LabSlider name="distance" label="カメラから胸像まで" stops={[0.6, 0.8, 1, 1.3, 1.6, 2, 2.5, 3, 4]} value={1.6} format="m" />
    </div>
  </Proposal>

  <Proposal
    id="focal-e"
    code="焦点 E"
    title="千本鳥居で「圧縮効果」を測る"
    concept="伏見稲荷の千本鳥居をイメージした鳥居のトンネルの前に、デッサン人形を立たせます。人を同じ大きさに写したまま焦点距離を変えると、奥の鳥居がどんどん詰まって見えます。手前の鳥居と10本目の鳥居の大きさの比を数字で表示して、「圧縮」を測れるようにしました。"
    good={['京都の撮影スポットと結びつくので、部の活動（伏見稲荷の撮影会）にそのままつながる', '圧縮効果が数字とバーで見えるので、感覚だけで終わらない', '24mm と 200mm の差が劇的で、触って楽しい']}
    care={['鳥居は簡略化したモデルなので、本物の質感までは出していない', '圧縮の話に特化しているので、画角の話は別に要る']}
  >
    <div class="stage lab-stage" data-demo="focal-e">
      <canvas aria-label="鳥居のトンネルの前の人形を、焦点距離を変えて同じ大きさに撮る3Dデモ"></canvas>
      <div class="vf">
        <div class="corners"></div>
        <div class="top"><span class="pill" data-readout>24mm</span></div>
        <div class="ratio-box">
          <span>1本目と10本目の鳥居の大きさ</span>
          <b data-ratio>1 : 0.3</b>
          <i data-ratio-bar></i>
        </div>
      </div>
    </div>
    <div class="cam cam-grid">
      <LabSlider name="mm" label="焦点距離（人の大きさは同じまま）" stops={FOCAL_LADDER} value={24} format="mm" />
      <div class="cam-row">
        <span class="cam-title">撮り比べ</span>
        {[16, 35, 85, 200].map((mm) => <button type="button" class="cam-btn" data-preset={mm}>{mm}mm</button>)}
      </div>
    </div>
  </Proposal>
</LabLayout>

<script>
  import '../../../scripts/lab/proposals/focal';
</script>

<style>
  .inset {
    position: absolute;
    right: 12px;
    bottom: 12px;
    border: 1px solid rgba(239, 233, 223, 0.5);
    border-radius: 6px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .inset span,
  .inset-label {
    position: absolute;
    left: 8px;
    top: 6px;
    font-size: 10px;
    padding: 3px 6px;
    border-radius: 3px;
    background: rgba(10, 12, 14, 0.6);
  }

  .inset-label {
    left: auto;
    top: auto;
    right: 18px;
    bottom: calc(min(36vw, 340px) / 1.5 + 18px);
  }

  .zoom-frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--k, 0.5) * 100%);
    height: calc(var(--k, 0.5) * 100%);
    transform: translate(-50%, -50%);
    border: 1.5px dashed rgba(239, 233, 223, 0.85);
    border-radius: 2px;
    background: none;
    padding: 0;
    pointer-events: auto;
    cursor: zoom-in;
  }

  .zoom-frame[hidden] {
    display: none;
  }

  .zoom-frame span {
    position: absolute;
    left: 4px;
    top: 4px;
    font: 500 11px/1 var(--mono);
    color: var(--cam-ink);
    background: rgba(10, 12, 14, 0.6);
    padding: 3px 5px;
    border-radius: 3px;
  }

  .zoom-frame[aria-pressed="true"] {
    border-color: var(--cam-accent);
    border-style: solid;
  }

  .zoom-frame:hover {
    border-color: var(--cam-accent);
  }

  .quads {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .quad {
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.6);
    padding: 10px;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .quad b,
  .quad span {
    padding: 4px 7px;
    border-radius: 3px;
    background: rgba(10, 12, 14, 0.6);
    font-weight: 500;
  }

  .quad b {
    color: var(--cam-accent);
  }

  .ratio-box {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    gap: 4px;
    width: min(240px, 46%);
    padding: 10px 12px;
    border-radius: 8px;
    background: rgba(10, 12, 14, 0.6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .ratio-box span {
    font-size: 10px;
    color: var(--cam-muted);
  }

  .ratio-box b {
    font: 500 20px/1 var(--mono);
  }

  .ratio-box i {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--cam-accent) calc(var(--r, 0.3) * 100%), rgba(239, 233, 223, 0.2) 0);
  }

  @media (max-width: 600px) {
    .inset-label {
      display: none;
    }
  }
</style>
