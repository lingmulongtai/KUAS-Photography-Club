---
import LabLayout from '../../../layouts/LabLayout.astro';
import Proposal from '../../../components/lab/Proposal.astro';
import LabSlider from '../../../components/lab/LabSlider.astro';
import CameraDial from '../../../components/learn/CameraDial.astro';
import { APERTURE_STOPS, ISO_LADDER, SHUTTER_STOPS, apertureText, shutterText } from '../../../scripts/lab/optics';
const meterLabels = ['−3', '−2', '−1', '0', '+1', '+2', '+3'];
---
<LabLayout
  title="露出のデザイン案"
  current="exposure"
  lead="今は露出だけ写真の明るさを変えるだけの別の作りになっていたので、ほかのテーマと同じ3Dの撮影現場で、シャッタースピード・絞り・ISO を本物のカメラと同じように試せるようにしました。明るさだけでなく、風車や落ち葉のブレ、背景のボケ、ISO のザラつきまで、設定どおりに写ります。"
>
  <Proposal
    id="exposure-a"
    code="露出 A"
    title="カメラの背面そのまま"
    concept="本物のカメラの背面モニターと3つのダイヤルを再現する案。画面の上に設定、下に露出計（−3〜+3）、隅にヒストグラム。白飛びの縞模様（ゼブラ）も出せます。触った感覚がそのまま実機の操作につながります。"
    good={['実際のカメラを持ったときに迷わない。部の新入生講習にもそのまま使える', '露出計・ヒストグラム・ゼブラなど、本物の道具の読み方が身につく', '3つの設定の副作用（ブレ・ボケ・ノイズ）が同じ画面で同時に起きる']}
    care={['最初は情報が多く見えるので、はじめての人向けの「やさしい表示」切り替えがあるとよい', 'ダイヤルの操作はスマホだと少し細かい']}
  >
    <div class="cam-body">
      <div class="stage lab-stage" data-demo="exposure-a">
        <canvas aria-label="カメラの背面モニターのように、設定どおりの写真が写る3Dデモ"></canvas>
        <div class="vf">
          <div class="top"><span class="pill" data-info>M 1/125 F8 ISO 100</span><span class="pill" data-verdict>適正露出</span></div>
          <canvas class="lab-hist corner-hist" width="144" height="56" data-hist aria-hidden="true"></canvas>
          <div class="meter-wrap">
            <div class="meter"><div class="scale"><span class="caret"></span></div><div class="labels">{meterLabels.map((l) => <span>{l}</span>)}</div></div>
          </div>
        </div>
      </div>
      <div class="cam dials">
        <CameraDial id="exa-ss" label="シャッター" values={SHUTTER_STOPS.map(shutterText)} value={5} />
        <CameraDial id="exa-f" label="絞り" values={APERTURE_STOPS.map(apertureText)} value={5} />
        <CameraDial id="exa-iso" label="ISO" values={ISO_LADDER.map(String)} value={0} />
      </div>
    </div>
    <div class="cam cam-row">
      <div class="seg">
        <button type="button" data-seg="hold" data-value="hand" aria-pressed="true">手持ち</button>
        <button type="button" data-seg="hold" data-value="tripod" aria-pressed="false">三脚</button>
      </div>
      <button type="button" class="cam-btn" data-toggle="zebra" aria-pressed="false">白飛び警告（ゼブラ）</button>
      <div class="seg">
        <button type="button" data-seg="bg" data-value="garden" aria-pressed="true">晴れの庭園</button>
        <button type="button" data-seg="bg" data-value="sunset" aria-pressed="false">夕焼け</button>
        <button type="button" data-seg="bg" data-value="night" aria-pressed="false">夜の街</button>
      </div>
    </div>
    <div class="cam fx">
      <p>ブレ：<b data-fx="shake"></b></p>
      <p>ボケ：<b data-fx="bokeh"></b></p>
      <p>ノイズ：<b data-fx="noise"></b></p>
    </div>
  </Proposal>

  <Proposal
    id="exposure-b"
    code="露出 B"
    title="露出の三角形を動かす"
    concept="「露出の三角形」の図そのものを操作パネルにする案。三角形の左の辺がシャッター、右の辺が絞り、底辺が ISO で、点が動きます。「明るさを保つ」を選ぶと、どれかを動かしたときに残りの1つが自動で追いかけるので、トレードオフ（交換条件）が体でわかります。"
    good={['教科書でおなじみの図と、実際の写りがつながる', '「明るさは同じでも写りが変わる」が一番伝わりやすい', '追いかける設定を選べるので、A優先・S優先の考え方の入口にもなる']}
    care={['三角形の図は抽象的なので、苦手な人もいる', '本物のカメラの見た目とは違う']}
  >
    <div class="lab-split">
      <div class="stage lab-stage" data-demo="exposure-b">
        <canvas aria-label="露出の三角形で設定した写真が写る3Dデモ"></canvas>
        <div class="vf"><div class="top"><span class="pill" data-verdict>適正露出</span></div></div>
      </div>
      <div class="cam triangle">
        <svg viewBox="0 0 300 268" aria-hidden="true">
          <path d="M150 22 L24 240 L276 240 Z" class="tri" />
          <text x="40" y="120" class="side">シャッター</text>
          <text x="214" y="120" class="side">絞り</text>
          <text x="150" y="262" class="side" text-anchor="middle">ISO</text>
          <text x="150" y="14" class="corner" text-anchor="middle">明るい</text>
          <circle r="8" data-dot="t" class="dot t" />
          <circle r="8" data-dot="N" class="dot n" />
          <circle r="8" data-dot="iso" class="dot i" />
        </svg>
        <LabSlider name="t" label="シャッタースピード" stops={SHUTTER_STOPS} value={1 / 500} format="ss" />
        <LabSlider name="N" label="絞り" stops={APERTURE_STOPS} value={4} format="f" />
        <LabSlider name="iso" label="ISO 感度" stops={ISO_LADDER} value={100} format="iso" />
        <div class="cam-row">
          <span class="cam-title">明るさを保つ</span>
          <div class="seg">
            <button type="button" data-seg="follow" data-value="iso" aria-pressed="true">ISO が追う</button>
            <button type="button" data-seg="follow" data-value="t" aria-pressed="false">SS が追う</button>
            <button type="button" data-seg="follow" data-value="none" aria-pressed="false">追わない</button>
          </div>
        </div>
        <p>ブレ：<b data-fx="shake"></b> ／ ボケ：<b data-fx="bokeh"></b> ／ ノイズ：<b data-fx="noise"></b></p>
      </div>
    </div>
  </Proposal>

  <Proposal
    id="exposure-c"
    code="露出 C"
    title="光をバケツの水にたとえる"
    concept="露出をいちばんやさしく説明する定番のたとえを、アニメーションにする案。蛇口の太さ＝絞り、水を出している時間＝シャッター、バケツの細さ＝ISO。ちょうど線まで水がたまれば適正露出です。隣の3Dの写真も同時に変わります。"
    good={['写真をまったく知らない人でも、最初の30秒でしくみがわかる', '「どれで明るさを稼いでも同じ」が目で見える', 'たとえ話なので、スマホの小さい画面でも見やすい']}
    care={['たとえなので、ボケやブレの話には別の説明が要る', '慣れた部員には物足りない（入門ページ向き）']}
  >
    <div class="lab-split">
      <div class="stage lab-stage" data-demo="exposure-c">
        <canvas aria-label="夕焼けの静物を、設定どおりの明るさで写す3Dデモ"></canvas>
        <div class="vf"><div class="top"><span class="pill" data-verdict>適正露出</span></div></div>
      </div>
      <div class="cam bucket">
        <svg viewBox="0 0 300 270" data-bucket aria-hidden="true">
          <path d="M60 30 H150 V48" class="pipe" />
          <rect data-tap x="140" y="46" width="20" height="10" rx="2" class="tap" />
          <rect data-stream x="140" y="56" width="20" height="194" class="stream" />
          <line x1="70" x2="230" y1="146" y2="146" class="line" />
          <text x="234" y="150" class="linetext">ちょうどいい</text>
          <rect data-water x="100" y="200" width="100" height="50" class="water" />
          <path data-shape d="M80 120 L86 250 L214 250 L220 120" class="pail" />
        </svg>
        <p data-bucket-label></p>
        <LabSlider name="N" label="蛇口の太さ（絞り）" stops={APERTURE_STOPS} value={4} format="f" />
        <LabSlider name="t" label="水を出す時間（シャッター）" stops={SHUTTER_STOPS} value={1 / 250} format="ss" />
        <LabSlider name="iso" label="バケツの細さ（ISO）" stops={ISO_LADDER} value={200} format="iso" />
      </div>
    </div>
  </Proposal>

  <Proposal
    id="exposure-d"
    code="露出 D"
    title="ブラケット撮影で5枚並べる"
    concept="同じ場面を、明るさを1段ずつ変えて5枚同時に撮る（ブラケット撮影）案。「何で明るさを変えるか」をシャッター・絞り・ISO から選ぶと、5枚の明るさだけでなく、風車のブレ・ボケ・ノイズも変わります。1枚をタップすると解説が出ます。"
    good={['比べるのが一目でできる。操作は「何で変えるか」を選ぶだけ', '実際のカメラのブラケット機能や、RAW 現像の話につなげやすい', 'スマホでも縦に並べれば見やすい']}
    care={['5枚同時に描くので、端末によっては重い', '1枚ごとの絵が小さいので、細かい違いは拡大が要る']}
  >
    <div class="stage lab-stage" data-demo="exposure-d">
      <canvas aria-label="明るさを1段ずつ変えた5枚の写真を並べる3Dデモ"></canvas>
      <div class="vf sheet">
        {[0, 1, 2, 3, 4].map((i) => <button type="button" class="cell" data-cell={i} aria-pressed={i === 2 ? 'true' : 'false'}><b></b><span></span></button>)}
        <div class="cell note"><p data-note></p></div>
      </div>
    </div>
    <div class="cam cam-row">
      <span class="cam-title">明るさを何で変える？</span>
      <div class="seg">
        <button type="button" data-seg="by" data-value="t" aria-pressed="true">シャッター</button>
        <button type="button" data-seg="by" data-value="N" aria-pressed="false">絞り</button>
        <button type="button" data-seg="by" data-value="iso" aria-pressed="false">ISO</button>
      </div>
    </div>
  </Proposal>

  <Proposal
    id="exposure-e"
    code="露出 E"
    title="モードダイヤル（P・A・S・M）で学ぶ"
    concept="実際のカメラのモードダイヤルを回すと、自分で決める設定とカメラが決める設定（AUTO）が切り替わる案。夜の街では、A モードで絞りを開けるとシャッターがどこまで遅くなるか、S モードで速くすると絞りが足りなくなるか、が体験できます。露出補正もできます。"
    good={['「カメラ任せ」と「自分で決める」の境目がわかるので、実機に持ち替えたときに強い', '夜景・夕焼けなど場面を変えると、カメラが何を選ぶかが見える', 'A モード中心の部の講習内容と相性がよい']}
    care={['P/A/S/M を知らない人には一言説明が要る', '自動計算の範囲外（絞りが足りない等）の表示を丁寧に作る必要がある']}
  >
    <div class="lab-split">
      <div class="stage lab-stage" data-demo="exposure-e">
        <canvas aria-label="モードダイヤルで決めた設定で、夜の街の白磁の馬を撮る3Dデモ"></canvas>
        <div class="vf">
          <div class="top"><span class="pill" data-verdict></span></div>
          <div class="meter-wrap"><div class="meter"><div class="scale"><span class="caret"></span></div><div class="labels">{meterLabels.map((l) => <span>{l}</span>)}</div></div></div>
        </div>
      </div>
      <div class="cam">
        <div class="mode-dial">
          <div class="mode-face" data-mode-face>
            {['P', 'A', 'S', 'M'].map((m, i) => <span style={`--i:${i}`}>{m}</span>)}
          </div>
          <div class="seg">
            {['P', 'A', 'S', 'M'].map((m) => <button type="button" data-seg="mode" data-value={m} aria-pressed={m === 'A' ? 'true' : 'false'}>{m}</button>)}
          </div>
        </div>
        <p data-mode-note></p>
        <div class="auto-wrap"><LabSlider name="N" label="絞り" stops={APERTURE_STOPS} value={2.8} format="f" /><span class="auto" data-auto="N" hidden>AUTO</span></div>
        <div class="auto-wrap"><LabSlider name="t" label="シャッタースピード" stops={SHUTTER_STOPS} value={1 / 60} format="ss" /><span class="auto" data-auto="t" hidden>AUTO</span></div>
        <LabSlider name="iso" label="ISO 感度" stops={ISO_LADDER} value={1600} format="iso" />
        <LabSlider name="comp" label="露出補正" stops={[-2, -1.5, -1, -0.5, 0, 0.5, 1, 1.5, 2]} value={0} format="ev" />
        <div class="seg">
          <button type="button" data-seg="bg" data-value="night" aria-pressed="true">夜の街</button>
          <button type="button" data-seg="bg" data-value="sunset" aria-pressed="false">夕焼け</button>
          <button type="button" data-seg="bg" data-value="garden" aria-pressed="false">晴れの庭園</button>
        </div>
      </div>
    </div>
  </Proposal>
</LabLayout>

<script>
  import '../../../scripts/lab/proposals/exposure';
</script>

<style>
  .cam-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px;
    gap: 14px;
    padding: 14px;
    border-radius: 22px;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.06), transparent 40%),
      linear-gradient(170deg, #262a30, #121418);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 18px 40px rgba(0, 0, 0, 0.25);
  }

  .cam-body .lab-stage {
    border-radius: 6px;
    box-shadow: 0 0 0 3px #08090b;
  }

  .dials {
    background: none;
    box-shadow: none;
    padding: 0;
    align-content: start;
  }

  .corner-hist {
    position: absolute;
    right: 14px;
    top: 48px;
    width: 144px;
    height: 56px;
  }

  .meter-wrap {
    position: absolute;
    left: 50%;
    bottom: 12px;
    width: min(300px, 70%);
    transform: translateX(-50%);
    padding: 12px 14px 8px;
    border-radius: 6px;
    background: rgba(10, 12, 14, 0.55);
  }

  .fx {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .triangle svg,
  .bucket svg {
    width: 100%;
    max-height: 260px;
  }

  .tri {
    fill: rgba(100, 190, 198, 0.08);
    stroke: var(--cam-line-strong);
    stroke-width: 2;
  }

  .side {
    font: 700 12px var(--body);
    fill: var(--cam-muted);
  }

  .corner {
    font: 500 10px var(--mono);
    fill: var(--cam-muted);
  }

  .dot {
    stroke: var(--cam-bg);
    stroke-width: 3;
    transition: cx 0.3s, cy 0.3s;
  }

  .dot.t {
    fill: #ffb347;
  }

  .dot.n {
    fill: #64bec6;
  }

  .dot.i {
    fill: #e889c5;
  }

  .pipe {
    fill: none;
    stroke: #8b939c;
    stroke-width: 10;
    stroke-linejoin: round;
  }

  .tap {
    fill: #b8c0c8;
  }

  .stream {
    fill: #7cc8f0;
    transition: opacity 0.2s;
  }

  .water {
    fill: #3f9fd8;
    opacity: 0.85;
  }

  .water.over {
    fill: #ff7a5c;
  }

  .pail {
    fill: none;
    stroke: var(--cam-ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .line {
    stroke: var(--cam-warn);
    stroke-dasharray: 5 4;
  }

  .linetext {
    font: 500 10px var(--body);
    fill: var(--cam-warn);
  }

  .sheet {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
  }

  .cell {
    position: relative;
    display: flex;
    gap: 6px;
    align-items: flex-start;
    padding: 8px;
    border: 2px solid transparent;
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    pointer-events: auto;
    cursor: pointer;
  }

  .cell[aria-pressed="true"] {
    border-color: var(--cam-accent);
  }

  .cell b,
  .cell span {
    padding: 3px 6px;
    border-radius: 3px;
    background: rgba(10, 12, 14, 0.65);
    font-weight: 500;
  }

  .cell b {
    color: var(--cam-accent);
  }

  .cell.note {
    cursor: default;
    align-items: center;
    padding: 16px;
  }

  .cell.note p {
    margin: 0;
    font: 500 13px/1.7 var(--body);
    color: var(--cam-ink);
    text-shadow: none;
  }

  .mode-dial {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .mode-face {
    position: relative;
    width: 78px;
    height: 78px;
    flex: none;
    border-radius: 50%;
    background:
      repeating-conic-gradient(#1a1d21 0deg 4deg, #3a3f46 4deg 8deg);
    box-shadow: inset 0 0 0 8px #24282d, 0 4px 10px rgba(0, 0, 0, 0.5);
    transform: rotate(calc(var(--turn, 1) * -40deg));
    transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .mode-face::after {
    content: "";
    position: absolute;
    inset: 22px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #4a5058, #16191c);
  }

  .mode-face span {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    font: 700 11px/1 var(--mono);
    color: var(--cam-ink);
    transform: rotate(calc(var(--i) * 40deg)) translateY(-31px) translateX(-50%);
    transform-origin: 0 0;
  }

  .auto-wrap {
    position: relative;
  }

  .auto {
    position: absolute;
    right: 64px;
    top: 0;
    font: 700 10px/1 var(--mono);
    padding: 3px 6px;
    border-radius: 3px;
    background: var(--cam-warn);
    color: #2a1a00;
  }

  .auto[hidden] {
    display: none;
  }

  :global(.lab-slider.is-auto output) {
    color: var(--cam-warn);
  }

  :global(.lab-slider.is-auto input) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media (max-width: 760px) {
    .cam-body {
      grid-template-columns: 1fr;
      padding: 10px;
    }

    .dials {
      grid-template-columns: repeat(3, 1fr);
    }

    .corner-hist {
      display: none;
    }

    .meter-wrap {
      width: 78%;
      padding: 8px 10px 6px;
      bottom: 8px;
    }
  }
</style>
