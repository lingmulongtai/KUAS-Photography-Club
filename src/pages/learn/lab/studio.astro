---
import LabLayout from '../../../layouts/LabLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import StudioLab from '../../../components/lab/StudioLab.astro';
---
<LabLayout title="試作：撮影スタジオ" current="studio" lead="" bare>
  <PageHero
    edge="LEARN ▸ STUDIO ▸ 試作 2"
    title={`写真を、<span style="display:inline-block">触って学ぶ。</span>`}
    lead="ひとつの撮影現場で、カメラの設定・レンズ・フィルター・フラッシュ・ライトを全部試せます。撮る場所と撮るものを選び、真上から見た図で立ち位置やライトを動かして、シャッターを切ってみてください。アドバイスが「何をどう変えればいいか」を数字で教え、下の「お題」で腕試しもできます。"
  />
  <section class="wrap studio-page" id="studio" aria-label="撮影スタジオ">
    <p class="small muted">仕組みを理解するための簡易表現です。実際の写りは機材・撮影距離・被写体の動きなどで異なります。画面の写真はプログラムで描いた学習用の表現です。</p>
    <StudioLab />
  </section>
</LabLayout>

<style>
  .studio-page {
    display: grid;
    gap: 12px;
  }
</style>
