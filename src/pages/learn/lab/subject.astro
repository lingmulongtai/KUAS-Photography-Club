---
import LabLayout from '../../../layouts/LabLayout.astro';
import Proposal from '../../../components/lab/Proposal.astro';
import GalleryStage from '../../../components/lab/GalleryStage.astro';
---
<LabLayout
  title="被写体のデザイン案"
  current="subject"
  lead="写真部ロゴの撮影する人のモデルはやめ、写真の練習に向いた被写体を5つ用意しました。石膏像は目の開いた大理石の胸像に替えています。どれもゆっくり回るので、ドラッグで好きな角度から見られます。下のボタンで焦点距離と絞りを変えると、被写体ごとの見え方の違いがわかります。"
>
  <Proposal
    id="subject-a"
    code="被写体 A"
    title="大理石の胸像（目が開いている）"
    concept="ルネサンス風の大理石の胸像です。顔のパース（広角で鼻が大きくなる）、ピントは目に合わせる、という人物撮影の基本をそのまま練習できます。表面の細かい彫りと大理石の模様があるので、ボケとの対比もきれいに出ます。"
    good={['目が開いているので「目にピント」の練習ができる', '顔の立体がはっきりしていて、焦点距離の違いが最も伝わる', '石膏デッサンの延長で、美術・写真どちらの人にもなじむ']}
    care={['人物そのものではないので、肌の質感や表情の話はできない']}
  >
    <GalleryStage subject="bust" backdrop="garden" label="ゆっくり回る大理石の胸像" switcher="bg" />
  </Proposal>

  <Proposal
    id="subject-b"
    code="被写体 B"
    title="等身大のデッサン人形"
    concept="人の代わりに、等身大の木製デッサン人形を立たせます。全身・ひざ上・バストアップの構図や、集合写真の端の人が広角で伸びる話など、人物撮影の話を「人っぽい形」で練習できます。顔を作り込まないので、不気味さが出ません。"
    good={['全身が入るので、構図（全身・ひざ上・顔）の話ができる', '人の大きさの感覚がつかめる（距離の数字が実際の撮影に近い）', '木の質感が温かく、サイトの雰囲気に合う']}
    care={['顔がないので、目にピントを合わせる練習は胸像のほうが向く']}
  >
    <GalleryStage subject="mannequin" backdrop="autumn" label="ゆっくり回る等身大のデッサン人形" switcher="bg" />
  </Proposal>

  <Proposal
    id="subject-c"
    code="被写体 C"
    title="白磁の馬"
    concept="躍動感のある白い磁器の馬の置物です。白い被写体は露出の練習（白飛び）に最適で、たてがみの細かい形はピントとボケの境目がよく見えます。夜の街の玉ボケとの相性が特によい被写体です。"
    good={['白いので、露出オーバーで白飛びする様子がはっきり出る', '形に奥行きがあるので、F1.4 だと頭だけにピントが合う', '玉ボケを背景にしたときの写真映えがいちばん良い']}
    care={['小さい被写体なので、引きの構図では目立たない']}
  >
    <GalleryStage subject="horse" backdrop="night" label="ゆっくり回る白磁の馬" switcher="bg" />
  </Proposal>

  <Proposal
    id="subject-d"
    code="被写体 D"
    title="ティーセットと果物（静物）"
    concept="テーブルの上に、奥からティーポット・カップ・シュガーポット、手前にざくろとりんごを並べた静物です。物が前後に少しずつ並んでいるので、どこにピントを置くか、どこまでぼかすかの練習に向いています。テーブルフォトやカフェ撮影の話にもつながります。"
    good={['前後の距離の違いが小さく、被写界深度の薄さが一番わかりやすい', 'カフェや料理の写真など、部員がふだん撮るものに近い', '器の模様・果物のつやなど、質感の描写も見せられる']}
    care={['広角で引くとテーブルの外が目立つので、構図に少し制限がある']}
  >
    <GalleryStage subject="stilllife" backdrop="studio" label="ゆっくり回るティーセットと果物" switcher="bg" />
  </Proposal>

  <Proposal
    id="subject-e"
    code="被写体 E"
    title="クラシックカメラ"
    concept="真ちゅうの使い込まれた質感のあるレンジファインダーカメラです。写真部らしいモチーフで、金属・革・ガラスの質感の写り方や、マクロ（近接撮影）のピントの薄さを見せられます。トップページの小物としても使えます。"
    good={['写真部らしさが一番出る。サイトのアイコン的にも使える', '小さいものに近づくとピントがとても薄くなる、マクロの話ができる', '金属の反射で、背景の光の写り込みも見せられる']}
    care={['小さいので、焦点距離の比較（顔のパース）には向かない']}
  >
    <GalleryStage subject="camera" backdrop="sunset" label="ゆっくり回るクラシックカメラ" switcher="bg" />
  </Proposal>
</LabLayout>

<script>
  import '../../../scripts/lab/proposals/gallery';
</script>
