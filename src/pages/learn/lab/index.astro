---
import LabLayout from '../../../layouts/LabLayout.astro';
import { backdropThumb } from '../../../scripts/lab/assets';
const groups = [
  {
    key: 'structure', name: '全体構成', img: backdropThumb('garden'),
    items: ['A ひとつの撮影スタジオで全部試す', 'B テーマごとにページを分ける', 'C スクロールで進むストーリー', 'D ミッションをクリアしながら学ぶ', 'E 左右で比べるラボ'],
  },
  {
    key: 'focal', name: '焦点距離', img: backdropThumb('garden'),
    items: ['A 同じ大きさで撮り比べ＋真上の図', 'B 同じ場所からズーム（枠つき）', 'C 4本のレンズを同時に', 'D スタジオを外から眺める', 'E 千本鳥居で圧縮効果を測る'],
  },
  {
    key: 'exposure', name: '露出（シャッター・絞り・ISO）', img: backdropThumb('sunset'),
    items: ['A カメラの背面そのまま', 'B 露出の三角形を動かす', 'C 光をバケツの水にたとえる', 'D ブラケット撮影で5枚並べる', 'E モードダイヤル P・A・S・M'],
  },
  {
    key: 'depth', name: '被写界深度（ボケ）', img: backdropThumb('night'),
    items: ['A 横から見たくっきり写る範囲', 'B チェス盤をタップしてピント', 'C 絞り羽根と玉ボケの形', 'D フォーカスリングとピーキング', 'E スマホと一眼のボケの違い'],
  },
  {
    key: 'subject', name: '被写体', img: backdropThumb('studio'),
    items: ['A 大理石の胸像（目が開いている）', 'B 等身大のデッサン人形', 'C 白磁の馬', 'D ティーセットと果物', 'E クラシックカメラ'],
  },
  {
    key: 'background', name: '背景', img: backdropThumb('autumn'),
    items: ['A 日本庭園', 'B 晩秋の林と夕方の逆光', 'C 夜の街（玉ボケ）', 'D 撮影スタジオ（白ホリ）', 'E 海辺の夕焼け'],
  },
];
---
<LabLayout
  title="「写真を触って学ぶ」デザイン案"
  current="index"
  lead="学ぶページを作り直すためのデザイン案です。全体の構成・焦点距離・露出・被写界深度・被写体・背景のそれぞれに5案ずつ、合計30案を、実際に触れる3Dで作りました。気に入ったものを組み合わせて選んでください。"
>
  <section class="wrap how">
    <div class="how-card">
      <h2>選び方</h2>
      <p>各案には「焦点 B」「露出 A」のような記号がついています。ページごとに好きな案を選んで、たとえば次のように返信してください。案の一部だけ（「露出 A のヒストグラムだけほしい」など）の指定も大丈夫です。</p>
      <p class="example">構成 A ＋ B、焦点 E、露出 A（ゼブラはなし）、ボケ C、被写体 A と B、背景 A</p>
    </div>
    <div class="how-card">
      <h2>今の版から変えたこと</h2>
      <ul>
        <li>撮影する人（写真部ロゴの人）のモデルはやめました。</li>
        <li>石膏像は、目の開いた大理石の胸像に替えました。</li>
        <li>背景は作り物をやめ、実際に撮影された360°写真にしました。</li>
        <li>露出も、ほかのテーマと同じ3Dの撮影現場で試せるようにしました。</li>
        <li>ボケ・ブレ・ノイズ・明るさは、設定から計算して描いています。</li>
      </ul>
    </div>
  </section>

  <section class="wrap groups">
    {groups.map((g) => (
      <a class="group" href={`/learn/lab/${g.key}/`}>
        <img src={g.img} alt="" width="640" height="320" loading="lazy" />
        <div>
          <h2>{g.name}</h2>
          <ol>{g.items.map((it) => <li>{it}</li>)}</ol>
          <span class="go">5案を見る →</span>
        </div>
      </a>
    ))}
    <a class="group studio" href="/learn/lab/studio/">
      <div>
        <p class="edge">PROTOTYPE 2</p>
        <h2>試作：撮影スタジオ</h2>
        <p>選んでもらった構成 A（ひとつのスタジオ）と、焦点 A の「真上から見た図」をもとにした試作 2 です。10か所の撮る場所、レンズとフィルター、MF、フラッシュとライト、星空のインターバル合成、お題まで1画面で試せます。</p>
        <span class="go">試作を開く →</span>
      </div>
    </a>
  </section>

  <section class="wrap pick">
    <h2>選ばれた案</h2>
    <p>
      <strong>構成 A（ページを分けない撮影スタジオ）</strong>と、<strong>焦点 A の「真上から見た図（立ち位置）」</strong>。これをもとに作り直したのが上の「試作：撮影スタジオ」です。ほかの案は比べるために残しています。
    </p>
    <p class="small muted">3D が重い端末向けの軽量化（素材の圧縮、描画解像度の自動調整）と、英語版は、案が決まってから本番で作ります。</p>
  </section>
</LabLayout>

<style>
  .how {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
    padding-block: 32px 8px;
  }

  .how-card {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 20px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--raise);
  }

  .how-card h2,
  .pick h2 {
    font-size: var(--step-2);
  }

  .how-card p,
  .how-card ul {
    margin: 0;
    font-size: 14px;
    line-height: 1.8;
  }

  .how-card ul {
    padding-left: 1.1em;
  }

  .example {
    padding: 10px 12px;
    border-radius: 6px;
    background: var(--rebate);
    color: var(--brand) !important;
    font-family: var(--mono);
    font-size: 13px !important;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    padding-block: 24px;
  }

  .group {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--raise);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .group:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .group img {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    display: block;
  }

  .group > div {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px 18px 18px;
  }

  .group h2 {
    font-size: var(--step-2);
  }

  .group ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 3px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .go {
    color: var(--accent);
    font-weight: 700;
    font-size: 14px;
  }

  .group.studio {
    grid-template-rows: 1fr;
    color: #fff;
    background:
      radial-gradient(circle at 80% 10%, rgba(100, 190, 198, 0.4), transparent 50%),
      linear-gradient(160deg, #1e2228, #0d0f12);
    border-color: transparent;
  }

  .group.studio > div {
    align-content: end;
    min-height: 260px;
  }

  .group.studio p {
    margin: 0;
    font-size: 14px;
    line-height: 1.8;
    color: #d8dde2;
  }

  .group.studio .go {
    color: var(--brand);
  }

  .pick {
    display: grid;
    gap: 10px;
    padding-block: 24px 16px;
  }

  .pick p {
    margin: 0;
    max-width: 52em;
    line-height: 1.9;
  }
</style>
