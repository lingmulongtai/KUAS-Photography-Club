---
import LearnPage from '../../layouts/LearnPage.astro';
import DemoDarkroom from '../../components/learn/DemoDarkroom.astro';
import Steps, { type Step } from '../../components/learn/Steps.astro';

const film: Step[] = [
  {
    title: 'フィルムをリールに巻いて、タンクに入れる',
    light: 'dark',
    body: '撮り終えたフィルムをパトローネから引き出し、現像リールに巻いて現像タンクに入れます。少しでも光が当たると台無しになるので、<strong>ダークバッグの中か真っ暗な部屋で、手探りで</strong>作業します。タンクのふたを閉めれば、ここから先は明るい部屋で進められます。',
    tools: 'ダークバッグ・現像タンク・リール・はさみ',
  },
  {
    title: '現像',
    light: 'room',
    body: '現像液をタンクに注ぎ、決まった間隔でタンクを逆さにしてかき混ぜます（撹拌）。フィルムに記録された目に見えない像（潜像）が、ここで黒い銀の像になります。<strong>温度と時間で仕上がりの濃さが決まる</strong>ので、タイマーと温度計はきっちり見ます。',
    tools: '現像液・温度計・タイマー',
  },
  {
    title: '停止',
    light: 'room',
    body: '使用済み現像液は種類別の指定回収容器へ移し、製品指定の停止処理を行います。廃液を混ぜず、施設と地域の処理方法を確認してください。',
    tools: '停止液または水',
  },
  {
    title: '定着',
    light: 'room',
    body: '定着液で、光が当たらなかった部分の銀を溶かし出します。これで光に当てても像が変わらなくなるので、<strong>定着が終わればタンクのふたを開けて大丈夫</strong>です。',
    tools: '定着液',
  },
  {
    title: '水洗・乾燥',
    light: 'room',
    body: '流水で薬品をよく洗い流し、水滴防止剤にくぐらせてから、クリップで吊るしてほこりの少ない場所で乾かします。',
    tools: '水滴防止剤・フィルムクリップ',
    result: '明暗が反転した「ネガ」',
  },
];

const print: Step[] = [
  {
    title: 'ネガをセットして、ピントを合わせる',
    light: 'safe',
    body: '引き伸ばし機のネガキャリアにネガを入れ、台の上（イーゼル）に映った像の大きさとピントを合わせます。ここでは対応するモノクロ印画紙を対象としています。製品指定の<strong>セーフライト</strong>と設置距離・光量・使用時間等の条件を守り、使用前にテストします。赤い照明なら何でも安全という意味ではありません。フィルムやカラー印画紙にも同じ条件が使えるわけではありません。',
    tools: '引き伸ばし機・イーゼル・ピントルーペ',
  },
  {
    title: 'テストプリントで露光時間を決める',
    light: 'safe',
    body: '印画紙の細長い切れ端に、製品と設備の条件に合わせて時間を変えながら段階的に光を当て、現像して見比べます。いちばんきれいに見える時間が本番の露光時間です。多階調印画紙なら、フィルターの号数でコントラストもここで決めます（数字が大きいほど白黒がはっきりした硬い調子）。',
    tools: '印画紙の切れ端・厚紙・多階調フィルター',
  },
  {
    title: '本番の露光',
    light: 'safe',
    body: '決めた時間で印画紙全体に光を当てます。一部だけ明るくしたいときは手や厚紙で光をさえぎる「覆い焼き」、暗くしたいときはそこだけ長く当てる「焼き込み」をします。',
    tools: '印画紙・引き伸ばし機のタイマー',
  },
  {
    title: '現像 → 停止 → 定着',
    light: 'safe',
    body: 'バットを3つ並べ、印画紙を順番に浸していきます。現像液の中では、<strong>写真の暗い部分から先に</strong>像が浮かび上がってきます。上のデモはこの瞬間を再現しています。',
    tools: 'バット3枚・トング・印画紙用の現像液・停止液・定着液',
  },
  {
    title: '水洗・乾燥',
    light: 'room',
    body: '流水でよく洗って乾かせば完成です。水洗条件は印画紙の種類や製品指定に従います。',
    result: '1枚だけの、手焼きのプリント',
  },
];

const raw: Step[] = [
  {
    title: 'RAW で撮る',
    body: 'カメラの記録形式を RAW（または RAW＋JPEG）にします。JPEG はカメラの中で色や明るさが決まってしまいますが、RAW はセンサーが受け取った情報をほぼそのまま残すので、あとから大きく調整しても画質が崩れにくくなります。スマホでも RAW で撮れる機種があります。',
  },
  {
    title: '露光量で全体の明るさを決める',
    body: '最初に全体の明るさを整えます。露光量の 1.0 は、カメラでいう「1段」分の明るさです。',
  },
  {
    title: 'ホワイトバランスで色かぶりを直す',
    body: '電球の下はオレンジっぽく、日陰は青っぽく写ります。色温度の目安は、電球が約3000K、晴れた日中が約5500K、日陰が約7000Kです。あえて少しずらして、夕方の温かさや夜の冷たさを強めることもできます。',
  },
  {
    title: 'ハイライトとシャドウを戻す',
    body: '白くとびかけた空や、黒くつぶれかけた影に、細かい部分を取り戻します。RAW がいちばん強いのがここです。',
  },
  {
    title: 'トーンカーブと HSL で仕上げる',
    body: 'トーンカーブは明るさごとのコントラスト。黒を少し持ち上げるとフィルムっぽい柔らかさになります。HSL（色相・彩度・輝度）では、紅葉の赤や空の青など特定の色だけを調整できます。',
  },
  {
    title: 'ノイズ除去とレンズ補正',
    body: '高感度で出たザラつきや、レンズによる周辺の暗さ・ゆがみを補正します。かけすぎるとのっぺりするので、拡大して確認しながら。',
  },
  {
    title: '書き出す',
    body: '用途に合わせたサイズの JPEG で書き出します。元の RAW ファイルは変わらないので、何度でも最初からやり直せます。',
    result: 'SNS や写真展に使える1枚',
  },
];
---
<LearnPage
  slug="darkroom"
  lead="「現像」には2つの意味があります。フィルムや印画紙を薬品に浸して像を出すこと。そして、デジタルカメラの RAW データを仕上げること。どちらも、撮ったあとに写真を完成させる工程です。順番どおりにステップで見ていきましょう。"
  description="暗室でのモノクロフィルム現像とプリント、デジタルの RAW 現像を、第一ステップから順番に解説します。印画紙に像が浮かぶ様子は暗室デモで体験できます。"
>
  <DemoDarkroom slot="demo" />

  <p>
    以下はモノクロフィルムと対応するモノクロ印画紙の工程の概要です。実習手順書ではありません。製品の説明書・安全データシートと施設の指示に従い、条件を確認できない場合は実習を行わないでください。
    暗室の作業は大きく2つに分かれます。まずフィルムを現像して「ネガ」をつくり、次にそのネガを印画紙に焼き付けて「プリント」をつくります。それぞれのステップで、<strong>どのくらいの明るさで作業できるか</strong>も示しています。
  </p>

  <Steps part="PART 1 ▸ FILM" title="フィルムを現像する" steps={film} />

  <Steps part="PART 2 ▸ PRINT" title="印画紙にプリントする" steps={print} />

  <h2>なぜ暗いところから先に出てくるの？</h2>
  <p>
    印画紙は、ネガを通った光をたくさん受けたところほど黒くなります。たくさん光を受けた部分は銀の粒が早く育つので、現像液に入れると<strong>写真の暗い部分から先に</strong>浮かび上がり、明るい部分は最後に色がつきます。上のデモもこの順番で像が出てくるようにしています。
  </p>

  <h2>カラーフィルムは？</h2>
  <p>
    カラーネガの現像はモノクロとは別の工程・薬品・管理条件が必要です。カメラ店や現像所に出して、現像とデータ化（スキャン）をまとめて頼むのが一般的です。
  </p>

  <Steps part="PART 3 ▸ DIGITAL" title="デジタルの「RAW 現像」" steps={raw} />

  <p>
    ソフトは、カメラメーカーの純正ソフト（無料）、darktable や RawTherapee（無料）、Adobe Lightroom（有料）などがあります。スマホなら Lightroom モバイルや Snapseed で RAW を扱えます。
  </p>

  <h2>薬品を使うときの注意</h2>
  <p>
    暗室の薬品は換気のよい場所で、手袋をして扱います。使い終わった薬品は種類別の指定回収容器へ移し、混ぜずに保管・回収の指示に従ってください。流しに捨てず、自治体や施設の処理方法を確認してください。
  </p>

  <p class="small muted">参考：<a href="https://ilford.co.jp/photo/faq_category/photographic-paper/">ILFORD：印画紙FAQ</a>、<a href="https://www.ilfordphoto.com/testing-your-safelights/">Testing your safelights</a>、<a href="https://www.ilfordphoto.com/health-and-safety/">Health and Safety</a>。地域により廃液の扱いは異なるため、施設の回収方法をご確認ください。</p>

  <div slot="aside" class="point">
    <h2>このページのポイント</h2>
    <ul>
      <li>フィルムは 現像 → 停止 → 定着 → 水洗</li>
      <li>真っ暗なのはタンクに入れるまで</li>
      <li>対応モノクロ印画紙は指定条件・テスト済みのセーフライトで扱う</li>
      <li>印画紙は暗い部分から先に像が出る</li>
      <li>RAW で撮れば、あとから大きく調整できる</li>
    </ul>
  </div>
  <div slot="aside" class="point">
    <h2>明るさの目印</h2>
    <ul class="legend">
      <li><i class="d"></i>真っ暗で作業</li>
      <li><i class="s"></i>製品指定・テスト済みのセーフライトの下で</li>
      <li><i class="r"></i>明るくしてOK</li>
    </ul>
  </div>
  <div slot="aside" class="point">
    <h2>写真部では</h2>
    <p class="small">
      このページは現像の仕組みを学ぶための解説です。写真部での実習・現像会の開催実績を示すものではありません。
    </p>
  </div>
</LearnPage>

<style>
  .legend {
    list-style: none;
    padding: 0 !important;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }

  .legend .d {
    background: #000;
  }

  .legend .s {
    background: #e2321c;
    box-shadow: 0 0 6px #ff4a2e;
  }

  .legend .r {
    background: #ffd36b;
    box-shadow: 0 0 0 1.5px #e0a23b;
  }
</style>
