---
import Base from './Base.astro';
import '../styles/lab.css';

interface Props {
  title: string;
  lead: string;
  current: string;
  /** Full-bleed page without the hero (the studio prototype). */
  bare?: boolean;
}
const { title, lead, current, bare = false } = Astro.props;
const nav = [
  { href: '/learn/lab/', key: 'index', label: '案の一覧' },
  { href: '/learn/lab/structure/', key: 'structure', label: '全体構成' },
  { href: '/learn/lab/focal/', key: 'focal', label: '焦点距離' },
  { href: '/learn/lab/exposure/', key: 'exposure', label: '露出' },
  { href: '/learn/lab/depth/', key: 'depth', label: '被写界深度' },
  { href: '/learn/lab/subject/', key: 'subject', label: '被写体' },
  { href: '/learn/lab/background/', key: 'background', label: '背景' },
  { href: '/learn/lab/studio/', key: 'studio', label: '試作：撮影スタジオ' },
];
---
<Base title={`${title} | 学ぶページのデザイン案`} description="「写真を触って学ぶ」ページの作り直しに向けたデザイン案（部内確認用・未公開）。" noindex>
  <div class="lab-bar">
    <div class="wrap lab-bar-inner">
      <p class="lab-flag">DESIGN PROPOSALS · 部内確認用（未公開）</p>
      <nav class="lab-nav" aria-label="デザイン案のページ">
        {nav.map((n) => <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </div>
  {!bare && (
    <header class="lab-hero">
      <div class="wrap">
        <p class="edge">LEARN LAB ▸ DESIGN PROPOSALS</p>
        <h1>{title}</h1>
        <p class="lead">{lead}</p>
      </div>
    </header>
  )}
  <slot />
  <footer class="wrap lab-credit small muted">
    3D モデルと背景のパノラマは <a href="https://polyhaven.com/" target="_blank" rel="noopener">Poly Haven</a> の CC0 素材です（大理石の胸像・白磁の馬・ティーセット・果物・クラシックカメラ・チェス盤、名古屋城 二の丸庭園・晩秋の林・上海外灘・撮影スタジオ・海辺の夕焼け・花の咲く農道・雪の森・石畳の路地・ネオンのスタジオ）。デッサン人形・鳥居・風車・コスモス畑・一本の木・星空はプログラムで作っています。写りは仕組みを伝えるための簡易表現です。
  </footer>
</Base>
