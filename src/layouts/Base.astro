---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { club } from '../data/club';
import { languagePath } from '../lib/i18n';

interface Props {
  /** Page name. The club name is appended automatically. */
  title?: string;
  description?: string;
  /** Let the header float over a full-bleed hero (top page). */
  overlayHeader?: boolean;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  /** Keep the page out of search engines (the admin panel). */
  noindex?: boolean;
}

const {
  title,
  description = '京都先端科学大学の写真部「KUAS Photography Club」。写真部が運営するサイトです。活動・入部のご案内と、シャッタースピード・絞り・焦点距離・現像など写真の基礎を、触って学べるページを公開しています。',
  overlayHeader = false,
  lang = 'ja',
  dir = 'ltr',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${club.name}` : `${club.name} | ${club.nameJa}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const japanesePath = languagePath(Astro.url.pathname, 'ja');
const englishPath = languagePath(Astro.url.pathname, 'en');
const hasLanguagePair = languagePath(englishPath, 'ja') === japanesePath;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {!noindex && hasLanguagePair && <><link rel="alternate" hreflang="ja" href={new URL(japanesePath, Astro.site)} /><link rel="alternate" hreflang="en" href={new URL(englishPath, Astro.site)} /></>}
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#64bec6" />
    <script is:inline>
      // Run before paint; choosing a dark OS theme does not opt the visitor in.
      try {
        const theme = localStorage.getItem('kuas-theme');
        if (theme === 'dark' || theme === 'black') {
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#101b2b' : '#000000';
        }
      } catch { /* Light remains available when storage is blocked. */ }
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
    <meta property="og:image" content={new URL('/brand/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Quicksand:wght@500;600;700&family=Yomogi&family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&display=swap"
    />
    <script>import '../scripts/language';</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : '本文へ移動'}</a>
    <SiteHeader overlay={overlayHeader} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    background: var(--accent);
    color: var(--on-accent);
    padding: 10px 14px;
    border-radius: var(--radius);
    font: 500 13px/1 var(--mono);
    text-decoration: none;
  }

  .skip:focus {
    top: 12px;
  }
</style>
