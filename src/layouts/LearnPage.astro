---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import LearnCards from '../components/learn/LearnCards.astro';
import { learnTopics } from '../data/learn';
import type { SiteLanguage } from '../lib/i18n';

interface Props {
  slug: (typeof learnTopics)[number]['slug'];
  lead: string;
  description: string;
  lang?: SiteLanguage;
}
const { slug, lead, description, lang = 'ja' } = Astro.props;
const topic = learnTopics.find((t) => t.slug === slug)!;
const en = lang === 'en';
const name = en ? topic.name : topic.title;
const t = en
  ? {
      learn: 'Learn photography',
      home: '/en/learn/',
      demo: 'Hands-on demo',
      note: 'A simplified illustration of how it works. Real results vary with equipment, distance and subject movement. Pictures in the diagrams and demos are drawn by the program for learning; they are not member photographs or activity records.',
      others: 'More topics',
    }
  : {
      learn: '写真を学ぶ',
      home: '/learn/',
      demo: '触って試せるデモ',
      note: '仕組みを理解するための簡易表現です。実際の写りは機材・撮影距離・被写体の動きなどで異なります。図解・デモ内の画像はプログラムで描いた学習用の表現で、部員が撮影した写真や活動記録ではありません。',
      others: 'ほかのテーマ',
    };
---
<Base lang={lang} title={`${name} | ${t.learn}`} description={description}>
  <PageHero edge={`LEARN ▸ ${topic.no} ▸ ${topic.en}`} title={name} lead={lead}>
    <p class="crumb small"><a href={t.home}>{t.learn}</a> / {name}</p>
  </PageHero>

  <section class="wrap demo-wrap" aria-label={t.demo}>
    <p class="small muted">{t.note}</p>
    <slot name="demo" />
  </section>

  <article class="section article">
    <div class="wrap cols">
      <div class="prose">
        <slot />
      </div>
      <aside class="aside">
        <slot name="aside" />
      </aside>
    </div>
  </article>

  <section class="section">
    <div class="wrap">
      <LearnCards exclude={slug} heading={t.others} lang={lang} />
    </div>
  </section>
</Base>

<style>
  .crumb {
    color: var(--muted);
  }

  .crumb a {
    color: var(--ink);
  }

  .demo-wrap {
    padding-bottom: 24px;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    gap: 48px 72px;
    align-items: start;
  }

  .article .prose {
    max-width: 40em;
  }

  .article :global(.prose h2:first-child) {
    margin-top: 0;
  }

  .aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 16px;
  }

  .aside :global(.point) {
    display: grid;
    gap: 8px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raise);
  }

  .aside :global(.point h2) {
    font: 700 15px/1.5 var(--body);
  }

  .aside :global(.point ul) {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
    font-size: 14px;
    line-height: 1.7;
  }

  .aside :global(.point li::marker) {
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .cols {
      grid-template-columns: 1fr;
    }

    .aside {
      position: static;
    }
  }
</style>
